# 服务端配置。**复制成 `.env` 再改** —— `.env` 在 `.gitignore` 里,不会进仓库。
#
#     cp .env.example .env
#
# `src/server/env.ts` 用 Node 内置的 `process.loadEnvFile()` 读它,所以不需要
# dotenv 之类的依赖。**它读的是"进程工作目录下的 .env"** —— 在仓库根下跑
# `npm run dev` 没问题,把构建产物搬到服务器时要在产物根目录起进程。

# ---------------------------------------------------------------- 数据库
#
# 库要先建好,这一段不会替你建。用有权限的账号跑一次:
#
#   CREATE DATABASE mouse_test CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
#   CREATE USER 'mouse_test'@'localhost' IDENTIFIED BY '你自己定一个';
#   GRANT ALL PRIVILEGES ON mouse_test.* TO 'mouse_test'@'localhost';
#   FLUSH PRIVILEGES;
#
# 表不用手工建:第一次有请求进来时会自动跑迁移(见 src/server/db.ts)。

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mouse_test
DB_PASSWORD=
DB_NAME=mouse_test

# 连接池上限。默认 10 是刻意压低 —— 本地开发时同一台机器上往往还开着别的项目,
# 别把 MySQL 默认那 151 个连接占满。
DB_POOL_LIMIT=10

# ------------------------------------------------------------ 登录会话
#
# 登录 cookie 的名字与有效期(小时)。默认 7 天。
SESSION_COOKIE=mouse_test_session
SESSION_TTL_HOURS=168

# **默认 false,这是刻意的。**
#
# 本地 `astro dev` / `astro preview` 都是 http,而带 Secure 的 cookie 在 http 下
# 浏览器根本不会存 —— 表现是"登录成功但立刻又变回未登录",服务端日志里一个字
# 都没有。所以本地保持 false;**部署到 HTTPS 之后必须改成 true**,否则会话 cookie
# 会在明文连接上发出去。
COOKIE_SECURE=false

# ------------------------------------------------------------ 初始管理员
#
# **只在 users 表为空时**用来建第一个管理员。留空就不建(只在服务端日志里说一句)
# —— 绝不会有一个默认口令。建好之后这几行可以删掉,密码走后台重置。
ADMIN_USERNAME=
ADMIN_PASSWORD=
