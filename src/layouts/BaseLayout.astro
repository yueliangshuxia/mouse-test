---
import '../styles/global.css';
import Backdrop from '../components/Backdrop.astro';
import ToolNav from '../components/ToolNav.astro';
import ViewPing from '../components/ViewPing.astro';
import { THEME_COLORS, THEME_KEY } from '../lib/theme';
import { REPAIR } from '../lib/tools';
import { href } from '../lib/url';
import {
  DEFAULT_LOCALE,
  HTML_LANG,
  LOCALE_LABEL,
  LOCALES,
  OG_LOCALE,
  altLocalePath,
  getCatalog,
  pageHref,
  isTranslated,
  parsePath,
} from '../lib/i18n';
import type { Locale } from '../lib/i18n';

interface Props {
  /** 页面 <title>,每页独立 */
  title: string;
  /** meta description,每页独立 */
  description: string;
  /** 当前页面 slug,用于导航高亮 */
  current?: string;
  /** 可选的 JSON-LD 结构化数据 */
  jsonLd?: Record<string, unknown>;
  /**
   * 本页是否需要「跨域隔离」(即 5µs 时间戳而不是 100µs)。
   *
   * 开着的页面在**首次访问时会多加载一次** —— 隔离是文档在导航时定下的属性,
   * 不重载拿不到。所以只有真的用得上的页面(回报率页)才开,别全站无差别重载。
   * 机制见 `public/coi-serviceworker.js`。
   */
  isolation?: boolean;
  /**
   * 这一页**不要**被搜索引擎收录。目前只有 404 页用。
   *
   * 它同时会**去掉 canonical**:404 是给一个不存在的地址渲染出来的,
   * `Astro.url.pathname` 那一刻就是那个坏地址 —— 声明一个指向不存在页面的
   * canonical 是错的(虽然搜索引擎在 404 上本来就忽略它,但写对是免费的)。
   */
  noindex?: boolean;
  /**
   * 这一页对应工具的色相(`src/lib/tool-hues.ts`)。给了就写到 `<main>` 上,
   * 于是**整页都能用 `var(--hue)`** —— 标题图标、卡片悬停那圈环、卡片标题
   * 都取同一件工具的颜色。
   *
   * **没给就整页没有 `--hue`**,而那些用到它的地方一律写成
   * `var(--hue, 兜底值)`,退回无色相的旧长相。所以这是个**可选**的装饰,
   * 不是必填 —— 维修页、工具箱、404 都不传它的对应色相也能照常站住。
   */
  hue?: string;
  /**
   * 字体档位。目前只有一个值 `'cyber'`,给了就写到 `<html data-font>` 上。
   *
   * **默认(不传)逐字节等于改之前** —— `--font-display` 在 `:root` 里就指向
   * `--font-sans`,`--font-mono` 也还是系统那一串。所以这是个纯可选的开关,
   * 和 `hue` / `isolation` 同一套写法:**没传的页面自动退回老长相**。
   *
   * 2026-10-14 用户要"科幻赛博朋克感"时加的,当时只让首页传 ——
   * "先在首页改一下我看看"。
   */
  font?: 'cyber';
  /**
   * 这一页是哪个语言。**默认中文** —— 所以现有的 21 个页面一个字都不用改,
   * 只有 `/en/` 那一套路由文件显式传 `locale="en"`。
   *
   * 它决定三件事:`<html lang>`、`<meta og:locale>`、以及**默认的字体档位**
   * (英文版挂赛博那套)。三件都由这一个值推出来,不会各写各的。
   */
  locale?: Locale;
}

const {
  title,
  description,
  current,
  jsonLd,
  isolation = false,
  noindex = false,
  hue,
  font,
  locale = DEFAULT_LOCALE,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

/*
 * 当前页的文案目录,以及**同一个页面在另一种语言下的两个地址**。
 *
 * 中英开关是两枚真链接,不是两个按钮 —— 理由写在 `i18n/locale.ts` 的文件头
 * (语言是地址,不是偏好)。两个地址由同一个 `altLocalePath()` 算出来,
 * 所以不会出现"回中文那条对、去英文那条错"。
 */
const t = getCatalog(locale);
const switchTo = (target: Locale) => href(altLocalePath(target, Astro.url.pathname));

/*
 * 当前这一页在**另一种语言**下有没有。
 *
 * 判据一条就够:中文是站点自己的语言,任何一页的中文版都一定在;英文版只有
 * 翻过的才有。所以"另一个语言可不可点"= `目标语言 === 默认语言 || 这一页翻过`。
 *
 * **两个方向都要对**:未翻译页上 EN 不可点(否则 404),而英文页上「中文」
 * **必须可点** —— 漏掉后半句的话英文页就回不去了,而那是我第一版真写错的地方。
 */
const currentSlug = parsePath(Astro.url.pathname).rest.replace(/\/$/, '');

/*
 * 英文版才挂赛博那套字体(用户定的:镂空模板字本来就是为拉丁字母设计的,
 * 在英文版里它才是主角;中文版维持规整的系统字体)。
 *
 * **`font` prop 仍然优先** —— 它是"这一页要不要这套字体"的显式开关,
 * 而 locale 只是默认值。两者都留着是因为以后可能想要"英文版里某一页例外"。
 */
const fontSet = font ?? (locale === 'en' ? 'cyber' : undefined);

/*
 * 社交分享图。**必须是绝对 URL** —— `href()` 出来的是 `/mouse-test/og.png`,
 * 那是站内路径,而抓取分享卡片的那些客户端不在这个站里,读到相对路径只会
 * 当作没给。所以拿 `Astro.site` 拼成绝对地址。
 *
 * 全站共用这一张(`public/og.png`,1200×630)。**每页一张当然更好**,但那就得
 * 在构建期生成二十张图,而这一版的收益几乎全在"有没有"上 —— 在此之前
 * 一个 `og:` 标签都没有,分享出去是一张空白卡。
 */
const ogImage = new URL(href('og.png'), Astro.site).href;
---

<!doctype html>
<html lang={HTML_LANG[locale]} data-font={fontSet}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical.href} />}

    <!--
      社交分享卡片。**在此之前全站一个 `og:` 都没有** —— 链接发到微信、QQ
      或者任何一个聊天工具里,弹出来的是一张只有域名的空白卡。

      对本站尤其要紧:目标就是做流量,而自然传播的每一次都是白捡的曝光,
      空卡等于把那一次浪费掉。

      `og:title` / `og:description` 直接用每页自己的 —— 各页本来就有独立的
      `title` 和 `description`(它们同时喂 `<title>` 和 meta description),
      所以这里没有第二份文案要维护。

      `twitter:card` 取 `summary_large_image`:图是 1200×630 的横图,
      用 `summary` 那张图会被裁成一个很小的方块。
    -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="在线鼠标测试" />
    <meta property="og:locale" content={OG_LOCALE[locale]} />

    {/*
      同一页面的另一种语言,给搜索引擎看。**三条一起给**:
      两条 `alternate` 加一条 `x-default`(指默认语言那一份)。
      少了 x-default 的话,搜索引擎在"该给哪个语言的用户看"上没有落点。
    */}
    {LOCALES.map((other) => (
      <link
        rel="alternate"
        hreflang={HTML_LANG[other]}
        href={new URL(href(altLocalePath(other, Astro.url.pathname)), Astro.site).href}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(href(altLocalePath(DEFAULT_LOCALE, Astro.url.pathname)), Astro.site).href}
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <meta name="theme-color" content={THEME_COLORS.light} />

    <!--
      主题必须在**首次绘制之前**定下来,否则深色的人每次加载都会先闪一帧浅色。
      所以这个脚本是内联的:Astro 默认的 <script> 会被打包成延迟执行的 module,
      等它跑起来首帧已经画完了。

      开关上只有「浅色 / 深色」两个按钮,**系统偏好只在这里、且只在从没选过时
      读一次**。这一层的取舍写在 src/lib/theme.ts 的文件头。

      常量走 define:vars 注入:内联脚本不能 import,但键名和色值也不该在
      这里再手抄一份。
    -->
    <script is:inline define:vars={{ themeKey: THEME_KEY, themeColors: THEME_COLORS }}>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem(themeKey);
        } catch {
          /*
           * 隐私模式下 localStorage 一碰就抛。**不能因此退回浅色**——
           * 系统的深色偏好和 localStorage 没关系,不该被它连累,
           * 继续往下走,让 matchMedia 去决定。
           */
        }

        /*
         * **只有存过 'light' 才是浅色,其余一律深色** —— 包括"没存过"、
         * 存坏了、`localStorage` 读抛了(隐私模式)。
         *
         * 也就是说**默认是深色,而且和系统偏好无关**(用户 2026-10-13 定的):
         * 首页那层星空只在深色下出现,跟着系统走的话系统是浅色的访客永远看不到。
         * 代价写在这里,别当 bug 修掉:**系统明明是浅色、也从没按过开关的人,
         * 进来会看到深色页面。**
         *
         * 这一处和 `ui.ts` 的 `readTheme()` 是**两个地方读同一个判据** ——
         * 首帧这一处不能 import(`is:inline`),所以那句表达式在那边又写了一遍。
         * **改这里必须同时改 `readTheme`**(反过来说,`theme.ts` 的文件头记着
         * 这条双写,以及 `systemTheme()` 为什么被删了)。
         */
        var dark = stored !== 'light';

        document.documentElement.dataset.theme = dark ? 'dark' : 'light';

        // 手机状态栏的颜色也得跟着走,否则和页面底色对不上
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) {
          meta.setAttribute('content', dark ? themeColors.dark : themeColors.light);
        }
      })();
    </script>

    {
      jsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(jsonLd)}
        />
      )
    }
  </head>
  <body>
    {/*
      氛围层:星空底 + 流星拖尾。**全站每一页都有,挂在壳上而不是各页各挂一份。**

      它原本只挂在首页和维修页(用户先在那两页要的)。后来要求"工具页也加上"
      —— 那就该挪到这里:一是六个 `<i>` 加一块画布的标记不必在十九个页面里
      各写一遍,二是**"哪些页有"从此不需要维护**,新加一页自动就有。

      `#meteor` 那个 id 和 `getElementById` 都依赖**每页只渲染一次**,所以
      首页和维修页里原先那两处 `<Backdrop />` 已经撤掉了 —— 留着一个就会
      变成两块画布,而 `getElementById` 只会拿到第一块。

      **放在 `<body>` 最前面**,不为了"渲染更快",是为了**绘制顺序**:星空是
      `z-index: -1`、拖尾画布是 `z-index: 3`,两者都是 `position: fixed`。
      排在前面才能保证星空垫在正文下面、拖尾浮在正文上面。回报率页那块
      铺满视口的轨迹画布也是 `z-index: -1`,它排在这之后 —— 同层按 DOM 顺序
      画,于是轨迹压在星空上,而轨迹画布本身是透明的,星星照样透得出来。
    */}
    <Backdrop />

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={href()}>{t.common.brand}</a>
        <ToolNav current={current} locale={locale} />

        {/*
          报头最右一列。**两个控件住同一个网格列里**,没有开第四列 ——
          报头是 `auto minmax(0,1fr) auto` 三列,再开一列就等于直接去抢
          中间导航那 41.2px 的余量(见 `tools.ts` 末尾那段账)。

          ## 中英开关是两枚 `<a>`,不是两个 `<button>`
          语言是"你在哪个地址",不是"你选了什么偏好" —— 做成链接就同时拿到了
          可分享、可收录、能新标签页打开三件事,而且不需要 localStorage:URL
          自己就是持久化。对照 `theme-switch`:那一个是真的偏好,所以它是按钮。

          `aria-current='true'` 标当前语言(不是 `page` —— 它指的不是"这一页",
          是"当前这一项")。
        */}
        <div class="header-controls">
          <nav class="lang-switch" aria-label={t.common.langGroupAria}>
            {
              LOCALES.map((option) => {
                // 当前语言永远可点(它就是这个地址本身);另一种语言看它有没有这一页
                const available = option === locale || option === DEFAULT_LOCALE || isTranslated(currentSlug);
                if (available) {
                  return (
                    <a
                      href={switchTo(option)}
                      aria-current={option === locale ? 'true' : undefined}
                      hreflang={HTML_LANG[option]}
                    >
                      {LOCALE_LABEL[option]}
                    </a>
                  );
                }
                /*
                 * **另一种语言还没有这一页时,渲染成不可点的 `<span>`,不是链接。**
                 *
                 * 这不是保守 —— 是踩过的:开关原先无条件把另一种语言算成
                 * `/en/<当前页>/`,而多数页面没有英文版,**用户点 EN 落到 404 页**
                 * (用户拿截图报的「没有英文啊」)。
                 *
                 * 为什么不干脆把这个词去掉:留着它**说出了"这一页还没翻"**,
                 * 而凭空少一个按钮只会让人以为开关坏了。灰着 + `title` 是这件事
                 * 唯一说得清楚的表达。
                 */
                return (
                  <span class="lang-switch__off" title={t.common.langMissing} aria-disabled="true">
                    {LOCALE_LABEL[option]}
                  </span>
                );
              })
            }
          </nav>
          <!-- 按钮由 ui.ts 的 mountThemeToggle 建出来(一枚图标,文案取目录) -->
          <div class="theme-switch" id="theme-switch" role="group" aria-label={t.common.themeGroupAria}></div>
        </div>
      </div>
    </header>

    <main class="wrap" style={hue ? `--hue: ${hue}` : undefined}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>{t.chrome.footerPrivacy}</p>
        <p>{t.chrome.footerRecommend}</p>
        <!--
          维修入口。**放页脚,而且全站每一页都出现** —— 这条是有意的,不是随手加的。

          它必须与"测出了什么"无关:一个只在故障判定旁边出现的维修链接,会让人把
          故障结论读成带货。页脚是常设位置,读者在哪一页看到它、看到的都是同一句话。

          暴露立场的那半句(**出自同一人**)和链接写在同一行里,而且是链接的同位语 ——
          不藏在别处。这一页的入口可以低调,但"这个站和这项服务是同一个人的"这件事
          不能低调。整段理由见 `mouse-repair.astro` 的文件头。
        -->
        <p>
          <a href={pageHref(locale, REPAIR.slug)}>{t.tools['mouse-repair'].navLabel}</a> {t.chrome.footerRepair}
        </p>
        <!--
          后台入口。**它挂在壳里,所以 40 个预渲染页面每一页都有这一行。**

          ## 为什么这里写的是 `pageHref(locale, 'login')`,而不是 `auth.ts` 里的
          ## `loginUrl()`

          这一条是硬的。`loginUrl()` 住在 `src/server/auth.ts`,而那个模块 import 了
          `db.ts` / `mysql2` —— **一旦被这个布局文件引用,构建期就会去连数据库**
          (预渲染页在构建时执行 frontmatter)。那会让 `npm run build` 在没有数据库
          的机器上直接崩,而 CI 里正好没有数据库。

          `pageHref` 是纯函数(拼 base + 语言前缀),不碰任何服务端模块,所以安全。
          `/login` 没有英文版,于是 `pageHref('en', 'login')` 会**落回中文地址** ——
          这正是判据的正当行为,和维修页那条链接同一种处境。

          ## 位置

          页脚,不通报头:报头是三段按量出来的宽度排的,加第四段会让折叠边界整个漂。
          页脚是常设位置,和"测出了什么"无关 —— 这一点和维修链接是同一条理由。
        -->
        <p>
          <a href={pageHref(locale, 'login')}>{t.chrome.footerLogin}</a>
        </p>
      </div>
    </footer>

    <!--
      底部悬浮条 —— **鼠标维修的入口**。现在开着(去掉了 `hidden`;
      页脚底部的留白是靠 `html:has(.site-dock:not([hidden]))` 跟它绑在一起的,
      所以开关只有这一个属性)。

      ## 它为什么必须与"测出了什么"无关

      这是全站唯一有商业利益的东西,而它挂在**每一页**上。**它常驻,但它对
      测量结果一律没有反应** —— 不做"测出故障就弹出来 / 变色 / 跳动"。
      一个常驻入口像店门口挂的招牌:它在,但它没在看你。一个被结果触发的入口
      是"它在盯着我的测试",而那会让人把「疑似连击」读成带货 —— 全站的
      信誉正建立在这类判断不被怀疑上。整段理由见 `mouse-repair.astro` 的文件头。

      ## 为什么一行 JS 都不写

      照搬报头「工具箱」那一套:`:hover` / `:focus-within` 展开,触发器是 `<a>`。
      好处一模一样 —— **没有"开着没有"这个 JS 状态,也就没有会漂的
      `aria-expanded`**,所以这里**不写 `aria-haspopup`、也不写 `aria-expanded`**,
      不是漏了,是从没声称过。触屏没有悬停:**点一下直接去维修页**,那里是
      完整说明和见得到的二维码,这正是 `<a>` 该有的行为。

      ## 结构上的一条硬约束

      面板**排在触发器前面,而且不进绝对定位**。`.site-dock` 是
      `position: fixed; bottom: 18px`,内容长出来自然向上顶,所以面板天然
      在药丸上方。**用绝对定位会留出一条缝** —— 鼠标从药丸移到面板要跨过它,
      而那条缝不属于任何一个盒子,`:hover` 当场失效、面板被收掉(经典的
      hover 缝隙)。放进流里就没有这个问题。
    -->
    <div class="site-dock">
      <div class="site-dock__panel well">
        <p class="site-dock__title">{t.chrome.dockTitle}</p>

        <div class="site-dock__codes">
          {/*
            微信那一格还是占位 —— 二维码图片还没拿到。**占位方格里写着字,
            不是一块空白**:空白方块会被读成"图没加载出来",和 `.rate-chart:empty`
            那条 110px 灰槽是同一种罪。真码到位时把 `<span>` 里的字换成
            `<img>`,外面的 `.site-dock__code-box` 一个字不用动。
          */}
          <div class="qr">
            <span class="qr__box">{t.chrome.dockQrPlaceholder}</span>
            <span class="qr__label">{t.chrome.dockWechat}</span>
          </div>

          {/*
            淘宝那一格是**图片 + 链接两样都给**:码给桌面前的人用手机扫,
            链接给直接点的人用(手机点开会唤起淘宝 App)。外面裹 `<a>` 而不是
            挂 click 处理器 —— 后者会丢掉中键和「在新标签页中打开」,
            和首页那枚可信度徽章同一条理由。
          */}
          <a
            class="qr"
            href={REPAIR.shop}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="qr__box">
              <img src={href('taobao-qr.png')} alt="淘宝店铺二维码" width="181" height="181" />
            </span>
            <span class="qr__label">淘宝店铺</span>
          </a>
        </div>

        {/*
          这一行先前是披露(**本站的测试工具与这项维修服务出自同一人**),
          用户换成了一句招呼。**披露本身没有丢** —— 它还在两处:
          每一页的页脚,以及 `/mouse-repair/` 正文最前面那条 `.notice`。
          把细字号的声明从广告面板里挪走是对的:那里没人读它,
          而挂在那儿的唯一效果是把一句招呼挤掉。
        */}
        <p class="site-dock__note">{t.chrome.dockNote}</p>
      </div>

      {/*
        触发器 = **一枚裸图标**:没有边框、没有文字、没有底板(用户定的)。

        三条要点:

        - **`alt` 现在必须写全**。加文字那版它刻意留空(旁边那行字已经把话说完了,
          再写读屏会念两遍);现在图标是链接里**唯一**的可读内容,留空的话这个链接
          在读屏里就是"链接",没有名字 —— 视觉上可以只有一个图标,听觉上不能。
        - **那一圈边框连同底板一起去掉了**,所以 `.well` 从整条 dock 挪到了
          **面板**上(`.site-dock__panel well`):展开时那张卡片仍然需要一块深色
          衬托(上面有二维码和一行说明),而收起时脚下不该有任何东西。
        - 图标自己的底是**抠过的**(源图是近白棋盘,JPEG/PNG 都没有 alpha 通道,
          `public/repair-icon.png` 是抠完再缩出来的真 RGBA)。不抠的话它在深色
          页面上会是一块白方块。
      */}
      <a class="site-dock__trigger" href={href(`${REPAIR.slug}/`)}>
        <img
          class="site-dock__trigger-icon"
          src={href('repair-icon.png')}
          alt={t.tools['mouse-repair'].navLabel}
          width="220"
          height="251"
        />
      </a>
    </div>

    <!--
      浏览计数。**一行覆盖全部 17 个工具页** —— 它自己会判断"这一页算不算数"
      (判据是 `lib/page-views.ts` 那份从注册表推出来的白名单),所以后台、登录页、
      首页、工具箱页天然不计数,这里不需要写任何 `if`。

      放在壳里的理由和 `<Backdrop />` 是同一条:挂在 17 个页面里各写一遍的话,
      加一件工具就会忘了加一行,而漏掉的表现是**那一页从此不计数** —— 看板上少
      一根柱子,没有任何东西会提醒。
    -->
    <ViewPing slug={currentSlug} />

    <script>
      import { el, mountThemeToggle } from '../lib/ui';
      import { mountNavOverflow } from '../lib/nav-overflow';

      mountThemeToggle(el('theme-switch'));

      /*
       * 报头导航的溢出折叠。**每个页面都要挂** —— 它在报头里,而报头是
       * BaseLayout 的一部分。见 `nav-overflow.ts`。
       */
      const nav = document.querySelector('[data-nav]');
      if (nav) mountNavOverflow(nav);
    </script>

    <!--
      跨域隔离。GitHub Pages 发不了 COOP/COEP,所以由 service worker 在本站自己
      的响应到达页面之前补上这两个头 —— 详尽的代价与边界写在
      public/coi-serviceworker.js 的文件头,改这条之前先读它。

      这里做两件事,**分开**:注册在每一页都做(这样从首页走到回报率页时已经
      被 worker 接管了,不需要重载);重载只在本页声明了 isolation 时做。
    -->
    <script is:inline define:vars={{ swUrl: href('coi-serviceworker.js'), needsIsolation: isolation }}>
      (function () {
        // 已经隔离就什么都不用做(本地 dev 由 astro.config 的 server.headers 提供)。
        // 不认这个属性的浏览器上它是 undefined,`!== false` 同样提前返回。
        if (window.crossOriginIsolated !== false) return;
        if (!window.isSecureContext || !navigator.serviceWorker) return;

        navigator.serviceWorker
          .register(swUrl)
          .then(function () {
            return navigator.serviceWorker.ready;
          })
          .then(function () {
            if (!needsIsolation || window.crossOriginIsolated) return;
            /*
             * 「只重载一次」的保险。没有它,万一隔离因为任何原因没生效
             * (响应头被中间层剥掉、浏览器拒绝认),页面就会无限重载。
             * sessionStorage 写不进去时宁可**不重载**:一次没隔离可以接受,
             * 死循环不行。
             */
            try {
              if (sessionStorage.getItem('coi-reloaded')) return;
              sessionStorage.setItem('coi-reloaded', '1');
            } catch (err) {
              return;
            }
            window.location.reload();
          })
          .catch(function () {
            /* 注册不上就照旧用 100µs 的时间戳,页面顶部会如实告警 */
          });
      })();
    </script>
  </body>
</html>
