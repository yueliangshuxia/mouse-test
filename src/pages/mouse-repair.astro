---
import BaseLayout from '../layouts/BaseLayout.astro';
import { REPAIR_HERO_SVG, REPAIR_MOTIF } from '../lib/repair-motifs';
import { REPAIR } from '../lib/tools';
import { MOUSE_TOOLS } from '../lib/tools';
import { TOOL_MOTIF } from '../lib/tool-motifs';
import { faqHtml, faqText } from '../lib/faq';
import { href } from '../lib/url';

/*
 * 自测工具索引卡上每个工具的那个色相。
 *
 * **这一节原本长在首页上,用户让挪到维修页来。** 这是全站唯一一处给**纸面**
 * 加色相的地方,所以理由要跟着一起搬过来,不能只剩一张表:
 *
 * 全站的规矩是「纸面走无彩色,有颜色的地方就是在出数」—— 它让"哪里是活的"
 * 一眼可见,**蓝色强调色当年就是因此被删掉的**。这九个色相破了这条规矩,
 * 代价是真实的。
 *
 * 换来的是:一排九张卡,眼睛能靠颜色把「按键」「滚轮」「回报率」分开,
 * 而不是逐个读字。这是**识别**,不是数据。几条约束把伤害压到最小:
 *
 * - **色相只出现在图标那一格,和悬停时**;正文、边框、数字一概不染
 * - **九个色相彼此拉开**,不让相邻两张看着像同一张
 * - **仪器窗的磷光绿、警告赭黄、故障朱砂仍然是那三个语义位**,没有被顶掉
 *
 * 换句话说:**读数仍然只有那三种颜色**,多出来的是"目录"这一层。
 *
 * **另一件要留意的事**:这一页其余那些卡(`能修什么` / `不修什么`)是**灰的**,
 * 只有这一节有色。所以这一节天然读成"另一类东西"—— 那正好:它是工具目录,
 * 不是维修条目。
 */
const TOOL_HUE: Record<string, string> = {
  'button-test': '#3b82f6',
  'hold-drag-test': '#8b5cf6',
  'double-click-test': '#f59e0b',
  'scroll-test': '#ef4444',
  'cps-test': '#06b6d4',
  'trail-test': '#10b981',
  'polling-rate-test': '#84cc16',
  'dpi-test': '#ec4899',
  'acceleration-test': '#f97316',
};

/*
 * 鼠标维修 —— **第二个不是"一件测量工具"的页面**(第一个是 `/toolbox/`)。
 *
 * 和工具箱一样,它不进 `tools.ts` 的注册表:注册表是**工具**的地方,而这一页
 * 一个数都不出。所以它拿不到 `ready` 那道"不许链接到不存在的页面"的保护,
 * 由 `tests/nav.test.ts` 的 `existsSync` 补回来 —— 和工具箱同一条。
 *
 * ## 这一页最要紧的一条设计约束
 *
 * **故障判定区永远不出现服务信息。** 测出"疑似连击"的地方只许有结论和
 * "怎么办",不许有"找我修"。理由不是洁癖:用户看到"检测到故障"旁边就是
 * 维修入口,第一反应是"它是不是想卖我东西" —— 而全站的信誉就建立在这类
 * 判断不被怀疑上。服务信息一律放在**与测出什么无关**的位置。
 *
 * 同一件事的另一半是**披露**:本站作者就是维修方,这句话写在正文最前面,
 * 不藏进页脚。藏起来的代价远大于一开始就说 —— 而且它和全站"测不准就明说"
 * 是**同一条纪律**,只不过这次要明说的是立场,不是误差。
 */

const FAQ = [
  {
    q: '测出来双击了,就一定是微动坏了吗?',
    a:
      '不一定,先别急着修。软件层能造出一模一样的现象:驱动里的按键设置、系统的指针加速、' +
      '无线鼠标的电量或 2.4G 干扰、USB 口供电不足、甚至一个脏了的鼠标垫。' +
      '**先按顺序排除掉这些**:换个 USB 口、换台机器、关掉驱动里的按键宏,再测一次。' +
      '站上的加速度页和回报率页能帮你排掉其中一部分。排完还在,才轮到硬件。',
  },
  {
    q: '为什么不直接标价格?',
    a:
      '因为一只鼠标修多少钱,取决于型号、坏在哪、要换什么件,标一个"起"价只会误导 ——' +
      '**所有寄修都是收到后免费检测、免费报价,你同意了我们才动手**。不同意就原样寄回,' +
      '只收你自己那一段的运费。这样一来价格这件事在你签字之前都不成立。',
  },
  {
    q: '修完又坏了怎么办?',
    a:
      '换上去的微动和编码器有质保期,期内同一处再出问题免费返修。但要说清楚质保**不覆盖什么**:' +
      '进液、摔过、自己拆过、以及在别处动过手脚的,都不在范围内 —— 这类情况我们会在报价时' +
      '直接告诉你,不会先收了钱再说。',
  },
  {
    q: '哪些鼠标你会劝我别修?',
    a:
      '三种。**还在保修期内的** —— 直接找厂商,免费换新,这钱不该花;' +
      '**进水很久、主板已经明显腐蚀的** —— 修完也撑不久,不如把预算留给下一只;' +
      '**价格太低的** —— 一只几十块的鼠标,换微动的工时费已经接近它本身。' +
      '这三种我们都会直说,而不是先接下来。',
  },
  {
    q: '修前修后的读数是怎么来的?',
    a:
      '用这个站自己的工具测的 —— 就是上面那排诊断工具里的双击页和按键页。' +
      '**它不构成任何"证明"**:一次测试只反映那一次的状态,而微动故障本来就是偶发的。' +
      '它有用在**同一个工具、同一套口径、同一台机器上的前后对比**,那是它能说的;' +
      '跨机器比大小,它说不了,我们也不会拿它说。',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      name: '鼠标维修',
      description:
        '鼠标按键失灵与双击、滚轮回滚与异响、侧键故障、不充电等问题的维修:微动与编码器更换、免费清洁、寄修前免费报价、同意再动手。',
      url: new URL(Astro.url.pathname, Astro.site).href,
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQ.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: faqText(item.a) },
      })),
    },
  ],
};

/**
 * 能修的。每条一句"什么现象 → 换什么",不写形容词。
 *
 * 第三位是图形名(`REPAIR_MOTIF` 的键)。**用短英文名而不是中文类名当键**:
 * 中文名改一个字(「摔过、进过水」这种)就会让图形静默消失。
 */
const REPAIRABLE = [
  ['按键', '失灵、按下去没反应、单击变双击、轻轻一碰就误触、手感发涩 —— 换微动', 'button'],
  ['滚轮', '失灵、回滚、跳格、没有阻尼、异响 —— 换编码器,或清理与更换阻尼件', 'wheel'],
  ['侧键', '失灵、卡住、连击', 'side'],
  ['线材与接口', '接触不良、断线、接口松动 —— 换线', 'cable'],
  ['供电', '不充电、续航骤降、放一晚就没电 —— 换电池或修充电口', 'power'],
  ['摔过、进过水', '之后的一系列问题 —— 能不能修要看腐蚀到什么程度,会先拆开告诉你', 'water'],
];

/** 不修的。这一栏比上面那栏重要:它可验证,而且它是真话。 */
const NOT_REPAIRABLE = [
  ['还在保修期内的', '先找厂商,免费换新。这钱不该花,我会直接让你别寄', 'warranty'],
  ['进水很久、主板明显腐蚀的', '修完也撑不久,不值得花这个钱', 'corroded'],
  ['结构件断裂又没有配件的', '没有件就修不了,不是我挑活', 'broken'],
  ['价格太低的', '换微动的工时费已经接近它本身,不如换个新的', 'cheap'],
];

const STEPS = [
  '先联系,说清型号和症状。型号在鼠标底部,症状可以直接引用站里测试页的读数(比如"左键疑似连击 3 处")。',
  '寄来。建议保价,这一段运费你自己承担。',
  '收到后免费检测、免费报价。拆开看过了,报的才是实数。',
  '你同意再动手。不同意就原样寄回,不收检测费。',
  '修完复测,把修前修后的读数一起发给你 —— 换了什么、测出来变成什么样,你自己看。',
  '回寄。返程运费我们出。',
];
---

<BaseLayout
  title="鼠标维修 - 按键双击、滚轮回滚、侧键失灵"
  description="鼠标按键失灵与双击、滚轮回滚与异响、侧键故障、不充电等问题的维修:微动与编码器更换、免费清洁、寄修前免费报价、同意再动手。本站的测试工具与维修出自同一人,这一点页面上明说。"
  jsonLd={jsonLd}
>
  <h1>鼠标维修</h1>

  <p class="prose">
    上面那排工具负责<strong>测</strong>,这一页负责<strong>修</strong>。两边是同一件事的两头:
    工具告诉你鼠标哪儿不对,这一页说那个不对能不能处理、怎么处理。
  </p>

  {/*
    披露放在最前面,不藏进页脚。

    它不是免责声明,是**这条主线上的一次同构**:全站的规矩是"测不准就明说",
    这里要明说的是**立场**而不是误差 —— 同一个站既出诊断又出维修,读者有权
    先知道这件事,再决定信几分。

    用 `.notice--info`(灰)而不是默认那条赭黄的警告色:这不是"出事了",
    是一件需要你知道的常态事实。赭黄是全站的警告位,借过来会把话说重。
  */}
  <div class="notice notice--info">
    <strong>先说清楚:这一页是本站作者自己的维修服务。</strong>
    工具和维修出自同一个人,所以我们给出的故障判定可能影响你对这项服务的判断 ——
    这一点你得知道。要交叉验证也很简单:拿不准的时候换一台机器再测一次,结论应当一致。
  </div>

  <figure class="repair-hero">
    <Fragment set:html={REPAIR_HERO_SVG} />
    <figcaption>
      会坏的就这么几处:按键下的微动、滚轮连着的编码器、侧键。图上画的就是你刚才在上面测的那只鼠标。
    </figcaption>
  </figure>

  <h2>能修什么</h2>

  {/*
    网格卡片。**这不是新造的语言** —— `.mini-card` 早就是"填充底 + 1px 边 +
    大圆角",首页七张卡用的就是它。这里只是把同一套长相搬到纸面上,
    所以一个令牌都没新增。
  */}
  <div class="card-grid">
    {
      REPAIRABLE.map(([name, desc, motif]) => (
        <div class="card">
          <span class="card__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={REPAIR_MOTIF[motif]}
            />
          </span>
          <h3 class="card__title">{name}</h3>
          <p class="card__desc">{desc}</p>
        </div>
      ))
    }
  </div>

  <h2>不修什么</h2>

  {/*
    这一栏不是客套。它是这一页**唯一可验证**的部分:说清"什么不修",
    比"什么都能修"值钱,因为前者能对得上,后者只能听。
    四条里有三条是**劝你别花钱**,而这正是维修方最难开口的话。
  */}
  <p class="prose">
    这一栏比上一栏重要 —— 「什么都能修」只是一句话,而下面这几条你可以拿去核对。
  </p>

  <div class="card-grid card-grid--tight">
    {
      NOT_REPAIRABLE.map(([name, desc, motif]) => (
        <div class="card card--strong">
          <span class="card__icon" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={REPAIR_MOTIF[motif]}
            />
          </span>
          <h3 class="card__title">{name}</h3>
          <p class="card__desc">{desc}</p>
        </div>
      ))
    }
  </div>

  <h2>修前和修后</h2>

  <p class="prose">
    条件允许的每一只,都会在动手前后各测一遍 —— 用站上自己的工具,同一套口径。
    下面是格式示例,实际案例会逐条换成真实记录。
  </p>

  {/*
    「去某一页」的胶囊。**它做的是这一页做不到的事**:这里是维修方说的话,
    而读数得由用户自己在工具页上测出来。把这一步做成一枚可点的东西,
    而不是一句"请移步双击测试页" —— 参考站最实在的一招就是这个。
  */}
  <p class="repair-cta">
    <span class="repair-cta__label">先自己测一遍:</span>
    <a class="pill-link" href={href('double-click-test/')}>双击测试</a>
    <a class="pill-link" href={href('button-test/')}>按键测试</a>
  </p>

  <div class="case">
    <p class="case__head">
      罗技 G Pro X Superlight · 左键双击
      <span class="case__tag">示例</span>
    </p>

    <div class="case__pair">
      <div class="case__side">
        <p class="case__when">修前</p>
        <dl class="case__rows">
          <div class="case__row">
            <dt>左键</dt><dd class="case__bad">疑似连击 3 处</dd>
          </div>
          <div class="case__row">
            <dt>滚轮</dt><dd>未发现</dd>
          </div>
          <div class="case__row">
            <dt>合计</dt><dd class="case__bad">3 处</dd>
          </div>
        </dl>
      </div>

      <div class="case__side">
        <p class="case__when">修后</p>
        <dl class="case__rows">
          <div class="case__row">
            <dt>左键</dt><dd>未发现</dd>
          </div>
          <div class="case__row">
            <dt>滚轮</dt><dd>未发现</dd>
          </div>
          <div class="case__row">
            <dt>合计</dt><dd>未发现</dd>
          </div>
        </dl>
      </div>
    </div>

    <p class="case__note">
      换了左键微动。这只鼠标的其余部分是好的,所以只动了这一处 —— 能只换一件就不换两件。
    </p>
  </div>

  <h2>流程</h2>

  <ol class="steps">
    {STEPS.map((step) => <li>{step}</li>)}
  </ol>

  <h2>常见问题</h2>

  <dl class="faq">
    {
      FAQ.map((item) => (
        <>
          <dt>{item.q}</dt>
          <dd set:html={faqHtml(item.a)} />
        </>
      ))
    }
  </dl>

  <h2>先自己测一遍</h2>

  {/*
    这一节**原本长在首页上**,用户让挪到这里。

    **放在页尾而不是页首,是刻意的。** 这一页的主语是维修:能修什么、不修什么、
    修前修后、流程 —— 那几节才是读者来这儿要看的东西。九张工具卡摆在顶上会
    把正文压下去,而它们是**辅助**(先自测,再决定要不要寄),不是主角。
    放在"联系"前面,正好接上那句"先聊清楚症状"。

    名单从 `MOUSE_TOOLS` 来,和报头那个框共用同一份 —— 手写九个 `<li>` 的话,
    加一件工具会从这里静默消失。

    图标走 `TOOL_MOTIF`,**和工具箱页、和首页原本用的是同一份图形**:
    母题本身不写任何颜色(`currentColor`),色相由外面那格 `--hue` 给。

    `aria-hidden` 是必须的:那段 SVG 对读屏一个字的信息都没有,而它里面全是
    `<path>`,不藏起来只会让读屏念出一串没人听得懂的东西。
  */}
  <p class="prose">
    不确定要不要修?这几个工具都在你的浏览器里跑,不用装任何东西 ——
    先测一遍,拿着读数来聊,比「感觉有点飘」具体得多。
  </p>

  <ul class="tool-index">
    {
      MOUSE_TOOLS.map((tool) => (
        <li>
          <a class="tool-card" href={href(`${tool.slug}/`)} style={`--hue: ${TOOL_HUE[tool.slug]}`}>
            <span class="tool-card__icon" aria-hidden="true">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                set:html={TOOL_MOTIF[tool.slug]}
              />
            </span>
            <span class="tool-card__name">{tool.navLabel}测试</span>
            <span class="tool-card__desc">{tool.description}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <h2>联系</h2>

  <p class="prose">
    加微信,或者直接进淘宝店铺。<strong>两种都建议先聊清楚型号和症状再决定寄不寄</strong> ——
    没看到实物之前报的都是估价,拆开才是实数。
  </p>

  {/*
    两格二维码。**样式是共用的 `.qr*`(`global.css`)**,和底部悬浮条里那两格
    是同一份 —— 那块浅底是硬写颜色值的,两处各写一份迟早一处改了另一处旧着,
    而"二维码扫不出来"在页面上看不出来。

    尺寸由这一节自己给(`--qr-size: 168px`):**维修页上的码要比悬浮窗里的大**,
    这一格是专门给人拿手机过来扫的,而悬浮窗那格只是让人先认出来是什么。

    微信那格还是占位 —— 图片没拿到。占位方格里写着字,不是一块空白:
    空白方块会被读成"图没加载出来"。
  */}
  <div class="contact">
    <div class="qr">
      <span class="qr__box">二维码位</span>
      <span class="qr__label">微信</span>
    </div>

    <a class="qr" href={REPAIR.shop} target="_blank" rel="noopener noreferrer">
      <span class="qr__box">
        <img src={href('taobao-qr.png')} alt="淘宝店铺二维码" width="181" height="181" />
      </span>
      <span class="qr__label">淘宝店铺</span>
    </a>
  </div>
</BaseLayout>

<style>
  /*
   * 主图。
   *
   * **没有任何颜色**,只有两档线宽:外壳是细线,可维修的那五块描得重一点、
   * 加一层浅底。纸面走无彩色是全站色彩纪律的支点 —— 有颜色的地方就是在出数,
   * 而这一页一个数都不出,所以它必须彻底无色。
   *
   * 高度写死在页面里,不放进共用的 `.repair-figure`:那张图和测试页的
   * `MOUSE_FIGURE_SVG` 同源,以后可能还有第三个消费者要别的尺寸 ——
   * 和 `mouse-figure.ts` 文件头那条"高度不在共用规则里"是同一个理由。
   */
  /*
   * 主图那一块。**给它一块填充底,让它成一块"面板"而不是浮在纸上的一个图形** ——
   * 和 `.card` 同一套长相(填充底 + 1px 边 + 大圆角),所以整页是同一个语言。
   */
  .repair-hero {
    margin: 26px 0 34px;
    padding: 26px 30px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    /* 窄了自动叠成一列 —— 和全站其它地方一样,不写断点 */
    flex-wrap: wrap;
    gap: 12px 34px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  /*
   * 用 `:global(...)`,理由和瞄准页的 `.aim-target` 一样:这段 SVG 走的是
   * `<Fragment set:html>`,节点不在模板里长出来,拿不到 `data-astro-cid-*` ——
   * 普通的页面规则一条都不会命中,而且是**静默的**(元素还在、位置还对,
   * 只是没有长相)。只有这一页用它,所以选页面内的 `:global` 而不是
   * 搬去 `global.css`。
   */
  :global(.repair-figure) {
    width: auto;
    height: 360px;
    /*
     * **一条线走到底,分区靠填充区分 —— 外壳和可维修区取同一个前景色。**
     *
     * 第一版外壳用的是 `--border-strong`(想做出"外壳淡、重点区深"的层次),
     * 截图发现**深色下整只鼠标的下半身几乎看不见**:那只鼠标只有下半身是纯
     * 外壳,而 `--border-strong` 在深色里是 `#363b41`,压在 `#0b0c0e` 上只有
     * 约 1.9:1。层次感换成的是"这只鼠标断了一半"。
     *
     * 换成 `--text-dim` 之后外壳与分区同色、同为 1.4px,整只读得出来;
     * 分区仍然分得清,靠的是它们各自那层浅底 —— **形状本身也是分开的
     * 闭合路径**,所以填充在深色里几乎看不见(近黑区间的老问题)也不影响。
     */
    color: var(--text-dim);
  }

  :global(.repair-figure__shell) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }

  /*
   * 可维修区那层底。**用 `--bg-elevated` 而不是 `--bg-inset`。**
   *
   * `--bg-inset` 在浅色下是深一档的灰(看得见),在深色下却是 `#07080a`
   * 压在纸面 `#0b0c0e` 上 —— 那正是文档里量过的近黑区间,约 1.03:1,
   * **填充等于没画**。于是同一张图在浅色下有分区、在深色下没有,两个主题
   * 长得不一样。
   *
   * `--bg-elevated` 走的是反方向:浅色是白(比纸面亮)、深色是 `#15171a`
   * (也比纸面亮)。两档都出得来,而且"抬起来的一块"正好是这几个部件的意思。
   */
  :global(.repair-figure__zone) {
    fill: var(--bg-elevated);
    stroke: currentColor;
    stroke-width: 1.4;
  }

  /*
   * 那排胶囊。`flex-wrap` 而不是网格 —— 数量会变(以后可能加"回报率"
   * 或者型号页),按内容排最省事,窄了自动换行。
   */
  .repair-cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin: 14px 0 4px;
  }

  .repair-cta__label {
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  /*
   * 说明挪到鼠标右边。**横排是看过一版竖排之后改的**:竖排时鼠标居中、
   * 说明在下面,面板 476px 高而内容只占中间一条,两边各空出约 420px ——
   * 浮在纸面上时那叫留白,装进面板里就叫"空的"。
   * 横排把这一条的宽度用掉,面板也从 476 掉到 300 出头。
   *
   * `flex: 1 1 260px` 给的是"尽量宽、但窄到 260px 就换行"的下限 ——
   * 420 下它连同鼠标一起叠成一列,不用写断点。
   */
  .repair-hero figcaption {
    flex: 1 1 260px;
    max-width: 34em;
    text-align: left;
    font-size: 0.9rem;
    color: var(--text-dim);
    line-height: 1.75;
  }

  /*
   * 卡片长相住在 `global.css` 的 `.card` / `.card-grid` 里 —— 工具页正文
   * (`.prose--cards`)用的是同一份,所以这边一行样式都不写。两处各写一份的话,
   * 改一处忘一处,而"两边看着不一样"在一屏之内看不出来。
   */

  /*
   * 案例。
   *
   * **它长得像一张卡,但它不是首页那种卡**:那个是"能直接开测的装置",
   * 有 `data-mini*` 挂钩、状态机和惰性挂载;这里是一块静态的对比数据。
   * 共用那套机制只会把两件事焊在一起。
   *
   * 左右两栏用 `auto-fit`:够宽并排,不够宽自己叠起来,不写媒体查询 ——
   * 和 `.workbench` 是同一条比例语言。
   */
  .case {
    margin: 18px 0 26px;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }

  .case__head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 14px;
    font-weight: 600;
    color: var(--text);
  }

  /*
   * 「示例」那枚小标签。**它必须显眼到不会被略过** —— 里面的数字是格式示例,
   * 不是一次真实的维修记录,让人误当成实测数据是这一页唯一不能出的错。
   */
  .case__tag {
    padding: 1px 8px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-pill);
    font-size: 0.72rem;
    font-weight: 400;
    color: var(--text-faint);
  }

  .case__pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 18px;
  }

  .case__side {
    min-width: 0;
  }

  .case__when {
    margin: 0 0 8px;
    font-size: 0.8rem;
    color: var(--text-faint);
  }

  .case__rows {
    margin: 0;
  }

  .case__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    padding: 7px 0;
    border-top: 1px solid var(--border);
    font-size: 0.9rem;
  }

  .case__row dt {
    color: var(--text-dim);
  }

  .case__row dd {
    margin: 0;
    font-weight: 600;
  }

  /*
   * 「有故障」——**纸面的朱砂位**。语义色在纸面和仪器窗里是两个色值,
   * 这一处住在纸面上,所以取的是 `#c2410c`(浅)/ `#f87171`(深),
   * 和仪器窗里那个 `--well-danger` 不是同一个数。
   *
   * 修后那一栏一律默认墨色:正常位不另开一个绿色,这是全站的规矩。
   */
  .case__bad {
    color: var(--danger);
  }

  .case__note {
    margin: 14px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    font-size: 0.88rem;
    color: var(--text-dim);
    line-height: 1.7;
  }

  /*
   * 二维码那一节。格子的长相全在共用的 `.qr*` 里(`global.css`),
   * 这里只管排布和尺寸。
   *
   * `--qr-size` **由这一节给,不由 `.qr` 自己定**:悬浮窗里要 128px,
   * 这一页要 168px —— 这一格是专门给人拿手机过来扫的。
   *
   * 用 `flex-wrap` 而不是媒体查询,和 `.workbench` / `.keyboard` 同一条
   * 比例语言:够宽并排、不够宽自己换行,这一节因此**一条断点都不用写**。
   */
  /*
   * 自测工具索引卡那一排。**从首页整块搬过来的** —— 搬的时候一个数都没改。
   *
   * `240px` 的下限是按九个工具反算的:`floor((1060 + 12) / (240 + 12)) = 4`,
   * 所以 1440 下排成 4 列(4 + 4 + 1),420 下 1 列。和 `.card-grid--tight`
   * 那条 210px 用的同一个算法 —— **不是看着差不多调的**。
   *
   * 末行只有一张卡会空着右边,这一条**接受**(理由和 `.prose--cards` 那节
   * 写的一样:文字卡末尾换行是常态;换成 flex 撑满的话,最后那一张会拉成
   * 整行 1060px,比空洞更糟)。
   */
  .tool-index {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 12px;
    padding: 0;
    margin: 0 0 1.75rem;
    list-style: none;
  }

  .tool-card {
    /* 悬停那圈渐变的定位基准 —— 它 `inset: -1px`,要贴着卡片 */
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
    height: 100%;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-elevated);
    text-decoration: none;
  }

  /*
   * 图标那一格。**色相只长在这里** —— 正文、边框、数字一概不染。
   *
   * `color: var(--hue)` 直接喂给里面那段 SVG(它的描边是 `currentColor`),
   * 所以同一份母题在工具箱页是灰的、在这里是彩的,**图形本身一个字节都没改**。
   */
  .tool-card__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    margin-bottom: 2px;
    border-radius: var(--radius-sm);
    background: var(--bg-inset);
    color: var(--hue);
  }

  .tool-card__icon svg {
    width: 20px;
    height: 20px;
  }

  .tool-card__name {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text);
  }

  .tool-card__desc {
    font-size: 0.85rem;
    line-height: 1.65;
    color: var(--text-dim);
  }

  /*
   * 悬停:一圈**明显的渐变环** + 标题和图标转成这一项的色相。
   *
   * **第一版用的是"两层背景 + `background-clip`"那套,用户看了说不够明显**
   * —— 因为那圈只有 1px,而 1px 的渐变在纸面上和一条灰线差不多粗,
   * 正是"看不出来"的那一类。所以改成**伪元素画一圈 2px 的环**。
   *
   * `mask-composite` 是关键:两层 mask 相减,只留"外框那一圈",中间挖空 ——
   * 画的是环,不是一块渐变底。`-webkit-mask-composite` 用的是另一个关键字
   * (`xor` 对 `exclude`),两个都写。
   *
   * 它 `position: absolute`、`pointer-events: none`,**完全不参与布局** ——
   * 所以加粗这一圈**不会动卡片的尺寸**(实测悬停前后位置逐字节相同)。
   * 用 `border-width` 加粗就会,那是这一条不能用边框做的原因。
   *
   * **只在悬停时出现。** 静止时整页仍然只有图标那一格有色 ——
   * 所以它读起来是"我在指这一项",不是"这一项在出数"。
   */
  .tool-card::before {
    content: '';
    position: absolute;
    /* 往外扩 1px,把卡片自己那条 1px 的边也盖住 */
    inset: -1px;
    border-radius: inherit;
    padding: 2px;
    background: linear-gradient(120deg, var(--hue), #8b5cf6, #ec4899);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0;
    pointer-events: none;
  }

  .tool-card:hover::before,
  .tool-card:focus-visible::before {
    opacity: 1;
  }

  /*
   * **抬起来** —— 和 `.card` / `.prose--cards` 那批是同一条判决、同一套数:
   * 位移 + 投影两样一起给,少一样都读不出"浮起来"(只位移像抖了一下,
   * 只投影像脏了一块)。用户看完那圈渐变环说的正是「只有框有变化,
   * 没有那种悬浮起来的感觉」。
   *
   * `transform` 不引起重排,但它会改 `getBoundingClientRect()` 的结果 ——
   * 这批卡片里没有按 rect 定位的东西,所以安全(首页那七张装置卡因此不加)。
   */
  .tool-card {
    transition:
      transform 140ms ease,
      box-shadow 140ms ease;
  }

  .tool-card:hover,
  .tool-card:focus-visible {
    /* 把卡片自己那条灰边让出来,免得和渐变环叠成两层 */
    border-color: transparent;
    transform: translateY(-2px);
    /* 同 `.card`:必须比静止那层深,否则悬停看着像陷下去 */
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.06),
      0 14px 26px -10px rgb(0 0 0 / 0.18);
    text-decoration: none;
  }

  .tool-card:hover .tool-card__name,
  .tool-card:focus-visible .tool-card__name {
    color: var(--hue);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 28px;
    margin: 18px 0 0;
    padding: 24px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    --qr-size: 168px;
  }
</style>
