---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatPanel from '../components/StatPanel.astro';
import { findTool } from '../lib/tools';
import { faqHtml, faqText } from '../lib/faq';
import { REPRESS_RADIUS_PX, REPRESS_WINDOW_MS } from '../lib/analysis';
import { BUTTONS } from '../lib/mouse-buttons';

const tool = findTool('hold-drag-test')!;

const FAQ = [
  {
    q: '页面上的“疑似瞬断”到底测的是什么?',
    a:
      '测的是“松开后又极快地原地按下”。判据是两条同时成立:间隔短于 ' +
      REPRESS_WINDOW_MS +
      ' 毫秒,并且位置挪动不超过 ' +
      REPRESS_RADIUS_PX +
      ' 像素。这个动作人手做不出来——人最快的双击也在 60 毫秒以上,而且鼠标会因为反作用力挪位置。' +
      '所以满足这两条的,基本只可能是按键信号自己断了一下。',
  },
  {
    q: '为什么叫“疑似”而不是直接说故障?',
    a:
      '因为浏览器里根本没有“按键瞬断”这个信号。中途断一下,在事件流里就是一次松开加一次按下,' +
      '和用户真的松手再按**完全一样**,没有任何字段能把两者区分开。能用的只有行为特征,' +
      '而行为特征不是铁证。所以判读权在你手上:如果你确定自己一直按着没松,这里却报了瞬断,那就是鼠标的问题。',
  },
  {
    q: '按住的时候为什么会断?',
    a:
      '**微动开关**的金属触点在几千次点击之后会氧化、磨损,接触变得不可靠,按住不动时就会瞬间失去接触:' +
      '系统先收到一个“松开”,紧接着收到一个“按下”,手里拖着的文件就掉在半路。' +
      '这件事在**普通点击里根本看不出来**——一次点击只有几十毫秒,而拖拽要按住好几秒,' +
      '按得越久越容易撞上那一下。' +
      '它和**双击**(按一下却触发两次)是同一个根因的两面:同一对磨损的触点,既可能抖出多余的一次点击,' +
      '也可能在按住时断开,所以这两件事常常一起出现。' +
      '本页报出疑似瞬断、双击页同时也报出连击的话,基本可以认定是微动老化,而不是浏览器或驱动的问题。' +
      '真要修就是换微动(常见的品牌有欧姆龙、凯华、华诺),或者在保修期内走售后。',
  },
  {
    q: '拖着拖着东西掉了,用这个能查出来吗?',
    a:
      '能,这正是它最主要的用途。拖拽文件时中途掉落,通常就是按住期间发生了瞬断——' +
      '系统收到“松开了”,于是把文件丢在了当时的位置。测法是在这个区域里按住左键来回拖动十几秒,' +
      '松开后看日志里那一次的瞬断次数是不是 0。' +
      '注意别把窗口失焦算进去:按了 Alt+Tab 的话,系统确实会认为你松手了,那不是鼠标的错。',
  },
  {
    q: '五个键都能测吗?侧键呢?',
    a:
      '左键、中键、右键、两个侧键都能测,按住哪个键就记在哪个键名下,同时按住几个也分得开。' +
      '但侧键有两个前提,不满足的话这一行会一直显示破折号(未测),而不是 0 次。' +
      '第一,**有些鼠标的侧键根本不是以鼠标按键的形式上报的**——厂商驱动把它发成了键盘事件或者一段宏,' +
      '浏览器收不到任何鼠标事件,页面自然无从测起。' +
      '第二,**有些浏览器不允许网页取消侧键的前进/后退**,一按整页就跳走。' +
      '这两种情况都只说明“页面没收到”,**不等于这个键按了 0 次**——把两者混成一个数字,' +
      '正是这类测试最容易骗人的地方。',
  },
  {
    q: '按住右键拖动时屏幕上画出一条蓝线,是你们画的吗?',
    a:
      '不是,而且**这一页拦不掉它**。那是 **Edge 自带的“鼠标手势”**:它把“按住右键拖动”解释成在画一个手势,' +
      '顺手把轨迹画在屏幕上。它不是右键菜单,所以网页里那些屏蔽右键菜单的写法对它一概无效——' +
      '微软官方也确认过,没有任何办法从网页端关掉它。' +
      '更要紧的是它不只是画条线:**手势凑够形状之后浏览器会直接执行动作**(后退、关闭标签页之类),' +
      '整页一跳走,刚测的成绩就没了。' +
      '它在**中文区的 Edge 里默认是开着的**,关法是地址栏输入 edge://settings/mouseGesture,' +
      '关掉总开关;不想全关的话,同一页里把本站加进“配置鼠标手势”的阻止列表,只对本站生效。' +
      'Chrome 和其他浏览器没有这个功能,不受影响。',
  },
  {
    q: '为什么有时候这一整段会被标成“按着没松”?',
    a:
      '如果你松开后页面没收到松开事件(比如指针在浏览器窗口外松的),那一段就会显示成还没结束。' +
      '这是如实报告而不是出错——页面只能知道自己收到了什么。',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: tool.name,
      description: tool.description,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQ.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: faqText(item.a) },
      })),
    },
  ],
};
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  current={tool.slug}
  jsonLd={jsonLd}
>
  <h1>鼠标长按拖拽测试</h1>

  <p class="prose">
    按住任意一个鼠标按键,在下面的区域里来回拖动十几秒,然后松开。页面会统计每一次按住期间
    <strong>有没有出现过极短的断开又重按</strong>——那正是拖拽文件时中途掉落的成因。
    左键、中键、右键、两个侧键都支持,按住期间即使把指针拖出这个区域也没关系,一样会继续跟踪。
  </p>

  <div id="cap-notice"></div>

  <div class="workbench">
    <div class="workbench__stage">
      <div class="test-area well drag-pad" id="area" data-holding="false">
        <div class="test-area__hint" id="hint">在这里按住任意一个键,然后来回拖动</div>
        <div class="drag-live" id="live" hidden>
          <div class="drag-live__value" id="live-hold">0</div>
          <div class="drag-live__label">
            <span id="live-button">左键</span> 按住中 · 已拖动 <span id="live-distance">0</span> px
          </div>
        </div>
      </div>
    </div>

    <div class="workbench__readout">
      <div class="verdict">
        <div>
          <div class="verdict__label">疑似瞬断</div>
          <div>
            <span class="verdict__value" id="drops-total">0</span><span class="verdict__unit">次</span>
          </div>
          <div class="verdict__note" id="verdict-note">
            按住任意一个键拖动,松开后这里会给出结论
          </div>
        </div>
        <div class="verdict__aside">
          <span class="badge badge--idle" id="state-badge">等待拖拽</span>
        </div>
      </div>

      <div class="stat-grid">
        <StatPanel id="sessions" label="按住次数" primary hint="各键合计" />
        <StatPanel id="longest" label="最长一次" unit="ms" hint="各键合计" />
        <StatPanel id="distance" label="累计路程" unit="px" hint="同时按住多个键时各记一份" />
        <StatPanel id="open" label="没收到松开" hint="结束不了的那几次" />
      </div>
    </div>
  </div>

  <h2>按按键分开看</h2>
  <p class="prose tight">
    五个键都在下面列着。破折号表示<strong>这个键一个事件都没收到</strong>——可能是没测它,
    也可能是鼠标或驱动根本没把它当成鼠标按键上报,<strong>不等于按了 0 次</strong>。
    按住期间,对应的那一行会高亮。
  </p>
  <table class="ref-table by-button">
    <thead>
      <tr>
        <th>按键</th>
        <th>按住次数</th>
        <th>疑似瞬断</th>
        <th>最长一次 (ms)</th>
      </tr>
    </thead>
    <tbody>
      {
        BUTTONS.map((button) => (
          <tr id={`btn-row-${button.code}`} data-current="false">
            <td>{button.name}</td>
            <td id={`btn-count-${button.code}`}>—</td>
            <td id={`btn-drops-${button.code}`}>—</td>
            <td id={`btn-longest-${button.code}`}>—</td>
          </tr>
        ))
      }
    </tbody>
  </table>

  <div class="controls">
    <button type="button" id="reset">重置</button>
    <span class="test-hint" id="hint2">
      指针拖出区域外也会继续跟踪,直到松开为止
    </span>
  </div>

  <h2>每次拖拽的记录</h2>
  <p class="prose tight">
    最近 10 次,新的在上面。<span class="mark-danger">红色</span>的那几次里检测到了瞬断。
  </p>
  <ul class="log-list" id="log"></ul>

  <section class="prose">
    <h2>这项测试测不到什么</h2>
    <p>
      要诚实说明的是:<strong>浏览器没有“按键瞬断”这个信号。</strong>
      按键中途断一下,在事件流里就是一次松开加一次按下——和用户真的松手再按
      <strong>完全一样</strong>,没有任何字段能把两者分开。页面能做的只是在行为上找破绽:
      人手不可能在 {REPRESS_WINDOW_MS} 毫秒内原地重按,所以满足“极短 + 位置几乎没变”
      这两个条件的,才被算作疑似瞬断。
    </p>
    <p>
      所以<strong>判读权在你自己手上</strong>:如果你确定自己一直按着没松手,
      这里却报了瞬断,那这只鼠标的按键信号确实断过。反过来,如果你中间真的换了手或者松了一下,
      那报出来的就是你自己干的。日志里那几次的时长和路程可以帮你回忆当时在做什么。
    </p>
    <p>
      还有一类是<strong>页面根本收不到</strong>的情况:有些鼠标的侧键被驱动发成键盘事件,
      有些浏览器不允许网页取消侧键的前进/后退。这时那一行会一直空着(破折号),
      而<strong>空着不是“0 次”</strong>——是“没有测到”。这两件事在数据上长得一样,结论却相反。
    </p>
    <p>
      第三种是<strong>浏览器自己把右键抢走</strong>:Edge 有一个自带的“鼠标手势”功能,
      按住右键拖动会被它解释成在画手势——屏幕上会跟着画出一条蓝线,而这条轨迹不是本页画的,
      <strong>网页也没有任何办法阻止它</strong>(微软官方确认过,连命令行开关都关不掉)。
      它比前两种更麻烦的地方在于:手势凑够形状后浏览器会直接执行动作(后退、关标签页),
      整页一跳走,刚测的成绩就没了。它在<strong>中文区的 Edge 里默认开着</strong>,
      关法是 edge://settings/mouseGesture,详见下面常见问题里的那一问。
    </p>

    <h2>和“拖拽掉落”的关系</h2>
    <p>
      拖动文件时中途掉落,通常就是按住期间发生了瞬断:系统收到“松开了”,于是把文件放在了
      当时指针的位置。同样的瞬断在普通点击里几乎看不出来(可能只是偶尔漏一次点击),
      但在拖拽里会立刻显形——这是这项测试比点击测试更灵敏的原因。
    </p>

    <h2>常见问题</h2>
    <div class="faq">
      {
        FAQ.map((item) => (
          <div class="faq__item">
            <div class="faq__q">{item.q}</div>
            <p class="faq__a" set:html={faqHtml(item.a)} />
          </div>
        ))
      }
    </div>
  </section>

  <style>
    .drag-pad {
      cursor: grab;
      height: 300px;
    }

    .drag-pad[data-holding='true'] {
      cursor: grabbing;
      border-color: var(--accent);
    }

    /* .drag-live 的定位、[hidden]、大字和标签都在 global.css 里
       (和 CPS / DPI / 滚轮三页共用) */

    /*
     * 这张表后三列全是数字,都要等宽 + tabular —— 值每隔 100ms 变一次,
     * 比例数字会让整列左右跳。global.css 里只有 `.ref-table--kv` 那一档
     * 管第二列,而这里第二到第四列都是数值,所以在页面里补一条
     * (这是那份全局规则本来就允许的方向:数值列由各自页面决定)。
     */
    .by-button td:nth-child(n + 2) {
      font-family: var(--font-mono);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    /* 拖拽必然带文字选中,测试期间抑制掉 */
    :global(html.is-testing) {
      user-select: none;
      -webkit-user-select: none;
    }
  </style>

  <script>
    import { analyzeDragEpisodesByButton, type DragEpisode, type DragEvent } from '../lib/analysis';
    import { BUTTON_CODES, buttonName, maskFromButtons } from '../lib/mouse-buttons';
    import { suppressSideButtonNavigation } from '../lib/side-buttons';
    import {
      createTicker,
      el,
      format,
      mountCapabilityNotices,
      setBadge,
      setStat,
      setText,
      suppressWorkbenchDefaults,
    } from '../lib/ui';

    mountCapabilityNotices(el('cap-notice'));

    // 右键菜单 / 中键自动滚动会打断拖拽。判据和实现见 ui.ts
    suppressWorkbenchDefaults();

    /*
     * 侧键在浏览器里被硬绑成「后退 / 前进」,一按整页就跳走——而侧键正是这一页
     * 要测的东西之一。拦截的机制见 side-buttons.ts。
     *
     * **刻意不接它返回的还原函数**,理由和 `suppressWorkbenchDefaults()` 完全相同
     * (见 ui.ts 的文件头):页面进 bfcache 时 `pagehide` 照样触发,在那里把它摘掉,
     * 用户按返回键把页面恢复回来之后侧键就再没人拦了——一按侧键整页跳走、成绩全丢。
     */
    suppressSideButtonNavigation();

    /**
     * 移动事件的记录间隔(毫秒)。采样层在 1000Hz 下每秒会产生 1000 个事件,
     * 一次十几秒的拖拽就是上万个点——而对"算个路程"来说,每 8ms 采一个
     * (最多 2 像素的误差)完全够用,所以抽稀掉。
     *
     * **按下和松开不抽稀**:瞬断判据靠的就是这两个事件的精确时刻,
     * 抽掉一个就等于把故障本身删了。多按键之后这条扩展成"**掩码一变就不抽稀**"
     * ——见下面 pointermove 里的说明。
     */
    const MOVE_SAMPLE_MS = 8;

    /**
     * 松开后还保持"在跟踪"的时长,用来捕获瞬断之后的重新按下。
     *
     * 这是**指针级**的宽限,不按每个键各算一份:它接住的是"松手后又落回区域外"
     * 这件事,而那是整个指针的状态,不是某一个键的。
     */
    const REPRESS_GRACE_MS = 80;

    const LOG_LIMIT = 10;

    const DEFAULT_NOTE = '按住任意一个键拖动,松开后这里会给出结论';

    const area = el('area');
    const hint = el('hint');
    const live = el('live');
    const logHost = el('log');

    /** 完整的按下/松开/移动序列,所有统计都从它派生 */
    const events: DragEvent[] = [];

    /** 还在一次拖拽会话里(含松开后的宽限期,好接住瞬断后的重按) */
    let armed = false;
    let armTimer = 0;
    let lastMoveAt = 0;

    /**
     * 上一次事件时按着哪些键(本站编号的位掩码)。
     *
     * 两个用处:决定"这次移动要不要抽稀掉",以及高亮表格里正被按着的那些行。
     * 各键自己的按下/松开**不在这里判断**——那是 `analyzeDragEpisodesByButton`
     * 的活,页面只负责如实记录每一次事件的掩码。
     */
    let downMask = 0;

    /**
     * 记一条事件。
     *
     * `t` 由调用方给,而不是在这里统一取 `performance.now()`:瞬断的判据是
     * **`pointerup` 与 `pointerdown` 之间的间隔**,而这两个事件很可能被浏览器
     * 攒进同一个任务里派发——那一刻两个处理函数几乎是同时跑的,`performance.now()`
     * 的差会塌到 0,于是一次正常的"松手再按"也会落进 30ms 的窗口里,报成瞬断。
     *
     * 所以真实事件一律传 `event.timeStamp`(事件自己带的时刻,不吃派发延迟),
     * 只有 `blur` 里补发的那条合成事件用 `performance.now()`——那条本来就没有
     * 对应的真实事件。两者同源,可以直接相减。
     *
     * 这条约定对**从掩码里比对出来的**那些按下/松开同样成立:它们的时刻就是
     * 暴露了这次变化的那条真实事件的时刻,所以下面传的一律是 `event.timeStamp`。
     */
    function record(t: number, x: number, y: number, kind: DragEvent['kind'], buttonMask: number): void {
      events.push({ t, x, y, kind, buttonMask });
    }

    function arm(): void {
      armed = true;
      window.clearTimeout(armTimer);
      area?.setAttribute('data-holding', 'true');
      document.documentElement.classList.add('is-testing');
      hint?.setAttribute('hidden', '');
      live?.removeAttribute('hidden');
    }

    function scheduleDisarm(): void {
      window.clearTimeout(armTimer);
      armTimer = window.setTimeout(() => {
        armed = false;
        downMask = 0;
        area?.setAttribute('data-holding', 'false');
        document.documentElement.classList.remove('is-testing');
        render();
      }, REPRESS_GRACE_MS);
    }

    // ---- 渲染 ----

    /** 一个按键的一次按住,带上它是哪个键 */
    interface KeyedEpisode {
      code: number;
      episode: DragEpisode;
    }

    function setRowCurrent(code: number, on: boolean): void {
      const row = el(`btn-row-${code}`);
      if (!row) return;
      const value = on ? 'true' : 'false';
      if (row.getAttribute('data-current') !== value) row.setAttribute('data-current', value);
    }

    function render(): void {
      const byButton = analyzeDragEpisodesByButton(events);
      const all: KeyedEpisode[] = [];

      let totalDrops = 0;
      let longest = 0;
      let distance = 0;
      let open = 0;
      let holding: KeyedEpisode | null = null;
      const dropKeys: number[] = [];

      for (const [code, episodes] of byButton) {
        let count = 0;
        let drops = 0;
        let longestHere = 0;

        for (const episode of episodes) {
          all.push({ code, episode });

          /*
           * 未结束的那一段**也计入**次数与最长一次——它是一次真实的按住,
           * 只是页面没收到松开事件。原先只数已结束的,结果是:如果你唯一那次
           * 拖拽没收到松开,统计面板会说"0 次拖拽",而下面的日志里明明躺着一行,
           * 自己跟自己打架。分开计数由"没收到松开"那一格负责。
           */
          count++;
          drops += episode.drops;
          distance += episode.distancePx;
          if (episode.durationMs > longestHere) longestHere = episode.durationMs;
          if (episode.durationMs > longest) longest = episode.durationMs;

          if (episode.open) {
            open++;
            // 实时读数取**最近开始**的那一段:同时按住两个键时,看的是刚按下的那个
            if (holding === null || episode.startMs > holding.episode.startMs) {
              holding = { code, episode };
            }
          }
        }

        if (drops > 0) dropKeys.push(code);
        totalDrops += drops;

        setText(el(`btn-count-${code}`), format(count));
        setText(el(`btn-drops-${code}`), format(drops));
        setText(el(`btn-longest-${code}`), format(longestHere));
        setRowCurrent(code, armed && (downMask & (1 << code)) !== 0);
      }

      // 一个事件都没收到过的键:整行破折号。"没测到"不是"0 次"
      for (const code of BUTTON_CODES) {
        if (byButton.has(code)) continue;
        setText(el(`btn-count-${code}`), '—');
        setText(el(`btn-drops-${code}`), '—');
        setText(el(`btn-longest-${code}`), '—');
        setRowCurrent(code, false);
      }

      setText(el('drops-total'), String(totalDrops));
      setStat('sessions', format(all.length));
      setStat('longest', format(longest));
      setStat('distance', format(distance));
      setStat('open', format(open));

      const names = dropKeys.map(buttonName).join('、');
      if (totalDrops > 0) {
        setBadge(el('state-badge'), `${names} 疑似瞬断`, 'poor');
        setText(
          el('verdict-note'),
          `${names}上 ${totalDrops} 次“极短且原地”的重按。当时若没松手,就是按键信号断过。`,
        );
      } else if (all.length > 0) {
        setBadge(el('state-badge'), '未发现瞬断', 'good');
        setText(el('verdict-note'), `共 ${all.length} 次按住,全程没有出现过断开。`);
      }

      // ---- 实时数字 ----
      if (armed && holding !== null) {
        // 按住不动时不会产生任何事件,`durationMs` 会停在最后一个事件上,
        // 所以实时这个数必须走墙上时钟,否则松手前它永远是 0。
        setText(el('live-hold'), (performance.now() - holding.episode.startMs).toFixed(0));
        setText(el('live-distance'), holding.episode.distancePx.toFixed(0));
        setText(el('live-button'), buttonName(holding.code));
      }

      renderLog(all);
    }

    function renderLog(all: readonly KeyedEpisode[]): void {
      if (!logHost) return;
      if (all.length === 0) {
        const empty = document.createElement('li');
        empty.className = 'log-empty';
        empty.textContent = '还没有拖拽记录';
        logHost.replaceChildren(empty);
        return;
      }

      const shown = all.slice(Math.max(0, all.length - LOG_LIMIT)).reverse();
      const fragment = document.createDocumentFragment();

      for (let i = 0; i < shown.length; i++) {
        const { code, episode } = shown[i];
        const item = document.createElement('li');
        item.className = episode.drops > 0 ? 'log-item log-item--alert' : 'log-item';

        const index = document.createElement('span');
        index.className = 'log-item__index';
        index.textContent = `#${all.length - i}`;

        const value = document.createElement('span');
        value.className = 'log-item__value';
        value.textContent = episode.open ? '按着没松' : `${episode.durationMs.toFixed(0)} ms`;

        /*
         * 按键名并进**文字**里,不另起一个元素。日志条目是运行期由 JS 拼出来的,
         * 页面 `<style>` 的规则带着 data-astro-cid 够不着它们(ui.ts 拼出来的
         * `.notice` 就是这个下场),新元素要配样式就得动 global.css。
         */
        const note = document.createElement('span');
        note.className = 'log-item__note';
        note.textContent =
          episode.drops > 0
            ? `${buttonName(code)} 疑似瞬断 ${episode.drops} 次`
            : `${buttonName(code)} 拖动 ${episode.distancePx.toFixed(0)} px`;

        item.append(index, value, note);
        fragment.appendChild(item);
      }

      logHost.replaceChildren(fragment);
    }

    // 按住不动时不会有事件,靠刷新循环把实时秒数推上去
    const stopTicker = createTicker(100, () => {
      if (armed) render();
    });

    // ---- 交互 ----

    /**
     * 按下监听见挂在 window 上,而不是只挂在测试区上。
     *
     * 两个理由:瞬断之后的重新按下可能落在区域外;以及第一次按下如果落在
     * 区域内的文字上,事件照样要算数。`armed` 那个宽限期之外的、落在区域外的
     * 按下则会被忽略——否则页面上随便点一下也会开始记一笔。
     *
     * 取键一律走 `event.buttons` 的掩码,**不用 `event.button`**:第二个键的按下
     * 和第一个键的松开都不会有 `pointerdown` / `pointerup`,只有掩码会变
     * (见 CLAUDE.md「组合按键」)。
     */
    window.addEventListener('pointerdown', (event) => {
      const mask = maskFromButtons(event.buttons);
      if (mask === 0) return;

      const inside = area?.contains(event.target as Node) ?? false;
      if (!inside && !armed) return;

      /*
       * 只在主键上 preventDefault:它挡的是拖拽必然带起的原生拖放(拖图片、拖链接),
       * 那是左键的事。右键菜单和中键自动滚动已经由 suppressWorkbenchDefaults 处理,
       * 在这里再取消一次会把兼容鼠标事件一并吞掉——比如右键点在链接上的
       * 「在新标签页中打开」。
       */
      if ((mask & 0b1) !== 0) event.preventDefault();

      arm();
      downMask = mask;
      record(event.timeStamp, event.clientX, event.clientY, 'down', mask);
      render();
    });

    window.addEventListener(
      'pointermove',
      (event) => {
        if (!armed) return;

        const mask = maskFromButtons(event.buttons);
        const changed = mask !== downMask;

        /*
         * 抽稀只抽"什么都没变"的那种移动。**掩码一变就必须记**,哪怕它落在上一个
         * 采样点的 2ms 之内——一个键的按下或松开改变了后面全部的结论,抽掉它等于
         * 把那次按键删了。这和"按下和松开不抽稀"是同一条道理,多按键之后
         * 那些边沿正是藏在移动事件里的。
         *
         * (不这么写的话会很难查:按住左键再松开左键,浏览器一次 `pointerup`
         * 都不派发,左键那一段就会永远挂着不结束。)
         */
        const now = performance.now();
        if (!changed && now - lastMoveAt < MOVE_SAMPLE_MS) return;
        lastMoveAt = now;

        downMask = mask;
        record(event.timeStamp, event.clientX, event.clientY, 'move', mask);
      },
      { passive: true },
    );

    function release(event: PointerEvent): void {
      if (!armed) return;

      /*
       * 掩码一律记 0:`pointerup` 只在**最后一个键**松开时派发,所以此刻手上确实
       * 一个键都不剩;`pointercancel` 更彻底——指针被系统收走了,键也不再算按着。
       * 至于松开的**是哪个**键,这个事件本身并不携带(它的 `buttons` 就是 0),
       * 由 analyzeDragEpisodesByButton 跟上一份掩码比对推出来。
       */
      record(event.timeStamp, event.clientX, event.clientY, 'up', 0);
      downMask = 0;
      scheduleDisarm();
      render();
    }

    window.addEventListener('pointerup', release);
    // 系统把指针收走了(触控笔、驱动问题),当作松开收尾,免得一次拖拽永远挂着
    window.addEventListener('pointercancel', release);

    // 窗口失焦时收不到松开事件。补一条合成事件把这一段收尾,
    // 否则它会一直显示成"按着没松"。
    window.addEventListener('blur', () => {
      if (!armed) return;
      const last = events[events.length - 1];
      // 合成事件:没有真实事件可依,取当下的墙钟时间
      if (last && last.buttonMask !== 0) {
        record(performance.now(), last.x, last.y, 'up', 0);
      }
      armed = false;
      downMask = 0;
      area?.setAttribute('data-holding', 'false');
      document.documentElement.classList.remove('is-testing');
      render();
    });

    // 拖拽必然带起原生拖放(拖图片、拖链接),那会打断跟踪
    window.addEventListener('dragstart', (event) => {
      if (armed) event.preventDefault();
    });

    el('reset')?.addEventListener('click', () => {
      events.length = 0;
      armed = false;
      downMask = 0;
      window.clearTimeout(armTimer);
      area?.setAttribute('data-holding', 'false');
      document.documentElement.classList.remove('is-testing');
      hint?.removeAttribute('hidden');
      live?.setAttribute('hidden', '');
      setBadge(el('state-badge'), '等待拖拽', 'idle');
      setText(el('verdict-note'), DEFAULT_NOTE);
      render();
    });

    window.addEventListener('pagehide', () => {
      stopTicker();
      window.clearTimeout(armTimer);
      document.documentElement.classList.remove('is-testing');
    });

    render();
  </script>
</BaseLayout>
