---
import BaseLayout from '../layouts/BaseLayout.astro';
import { READY_TOOLS, REPAIR, TOOLBOX } from '../lib/tools';
import { ICONS } from '../lib/icons';
import { UNDRAW_STATUS_PAGE_SVG } from '../lib/illustrations';
import { href } from '../lib/url';

/*
 * 404 —— **全站唯一一个不进任何注册表的页面**,而且它连"是不是工具"都不是
 * (工具、工具箱、维修页三者的区别见 `tools.ts`)。
 *
 * Astro 把它编译成 `dist/404.html`,GitHub Pages 对认不出的路径就发这一页 ——
 * 在此之前落到的是 Pages 自带的英文 404:没有导航、没有回首页的路,
 * 一个手打错地址的人就死在那儿了。
 *
 * 两条和别处不一样的写法:
 *
 * - **`noindex`** —— 这一页是给一个不存在的地址渲染的,`Astro.url.pathname`
 *   那一刻就是那个坏地址。声明一个指向不存在页面的 canonical 是错的,
 *   所以 `BaseLayout` 那个开关会把它换成 `<meta name="robots" content="noindex">`。
 * - **它列出的是全部工具**,而不是像工具页那样只给正文。落到 404 的人已经
 *   迷路了,再让他自己找导航是雪上加霜;把能去的地方一次摊开,他大概率
 *   能在这儿就把路找回来。
 *
 * 名单从 `READY_TOOLS` 派生,**不手写** —— 手写的话加一件工具、这一页就悄悄
 * 少一条,而没人会来 404 页检查。
 */

const MAIN = [
  { label: '回首页', href: href(), desc: '所有工具的总入口', icon: ICONS.home },
  { label: TOOLBOX.navLabel, href: href(`${TOOLBOX.slug}/`), desc: '手稳度、涂鸦板、坏点检测这些', icon: ICONS.compass },
  { label: REPAIR.navLabel, href: href(`${REPAIR.slug}/`), desc: '测出问题了,或者想先看看怎么修', icon: ICONS.repair },
];
---

<BaseLayout
  title="页面没找到 - 在线鼠标测试"
  description="这个地址没有对应的页面。下面是站内所有的工具入口。"
  noindex
>
  {/*
    插画 + 标题并排。**这是全站唯一一张"纯装饰"的图** —— 别的地方一条都别学。

    它站得住的两个理由:**这一页本来就没有任何读数可以被打扰**(所以"有颜色的
    地方就是在出数"这条契约在这里不适用),而且 404 是个死胡同,一张让人
    放松的图比再加一段说明有用。

    图已经改成墨色了(见 `lib/illustrations.ts`),`aria-hidden` 是因为它对
    读屏用户一个字的信息都没有 —— 标题和下面那三条路已经把话说完。
  */}
  <div class="lost-hero">
    <div class="lost-hero__text">
      <h1>这个地址没有东西</h1>

      <p class="prose">
        可能是地址打错了,也可能是那个工具的网址变过。下面是站内<strong>所有</strong>工具 ——
        大概率你要找的那个就在里面。
      </p>
    </div>
    <div class="lost-hero__art" aria-hidden="true" set:html={UNDRAW_STATUS_PAGE_SVG} />
  </div>

  <h2>先看这三个</h2>

  <ul class="lost-main">
    {
      MAIN.map((item) => (
        <li>
          <a class="pill-link" href={item.href}>
            <svg class="lost-main__icon" viewBox="0 0 24 24" aria-hidden="true" set:html={item.icon} />
            {item.label}
          </a>
          <span class="lost-main__desc">{item.desc}</span>
        </li>
      ))
    }
  </ul>

  <h2>全部工具</h2>

  <ul class="lost-list">
    {
      READY_TOOLS.map((tool) => (
        <li>
          <a href={href(`${tool.slug}/`)}>{tool.name}</a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  /*
   * 三个主入口。**用 `.pill-link`**(全站那枚带箭头的跳转胶囊)—— 落到 404 的
   * 人需要的正是"点一下就能走",而不是一段说明文字。
   *
   * 说明跟在药丸右边、`--text-faint`:它是补注,不是第二条路。
   */
  .lost-main {
    margin: 14px 0 30px;
    padding: 0;
    list-style: none;
    max-width: 68ch;
  }

  /*
   * 标题 + 插画并排。窄了自动堆叠 —— 用的是 `.workbench` 那套 `flex-basis`
   * 语言,所以这一页同样一条媒体查询都不用写。
   *
   * 插画给 `max-width: 380px`:它是配角的配角,再大就会把标题挤成一行两个字。
   */
  .lost-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 36px;
    margin-bottom: 8px;
  }

  .lost-hero__text {
    flex: 1 1 320px;
    /* flex item 默认不会窄于内容宽度 —— 删了它,长英文单词会把插画挤出去 */
    min-width: 0;
  }

  .lost-hero__art {
    flex: 0 1 380px;
    min-width: 220px;
    max-width: 380px;
  }

  /*
   * `set:html` 注进来的 `<svg>` **身上没有 `data-astro-cid`**,所以页面 `<style>`
   * 的规则够不着它 —— 必须 `:global()`。这正是 CLAUDE.md 里那个 cid 坑的
   * 第三种形态(前两种是脚本 `createElement` 造的节点,和 `ui.ts` 拼的 `.notice`)。
   */
  .lost-hero__art :global(svg) {
    display: block;
    width: 100%;
    height: auto;
    /* 深色下那张线稿的浅底会变成一块近黑,压下去一档让它退到纸面里 */
    opacity: 0.92;
  }

  .lost-main li {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 12px;
  }

  /*
   * 药丸里那枚图标。`.pill-link` 本身是 `inline-flex` + `gap: 10px`,所以图标
   * 自动成为第一个 flex item、和文字之间自带那个间距 —— **不要加外边距去调**,
   * 那会和 gap 叠成两套间距,而另一处用 `.pill-link` 的地方没有图标,就对不齐了。
   */
  .lost-main__icon {
    flex: none;
    width: 15px;
    height: 15px;
    color: inherit;
  }

  .lost-main__desc {
    font-size: 0.85rem;
    color: var(--text-faint);
  }

  /*
   * 全部工具那一列。**多列**而不是一长条 —— 十七个工具竖着排下来,
   * 在 1440 下会是一条又长又空的单列。`auto-fit` 够宽自己排开、窄了叠成一列。
   */
  .lost-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 2px 20px;
    margin: 14px 0 26px;
    padding: 0;
    list-style: none;
  }

  .lost-list li {
    padding: 7px 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9rem;
  }
</style>
