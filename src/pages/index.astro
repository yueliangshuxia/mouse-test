---
import BaseLayout from '../layouts/BaseLayout.astro';
import MiniCard from '../components/MiniCard.astro';
import { CONFIDENCE_LABEL, DIAGNOSTIC_TOOLS, FUN_TOOLS, PLANNED_TOOLS } from '../lib/tools';
import type { Confidence } from '../lib/tools';
import { CONFIDENCE_NOTE, defaultMiniMode, findMiniCard } from '../lib/mini-cards';
import { href } from '../lib/url';

const title = '鼠标测试 - 在线检测鼠标按键、回报率与传感器性能';
const description =
  '免费在线鼠标测试工具。检测鼠标按键失灵、回报率(轮询率)、双击连击、滚轮、轨迹丢帧与传感器性能。基于浏览器原生接口,无需安装任何软件,数据全部在本地计算。';

/*
 * 站点根的绝对地址,**由 `site` + `base` 推出来**,不手写。
 * 手写的话换域名/换子路径时必然漏改一处,而结构化数据里给错 URL
 * 搜索引擎不会报错,只会静默地把首页认到别处去。
 */
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '鼠标测试',
  description,
  url: siteUrl,
};

/*
 * 四档可信度的名册,按"敢说的程度"从高到低排。
 *
 * 每一档的含义**只说一次**,写在网格下面那一节里。原先这是「关于测量精度」那一整节
 * (首页 512px),按测量项逐条讲;现在改成按可信度分档讲,每一项自己那一句
 * 挪进卡片底下(`MiniCard.note`)。
 *
 * **事实一条没少,只是换了切法** —— 折进卡片不等于把那节删掉。所以这段是真实
 * 可见的正文,不是 tooltip、不是折叠面板;收起来就等于把全站的主张从首页删掉。
 */
const CONFIDENCE_ORDER: Confidence[] = ['exact', 'estimate', 'shape', 'direction'];

/*
 * 空态那句话**可以随模式变**(`MiniMode.prompt`),所以首帧就要挑对那一个 ——
 * 判据和驱动复位回空态时用的是同一个 `defaultMiniMode`,不写两份。
 *
 * **只从 `DIAGNOSTIC_TOOLS` 建卡片。** 趣味工具不上卡片(理由写在
 * `mini-cards.ts` 的文件头),它们进下面那一节,只给链接。`findMiniCard` 对这
 * 批 slug 一定有值,`!` 是安全的 —— 这份对应关系由 `tests/mini-cards.test.ts`
 * 钉着(它断言的正是 `MINI_CARDS` 与 `DIAGNOSTIC_TOOLS` 一一对应)。
 */
const cards = DIAGNOSTIC_TOOLS.map((tool) => {
  const spec = findMiniCard(tool.slug)!;
  return { tool, spec, prompt: defaultMiniMode(spec)?.prompt ?? spec.prompt };
});
---

<BaseLayout title={title} description={description} current="index" jsonLd={jsonLd}>
  {/*
    标题下面**一行小字**,然后就是卡片。

    原来这里是「导语 → 可用工具 → 名册 → 网格」四段文字,读者要翻过一整屏说明
    才够得着第一个能点的东西。改成点进来就看见十张卡:想测什么直接上手,
    「这是什么站、那些标记什么意思」挪到网格下面当说明读。

    那行小字只干一件事:**说清卡片和工具页的分工**。少了它,读者会以为卡片
    就是全部——而卡片上的数只是即时读数,完整模式、逐项读数、判定依据都在
    对应的页面里。多过一行就又变回"要翻过说明才够得着"了。

    **正文一句没删,只是换了谁先出场。** 首页的正文量、以及给搜索引擎看的内容
    都不变 —— 这一条改完要重新数一遍 `<main>` 的字数对一遍。
  */}
  <h1 class="home-title">在线鼠标测试</h1>

  <p class="home-sub">
    卡片里就能直接测。要看完整模式、逐项读数和判定依据,点卡片标题进对应的页面。
  </p>

  <ul class="mini-grid">
    {cards.map(({ tool, spec, prompt }) => <MiniCard tool={tool} spec={spec} prompt={prompt} />)}
  </ul>

  {/*
    第二片:**趣味工具,只给链接,不给卡片。**

    它们和上面十项不是一类东西 —— 上面是诊断(测鼠标坏没坏),这两页是玩。
    正文里把这点说破,免得读者拿瞄准成绩去判断鼠标好坏。

    **为什么不发卡片**(判据在 `mini-cards.ts` 的文件头):两页各要一台计时器
    才能结束(反应要等一段随机延迟,瞄准要跑满 10–60 秒),而卡片那台装置是
    "空闲了就结算",拧着用;而且卡片只有 120px,刺激面和目标直径都得缩,
    缩完量出来的就已经不是那一页的数了 —— 那正是全站最不能做的一件事。

    清单从 `FUN_TOOLS` 派生,**不是手写两个 `<li>`**:手写的话加一个趣味工具
    只改 `tools.ts` 就会从这里静默消失,而下面那句"下面 N 页"也就跟着说了谎。

    样式:悬停用底色(同 `.brand` / `.site-nav__item`)—— 纸面没有色相可用,
    `color` 那条路是死的。规则写在页面自己的 `<style>` 里,不新增全局类。
  */}
  <h2>更多工具</h2>

  <p class="prose">
    上面十项是诊断,测的是"鼠标坏没坏";下面这两页是玩,成绩同样只存在本机,
    也一样会在页面上说清楚哪些数测不准、为什么。
  </p>

  <ul class="more-list">
    {
      FUN_TOOLS.map((tool) => (
        <li>
          <a class="more-list__item" href={href(`${tool.slug}/`)}>
            {tool.name}
          </a>
        </li>
      ))
    }
  </ul>

  <h2>关于这些测试</h2>

  <p class="prose">
    打开网页即可检测鼠标的按键、回报率、传感器与滚轮状态,不需要下载任何驱动或客户端。
    所有测量都在你的浏览器里完成,数据不会离开本机。
  </p>

  <p class="prose">
    每张卡右上角标着<strong>这个测量有多可信</strong>。想知道按键坏没坏,就用「直接测得」的;
    标着「只能看形状」的那几个,结论要自己对着卡底那行说明读——它们能给你的线索是真的,
    但线索不是证据。四档的分别是:
  </p>

  <dl class="confidence-key">
    {
      CONFIDENCE_ORDER.map((level) => (
        <div class="confidence-key__row">
          <dt class={`confidence confidence--${level}`}>{CONFIDENCE_LABEL[level]}</dt>
          <dd class="confidence-key__mean">{CONFIDENCE_NOTE[level]}</dd>
        </div>
      ))
    }
  </dl>

  {
    PLANNED_TOOLS.length > 0 && (
      <>
        <h2>即将上线</h2>
        <ul class="mini-grid">
          {PLANNED_TOOLS.map((tool) => (
            <li class="mini-card mini-card--planned">
              <div class="mini-card__head">
                <span class="mini-card__name">{tool.name}</span>
                <span class="confidence confidence--direction">开发中</span>
              </div>
              <p class="mini-card__desc">{tool.description}</p>
            </li>
          ))}
        </ul>
      </>
    )
  }
</BaseLayout>

<script>
  import { mountMiniCard } from '../lib/mini-devices';
  import { findMiniCard } from '../lib/mini-cards';
  import { suppressSideButtonNavigation } from '../lib/side-buttons';
  import { suppressDefaultsWithin } from '../lib/ui';

  /*
   * 默认行为的拦截:右键菜单、中键自动滚动、侧键的**后退/前进**。
   *
   * 侧键那一条不是锦上添花:浏览器把 X1/X2 硬绑成前进后退,而导航是 `mousedown`
   * 的默认行为。不拦的话用户按一下侧键就被弹回上一页,计数清零、测试中断,
   * 而且他会以为是鼠标坏了 —— 和按键测试页遇到的是同一件事(见 `side-buttons.ts`)。
   *
   * **一次装在整个网格上,不是每张卡各装一份。** 判据本来就是"按下点落在哪儿",
   * 装七份只是让七份各自记一遍同一个事实。网格是这些测试面共同的外框,
   * 落在卡与卡的缝里也还算在测。
   *
   * 为什么不是整页(工具页那样):首页是一篇正文,十张卡只是它中间的一节。
   * 整页拦会把整篇文章的右键菜单和"按侧键回上一页"一起吃掉,那是耍横不是清理。
   * 两个函数都收一个"作用域"参数,判据和工具页共用同一份实现。
   */
  for (const grid of document.querySelectorAll('.mini-grid')) {
    suppressDefaultsWithin(grid);
    suppressSideButtonNavigation(grid);
  }

  /*
   * 把十张卡里的装置接上。
   *
   * **走一遍 DOM 而不是把 `cards` 从 frontmatter 传进来** —— frontmatter 变量在
   * `<script>` 里不存在(脚本被单独打包成外链 module),所以两边是靠 `slug` 挂钩的,
   * 而 `data-mini` 上正好写着它。这也是 `mini-cards.ts` 存在的理由。
   *
   * 装置是**惰性**的:`mountMiniCard` 只挂一组探针,用户碰到哪张卡才建哪张卡的
   * 采样器 / 画布。理由写在 `mini-devices.ts` 的文件头。
   */
  for (const surface of document.querySelectorAll<HTMLElement>('[data-mini]')) {
    const slug = surface.dataset.mini;
    if (!slug) continue;
    const spec = findMiniCard(slug);
    const card = surface.closest('.mini-card');
    if (spec && card instanceof HTMLElement) mountMiniCard(card, spec);
  }
</script>

<style>
  /*
   * 标题下面一行小字,然后才是卡片。
   *
   * 全站 h1 的下边距是 0.8rem,那是留给紧跟其后的段落的;48px 的中文标题下面
   * 只隔 13px 就是一片卡片,挤得慌。所以首页单独放宽 —— 但**放宽的那一段现在
   * 归副标题**,h1 自己收回到 0.5rem,否则标题和它之间会空出一大块,
   * 读起来像两段不相干的东西。
   */
  .home-title {
    margin-bottom: 0.5rem;
  }

  /*
   * 副标题:一句话说清"卡片"和"那一页"的分工。
   *
   * 用 `--text-dim` 而不是正文色 —— 它是导引不是内容,压在卡片上面不该抢视线;
   * 也不该用 `--text-faint`,那个在深色下已经接近辅助文字的下限。
   *
   * `max-width` 按字数给:中文一个字就是一个 em,44 个字一行太长,
   * 42em 让它折成两行,读起来正好。
   */
  .home-sub {
    margin: 0 0 1.75rem;
    max-width: 42em;
    color: var(--text-dim);
    line-height: 1.6;
  }

  /*
   * 「更多工具」那两条链接。
   *
   * 用的是 `.site-nav__item` 那套:淡底药丸 + 悬停换底色和字色。**为什么不加
   * 描边或者下划线**:描边药丸是 `.confidence` 徽章的长相,而徽章就在上面那些
   * 卡片里 —— 同一节里出现两批长得很像的药丸,读者会以为它们是同一种东西。
   *
   * `list-style: none` + `padding: 0` 自己去掉了项目符号:`ul` 在这里只是
   * "若干项"的结构,视觉上是一排链接,不是一份带点的清单。
   *
   * 窄屏交给 `flex-wrap` 自己折行 —— 全站**只有 760px 那一个断点**,
   * 这里不新增。
   */
  .more-list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 1.75rem;
    padding: 0;
    list-style: none;
  }

  .more-list__item {
    display: inline-block;
    padding: 4px 11px;
    border-radius: var(--radius-pill);
    color: var(--text-dim);
  }

  .more-list__item:hover {
    background: var(--bg-inset);
    color: var(--text);
    text-decoration: none;
  }
</style>
