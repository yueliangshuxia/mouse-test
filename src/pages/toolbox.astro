---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONFIDENCE_LABEL, NAV } from '../lib/tools';
import { TOOL_MOTIF } from '../lib/tool-motifs';
import { faqHtml, faqText } from '../lib/faq';
import { href } from '../lib/url';

/*
 * 工具箱 —— **全站第一个不是"一件测量工具"的页面**。
 *
 * 它是一扇门:报头里「工具箱」那一项指向这里,这里再把每一件小工具列出来。
 * 清单**从 `NAV.dropdown` 派生,不是手写七个 `<li>`** —— 手写的话,新加一件
 * 趣味工具只改 `tools.ts` 就会从这里静默消失,而报头那个下拉里却有,
 * 两边对不上还没人看得出来。(首页 `.more-list` 是同一条理由。)
 *
 * 它**不是 `Tool`**,理由写在 `tools.ts` 的 `TOOLBOX` 上面。这里只需要知道
 * 结论:它没有 `confidence`,因为注册表里那个字段是给"测量"用的。
 *
 * 页面自己的 `title` / `description` 写在这里,不进注册表 —— 注册表是**工具**
 * 的地方,而这一页不测任何东西。
 */

const FAQ = [
  {
    q: '这些工具的成绩会被上传吗?',
    a:
      '不会。这里每一件都在你的浏览器里跑,成绩只写进本机的 localStorage,关掉页面也还在,' +
      '但**没有任何一步会把数据发出去**。所以它们之间不能互相比较,和别人的成绩更不能比 ——' +
      '同一台机器上前后对比才有意义。',
  },
  {
    q: '为什么有的标着"不测量"?',
    a:
      '因为那几件确实一个数都不出。涂鸦板是画着玩的,坏点检测是让屏幕显示几片纯色、**要你亲眼看**,' +
      '刷新率目视测试是让你看方块动得顺不顺 —— 它们给你的是一件事**看起来**怎么样,不是量出来的数值。' +
      '另外几件测量出来的数也都标了口径(直接测得 / 估算),**能说的说到,不能说的不编**。',
  },
  {
    q: '用这些能判断鼠标好不好吗?',
    a:
      '能看出问题的能看出来,看不出来的不能反推。比如手稳度和瞄准都**只统计指针**,而指针已经被' +
      '操作系统的平滑与加速度处理过一遍了,所以成绩里混着系统和屏幕的账。要判断鼠标硬件本身,' +
      '请用上面那一排**诊断工具**——那边每一页都写清了自己的数可信到什么程度。',
  },
  {
    q: '手机上能用吗?',
    a:
      '坏的检测和刷新率那几件可以,靠触屏也能玩;但凡是"鼠标"两字的(手稳度、涂鸦板、瞄准)' +
      '在触屏上测的就不是同一件事了 —— 手指没有指针,也就没有指针的漂移。',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'CollectionPage',
      name: '鼠标趣味工具箱',
      description:
        '一批在浏览器里直接跑的鼠标与屏幕小工具:手稳度定靶、涂鸦板、灵敏度换算、屏幕坏点检测、刷新率目视测试,以及反应速度与瞄准。无需安装。',
      url: new URL(Astro.url.pathname, Astro.site).href,
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQ.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: faqText(item.a) },
      })),
    },
  ],
};
---

<BaseLayout
  title="鼠标趣味工具箱 - 手稳度、涂鸦板、坏点检测等在线小工具"
  description="一批在浏览器里直接跑的鼠标与屏幕小工具:手稳度定靶挑战、鼠标涂鸦板、灵敏度换算器、屏幕坏点检测、刷新率目视测试,以及反应速度与瞄准。无需安装,数据全部留在本机。"
  current={NAV.toolbox.slug}
  jsonLd={jsonLd}
>
  <h1>鼠标趣味工具箱</h1>

  {/*
    这里的 `**` 是**模板里的普通文字**,不是 frontmatter 里那种会被 `faqHtml`
    处理的字符串 —— 直接写 `**诊断**` 会原样印出星号(页面约定里那条踩过六次
    的坑)。所以模板里要用 `<strong>`。
  */}
  <p class="prose">
    上面那一排是<strong>诊断</strong> —— 测鼠标坏没坏,每一页都说清了自己的数可信到什么程度。
    这里是<strong>玩</strong>的:能测的照旧标出口径,不测的会直说它不测。
    所有成绩只存在这台机器的浏览器里,不联网、不上传。
  </p>

  <h2>玩一玩</h2>

  {/*
    一格一件。**预览一律常驻可见,不做悬停才出** —— 悬停才出现的东西在触屏上
    等于没有,而手机正是这些"随手玩一下"的工具最常被打开的地方。
    这也是它没有做成卡片装置的原因:报告里那条"清单 + 每件一小块预览"是用户
    定的,不是没来得及做成卡片。
  */}
  <ul class="box-list">
    {
      NAV.dropdown.map((tool) => (
        <li class="box-item">
          {/*
            预览窗。`aria-hidden` 是必须的:那段 SVG 说的是"这件工具长什么样",
            对读屏用户一个字的信息都没有,而它里面全是 `<path>`,
            不藏起来只会让读屏念出一串没人听得懂的东西。
          */}
          <div class="box-item__preview" aria-hidden="true">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={TOOL_MOTIF[tool.slug]}
            />
          </div>

          <div class="box-item__body">
            <div class="box-item__head">
              <a class="box-item__name" href={href(`${tool.slug}/`)}>
                {tool.name}
              </a>
              <span class={`confidence confidence--${tool.confidence}`}>
                {CONFIDENCE_LABEL[tool.confidence]}
              </span>
            </div>
            <p class="box-item__desc">{tool.description}</p>
          </div>
        </li>
      ))
    }
  </ul>

  <h2>常见问题</h2>

  <dl class="faq">
    {
      FAQ.map((item) => (
        <>
          <dt>{item.q}</dt>
          <dd set:html={faqHtml(item.a)} />
        </>
      ))
    }
  </dl>
</BaseLayout>

<style>
  /*
   * 清单。**一列、逐行**,不是网格 —— 每件都带一句话说明,两列会把行宽压到
   * 读不顺的长度(中文尤其)。行与行之间靠 1px 细线分开,和全站"结构全靠
   * 细线"同一套:没有卡片、没有阴影、没有底色。
   *
   * 窄屏不做任何改动:预览窗是固定 64px,正文再窄也有 290px 上下,
   * 从头到尾并排都读得下。**所以这一节不写媒体查询** —— 全站只有 760px
   * 那一个断点,不为了好看再添一个。
   */
  .box-list {
    margin: 0 0 1.75rem;
    padding: 0;
    list-style: none;
  }

  .box-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 16px 0;
    border-top: 1px solid var(--border);
  }

  .box-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  /*
   * 那块小窗。**它不住在 `.well` 里,这是有意的。**
   *
   * `.well` 是仪器窗 —— 它在全站只有一个含义:"这里正在出数",而且只在装置
   * 真的跑起来时出现。这一格是**静态清单里的一张图**,没有任何东西在出数;
   * 给它套上仪器窗,「扫一眼就知道哪里是活的」当场失效。
   *
   * **底色和边框都要,而且分工是量出来的。** 光有底色在深色下等于没画:
   * 实测 `--bg-inset` 是 `rgb(7,8,10)`、纸面是 `rgb(11,12,14)`,对比度
   * **1.02:1** —— 和 `.well` 那条已知的结论(近黑区间里两个平面靠填充分不开)
   * 是同一件事。所以边框不是装饰,它是深色下唯一说出"这里有一格"的东西;
   * 底色留着是因为它在浅色下确实有用(实测 1.14:1,也几乎看不见,
   * 但两档叠起来就够读出一格了)。
   *
   * 一个令牌都没新增:底色 `--bg-inset`、线 `--border`、图形 `currentColor`,
   * 两套主题自动都对。
   */
  .box-item__preview {
    flex: none;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--bg-inset);
    color: var(--text-dim);
  }

  .box-item__preview svg {
    width: 32px;
    height: 32px;
  }

  .box-item__body {
    min-width: 0;
  }

  .box-item__head {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 4px;
  }

  .box-item__name {
    font-weight: 600;
    color: var(--text);
  }

  .box-item__desc {
    margin: 0;
    /* 和 `.prose` 同一个行宽上限:一行读得顺,不要让说明横跨整页 */
    max-width: 42em;
    color: var(--text-dim);
    line-height: 1.6;
  }
</style>
