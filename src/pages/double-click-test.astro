---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatPanel from '../components/StatPanel.astro';
import { findTool } from '../lib/tools';
import { faqHtml, faqText } from '../lib/faq';
import { CLICK_CHATTER_MS, CLICK_DOUBLE_MAX_MS } from '../lib/analysis';

const tool = findTool('double-click-test')!;

/** 可选的目标按键。`code` 用的是 `MouseEvent.button` 的编号,不是 buttons 的位序。 */
const TARGETS = [
  { code: 0, name: '左键' },
  { code: 2, name: '右键' },
  { code: 1, name: '中键' },
];

const FAQ = [
  {
    q: '“连击”和“双击”有什么区别?',
    a:
      '双击是你有意按了两下,连击是鼠标自己多报了一下。判定靠时间:人手最快也要 60ms 以上才能完成一次按下、抬起、再按下,' +
      '所以间隔短于 ' + CLICK_CHATTER_MS + 'ms 的两次点击必定来自微动的触点抖动。本页把两者分开统计,' +
      '就是为了不让你每双击一次就看到一次“故障”。',
  },
  {
    q: '系统设置里的“双击速度”会影响这个判断吗?',
    a:
      '不会,那是两码事。系统里的双击速度是操作系统用来判断“这两下算不算一次双击操作”的阈值,默认 500ms,可以在控制面板里随便调;' +
      '而本页判断的是“这两下是不是同一个物理动作被记了两次”,阈值取的是人的机械极限。两者差着一个数量级,不会互相干扰。',
  },
  {
    q: '为什么要求点得慢一点?',
    a:
      '因为要给你自己的双击留出空间。如果你连着快速双击,产生的大量 50–500ms 间隔会把日志刷满,真正有问题的那一两次会被淹掉。' +
      '建议是:正常速度单击十几次,再故意快速双击几次,最后看日志里有没有夹着几毫秒的条目。',
  },
  {
    q: '反过来,快速双击没被记到是为什么?',
    a:
      '那是另一个方向的故障:固件的消抖时间设得太长,把真实的第二下也一起吞了。表现是想双击打开文件却没反应、或者拖动时中途掉。' +
      '检测方法是故意快速双击,看页面记到的是 2 次还是 1 次。有些鼠标的驱动里能调消抖时间。',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: tool.name,
      description: tool.description,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQ.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: faqText(item.a) },
      })),
    },
  ],
};
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  current={tool.slug}
  jsonLd={jsonLd}
>
  <h1>鼠标双击测试</h1>

  <p class="prose">
    在下面的区域里点击选中的那个键,页面会记录<strong>相邻两次按下之间隔了多少毫秒</strong>,
    并把它们分成三类:几毫秒的是微动触点抖动(俗称连击,是故障),
    几十到几百毫秒的是你自己在双击,更长的就是两次独立点击。
  </p>

  <div id="cap-notice"></div>

  <div class="controls">
    {
      TARGETS.map((target, index) => (
        <button type="button" class="target" data-code={target.code} aria-pressed={index === 0 ? 'true' : 'false'}>
          {target.name}
        </button>
      ))
    }
    <button type="button" id="reset">重置</button>
  </div>

  <div class="workbench">
    <div class="workbench__stage">
      <div class="test-area well" id="area">
        <div class="test-area__hint" id="hint">
          在这里点击,建议先正常速度单击十几次,再故意快速双击几次
        </div>
      </div>

      <h2>间隔记录</h2>
      <p class="prose tight">
        最近 20 次点击的间隔,新的在上面。<span class="mark-danger">红色</span>的那几条
        就是微动在抖——如果你并没有连续快速点击却出现了红色条目,那只鼠标的微动已经开始老化了。
      </p>
      <ul class="log-list" id="log"></ul>
    </div>

    <div class="workbench__readout">
      <div class="verdict">
        <div>
          <div class="verdict__label">最短间隔</div>
          <div>
            <span class="verdict__value" id="min-gap">—</span><span class="verdict__unit">ms</span>
          </div>
          <div class="verdict__note" id="verdict-note">
            在下面的区域里点击,至少点三次才能看出间隔
          </div>
        </div>
        <div class="verdict__aside">
          <span class="badge badge--idle" id="verdict-badge">等待测试</span>
        </div>
      </div>

      <div class="stat-grid">
        <StatPanel id="presses" label="点击次数" primary />
        <StatPanel id="chatter" label="疑似连击" hint={`间隔小于 ${CLICK_CHATTER_MS}ms`} />
        <StatPanel id="doubles" label="正常双击" hint={`${CLICK_CHATTER_MS}–${CLICK_DOUBLE_MAX_MS}ms`} />
        <StatPanel id="median" label="中位间隔" unit="ms" />
      </div>
    </div>
  </div>

  <section class="prose">
    <h2>怎么测才有意义</h2>
    <ol class="steps">
      <li>
        <strong>先正常速度单击十几次。</strong>间隔会落在几百毫秒以上,全都会被归到“独立点击”。
        这一步是给后面的快速点击做对照。
      </li>
      <li>
        <strong>再故意快速双击几次。</strong>你会看到日志里出现一批 60–200ms 的“双击”条目,
        这些是正常的,不是故障。
      </li>
      <li>
        <strong>最后看有没有夹着几毫秒的条目。</strong>那才是故障证据——
        你没有连点,它却报出了两次按下。一次就足以说明微动有问题,多按几次是为了确认不是偶发。
      </li>
    </ol>

    <h2>读数的边界在哪里</h2>
    <p>
      本页测的是<strong>按下到按下</strong>的间隔,单位毫秒,精度取决于浏览器给事件打的时间戳。
      未开启跨域隔离时这个精度被限制在 100µs,对毫秒级的判断完全够用——这里的数量级和回报率测试
      完全不同,那边要分辨的是 0.125ms,这边最细也只需要分辨到几毫秒。
    </p>
    <p>
      真正需要留意的是<strong>“没记到的点击”</strong>。本页只能统计收到的事件,报不出来的那一次
      它是看不见的——而固件消抖吞掉点击的表现正是“没记到”。想知道有没有发生这种事,去用
      CPS 测试页:那里你点的总数和记到的总数一对比就看出来了。
    </p>

    <h2>常见问题</h2>
    <div class="faq">
      {
        FAQ.map((item) => (
          <div class="faq__item">
            <div class="faq__q">{item.q}</div>
            <p class="faq__a" set:html={faqHtml(item.a)} />
          </div>
        ))
      }
    </div>
  </section>

  <style>
    #area {
      cursor: crosshair;
    }

    /*
     * 「间隔记录」搬进 `.workbench__stage` 之后,顶上还挂着 h2 自己的 `margin: 3.5rem`
     * ——它在 flex 列里**不会和 gap 合并**,两条叠起来就是 76px 的空档,
     * 会把刚搬上来的这块又推下去。
     * 只顶掉外边距:那条 1px 上边框和 padding 留着,正好把装置和这块记录隔开,
     * 装置是仪器窗、日志是纸面上的文字,那道线画在这儿是对的。
     * (长按拖拽页的同一条规则,两页说的是同一件事。)
     */
    .workbench__stage > h2 {
      margin-top: 0;
    }

    /*
     * 点击处的波纹。**这是全站唯一的动画** —— 全站的纪律是"不加非用户触发的
     * 动效",而这一条恰好相反:每一圈都由一次真实的按下触发,它报的是
     * "这一下被收到了",和读数栏里那个数字是同一条信息的两种形态。
     *
     * 必须写成 `:global(...)`:这些节点是 `<script>` 里 createElement 造的,
     * 而 Astro 的作用域化把 cid 加在**选择器**上、元素身上没有那个属性 ——
     * 规则一条都不命中,而且是静默的。和瞄准页的 `.aim-target` 同一个出口。
     */
    :global(.ripple) {
      /*
       * 直径由脚本按面板**短边**的比例给(见 `<script>` 的 `RIPPLE_RATIO`)。
       * 圆该跟短边走:同一份代码要伺候 1440 下的 646×380 和 420 下的 365×260,
       * 一个写死的直径不是在小面板上顶到上下两条边,就是在大面板上小得看不见。
       * 下面这个 200px 只是**兜底** —— 真正的值每次都从脚本写进来,两者要同值
       * (同 `renderer.ts` 那个 `--trail-color` 兜底常量)。
       */
      --ripple-size: 200px;
      position: absolute;
      width: var(--ripple-size);
      height: var(--ripple-size);
      /* 用负外边距把圆心对到 left/top 上,而不是 `transform: translate(-50%, -50%)`
         ——这样关键帧里就只剩一个纯 scale,不用把 translate 抄两遍。 */
      margin: calc(var(--ripple-size) / -2) 0 0 calc(var(--ripple-size) / -2);
      /* 井里 `--accent` 就是磷光绿,纸面那两个主题值在这里都用不上 */
      border: 2px solid var(--accent);
      border-radius: 50%;
      opacity: 0;
      /* 命中判定靠 `event.target === #area`,飘一层东西上去就变了 */
      pointer-events: none;
      /* 没有 animation-delay,所以不需要 `both` 去锁延迟期那一帧 —— `forwards`
         就够:动画一上来就跑,0% 那一帧(透明、缩到最小)本来就会立刻生效。 */
      animation: ripple-out 620ms ease-out forwards;
    }

    /*
     * 两个类写成 (0,2,0),刻意不靠源码顺序 —— 和 `.mouse-key__note--fault`
     * 同一条规矩。朱砂说的是"这一下结掉了一个疑似连击",和日志里那条红条目
     * 是同一个判据(`classifyClickGap`),不是两种说法。
     */
    :global(.ripple.ripple--fault) {
      border-color: var(--danger);
    }

    /*
     * 一次按下**一圈**,不是一列波。单圈就已经把"这一点被收到了"说完了,
     * 多圈只是同一条信息的重复,而且在这个以"快速连点"为主题的页面上,
     * 一次点击铺开三圈会密得看不清是哪一下。
     *
     * 描边**故意不加粗**:`transform: scale()` 会把边框一起缩放,所以这圈环是
     * 从细到粗长出来的。看着像缺点,其实是这一版要的:开头那点亚像素的线正好
     * 让环"浮"出来,而不是"啪"地出现一个圈。
     */
    @keyframes ripple-out {
      0% {
        transform: scale(0.12);
        opacity: 0;
      }
      /*
       * 峰值压在 15%、然后一路慢降到 60% —— **不是**"亮一下再淡出"。
       * 环的"看得见"是 `描边宽 × 不透明度`,而描边宽跟着 scale 走:开头那圈
       * 只有 0.4px 粗,那时就算给满不透明度也还是看不见。所以要它**在长到
       * 中途时最亮**,两头收 —— 峰值摆在开头等于把这份亮度浪费在一片亚像素上,
       * 朱砂尤其明显:半透明压在那个近黑的井底上会变成一坨发暗的褐色。
       */
      15% {
        opacity: 1;
      }
      60% {
        opacity: 0.7;
      }
      100% {
        transform: scale(1);
        opacity: 0;
      }
    }
  </style>

  <script>
    import {
      CLICK_CHATTER_MS,
      classifyClickGap,
      summarizeClickGaps,
      type ClickGapKind,
    } from '../lib/analysis';
    import {
      el,
      mountCapabilityNotices,
      setBadge,
      setStat,
      setText,
      suppressWorkbenchDefaults,
    } from '../lib/ui';

    mountCapabilityNotices(el('cap-notice'));

    // 右键菜单会盖住日志,而这个页面本来就要测右键。
    // **必须整页拦,不能只挂在测试区上**:按着右键拖出区域是常事,拖出去那一刻
    // 菜单照弹。链接和按钮除外,那里右键是正常操作。
    suppressWorkbenchDefaults();

    /** 日志里最多保留这么多条,再多就没人看了 */
    const LOG_LIMIT = 20;

    const area = el('area');
    const hint = el('hint');
    const logHost = el('log');

    /** `code` 用 `MouseEvent.button` 的编号:0=左键 1=中键 2=右键 */
    let targetCode = 0;

    /** 每个键各自的按下时刻,分开记 —— 左右键交错按不该互相产生间隔 */
    const pressTimes = new Map<number, number[]>();

    function timesFor(code: number): number[] {
      let list = pressTimes.get(code);
      if (!list) {
        list = [];
        pressTimes.set(code, list);
      }
      return list;
    }

    const KIND_LABEL: Record<ClickGapKind, string> = {
      chatter: '疑似连击',
      double: '双击',
      separate: '独立点击',
    };

    const KIND_CLASS: Record<ClickGapKind, string> = {
      chatter: 'log-item log-item--alert',
      double: 'log-item log-item--warn',
      separate: 'log-item',
    };

    // ---- 点击处的波纹 ----

    /**
     * 同时活着的波纹上限。一次按下只有一个节点,而这一页要测的故障恰恰是
     * "一秒钟点二十下" —— 那正是波纹叠得最快的时候,不能让它把 DOM 撑爆。
     * 二十连击 × 0.62s 的寿命 ≈ 13,取 24 留一倍余量(坏鼠标报出上百 CPS 也兜得住)。
     */
    const RIPPLE_LIMIT = 24;

    /**
     * 波纹的直径 = 面板**短边**的这个比例。1440 下约 209px、420 下约 143px
     * (面板 646×380 / 365×260,两个数都是量出来的)。
     *
     * 挂短边而不是写死像素,是因为面板的**高度**在窄档会从 380 掉到 260 ——
     * 写死 200px 在 420 下会顶到上下两条边。CSS 里那份 200px 只是兜底。
     */
    const RIPPLE_RATIO = 0.55;

    /**
     * 在指针处放一圈波纹。`fault` 为真时是朱砂色。
     *
     * 每一下现读一次 rect,不缓存:用户中途滚动会让缓存的矩形失效 ——
     * 和瞄准页"一枪读一次"是同一条理由。`clientLeft` / `clientTop` 是边框宽,
     * 而绝对定位的包含块是**内边距盒**,不减掉这 1px,波纹就整体偏一格。
     */
    function spawnRipple(clientX: number, clientY: number, fault: boolean): void {
      if (!area) return;
      const box = area.getBoundingClientRect();

      const ring = document.createElement('span');
      ring.className = fault ? 'ripple ripple--fault' : 'ripple';
      ring.setAttribute('aria-hidden', 'true');
      ring.style.left = `${clientX - box.left - area.clientLeft}px`;
      ring.style.top = `${clientY - box.top - area.clientTop}px`;
      ring.style.setProperty(
        '--ripple-size',
        `${Math.round(Math.min(box.width, box.height) * RIPPLE_RATIO)}px`,
      );
      // 自清:环走完自己摘掉,不靠计时器也不靠下一次点击去扫。
      // **注意 `prefers-reduced-motion` 下它会被全站那条夹子压成 0.01ms,
      // 于是立刻结束、立刻被摘掉 —— 波纹就等于没有。这是那个设置该有的样子,
      // 不是漏做:波纹是装饰,真正的反馈是日志和计数,它们一条都不会少。**
      ring.addEventListener('animationend', () => ring.remove());
      area.appendChild(ring);

      const live = area.querySelectorAll('.ripple');
      for (let i = 0; i < live.length - RIPPLE_LIMIT; i++) live[i].remove();
    }

    /** 当前目标键的间隔序列 */
    function currentGaps(): number[] {
      const times = timesFor(targetCode);
      const gaps: number[] = [];
      for (let i = 1; i < times.length; i++) gaps.push(times[i] - times[i - 1]);
      return gaps;
    }

    function render(): void {
      const times = timesFor(targetCode);
      const gaps = currentGaps();
      const stats = summarizeClickGaps(gaps);

      setText(el('min-gap'), stats.minMs === null ? '—' : stats.minMs.toFixed(0));
      setStat('presses', String(times.length));
      setStat('chatter', String(stats.chatter));
      setStat('doubles', String(stats.double));
      setStat('median', stats.medianMs === null ? '—' : stats.medianMs.toFixed(0));

      // ---- 结论 ----
      if (times.length < 3) {
        setBadge(el('verdict-badge'), '等待测试', 'idle');
        setText(el('verdict-note'), '在下面的区域里点击,至少点三次才能看出间隔');
      } else if (stats.chatter > 0) {
        setBadge(el('verdict-badge'), '疑似微动连击', 'poor');
        setText(
          el('verdict-note'),
          `出现了 ${stats.chatter} 次 ${CLICK_CHATTER_MS}ms 以内的间隔,最短 ${stats.worstChatterMs?.toFixed(0)}ms —— ` +
            '如果没有连点却报出这些,微动已经在抖了',
        );
      } else {
        setBadge(el('verdict-badge'), '未发现连击', 'good');
        setText(
          el('verdict-note'),
          `共 ${times.length} 次点击,最短间隔 ${stats.minMs?.toFixed(0)}ms,都在人能做到的范围内`,
        );
      }

      // ---- 日志 ----
      if (!logHost) return;
      if (gaps.length === 0) {
        const empty = document.createElement('li');
        empty.className = 'log-empty';
        empty.textContent = '还没有间隔数据';
        logHost.replaceChildren(empty);
        return;
      }

      // 新的在上面:最近的间隔才是用户此刻在看的
      const shown = gaps.slice(Math.max(0, gaps.length - LOG_LIMIT)).reverse();
      const fragment = document.createDocumentFragment();
      for (let i = 0; i < shown.length; i++) {
        const gap = shown[i];
        const kind = classifyClickGap(gap);
        const item = document.createElement('li');
        item.className = KIND_CLASS[kind];

        const index = document.createElement('span');
        index.className = 'log-item__index';
        index.textContent = `#${gaps.length - i}`;

        const value = document.createElement('span');
        value.className = 'log-item__value';
        value.textContent = `${gap.toFixed(1)} ms`;

        const note = document.createElement('span');
        note.className = 'log-item__note';
        note.textContent = KIND_LABEL[kind];

        item.append(index, value, note);
        fragment.appendChild(item);
      }
      logHost.replaceChildren(fragment);
    }

    // ---- 交互 ----

    area?.addEventListener('pointerdown', (event) => {
      if (event.button !== targetCode) return;
      event.preventDefault();
      hint?.setAttribute('hidden', '');
      // 记的是**两次点击之间的间隔**,所以必须取 `event.timeStamp` 而不是
      // 处理函数里的 `performance.now()`。
      //
      // 浏览器会把攒在一起的事件放进同一个任务里派发,此时两个处理函数是在
      // 同一瞬间跑的,`performance.now()` 的差会塌到 0——一次完全正常的人手
      // 双击会被算成 0 毫秒,直接报成"连击"。这是本站最不该出的错:把一个
      // 假数字当成故障结论。`event.timeStamp` 是事件自己带的时刻,不吃这份
      // 派发延迟(剩下的批处理涂抹在 0.6ms 量级,对 50ms 的门槛可以忽略)。
      const times = timesFor(targetCode);
      const previous = times.length > 0 ? times[times.length - 1] : null;
      times.push(event.timeStamp);

      // 波纹的成色跟着**这一下结出来的间隔**走,和日志里那条的颜色是同一个
      // 判据、同一个纯函数。第一下没有"之间",所以永远是绿的。
      const gap = previous === null ? null : event.timeStamp - previous;
      spawnRipple(
        event.clientX,
        event.clientY,
        gap !== null && classifyClickGap(gap) === 'chatter',
      );

      render();
    });


    for (const button of document.querySelectorAll<HTMLElement>('.target')) {
      button.addEventListener('click', () => {
        targetCode = Number(button.dataset.code);
        for (const other of document.querySelectorAll<HTMLElement>('.target')) {
          other.setAttribute(
            'aria-pressed',
            other === button ? 'true' : 'false',
          );
        }
        render();
      });
    }

    el('reset')?.addEventListener('click', () => {
      pressTimes.clear();
      hint?.removeAttribute('hidden');
      // **故意不在这里摘波纹。** 它不是读数,是一次按下的回执:半路被摘掉会
      // 当场"啪"地消失。剩下的半圈说的事情(刚才那一下真的收到了)也并没有
      // 因为重置而变成假的,让它自己走完,不到一秒。
      render();
    });

    render();
  </script>
</BaseLayout>
