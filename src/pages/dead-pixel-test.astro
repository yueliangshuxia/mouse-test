---
import BaseLayout from '../layouts/BaseLayout.astro';
import { findTool } from '../lib/tools';
import { faqHtml, faqText } from '../lib/faq';

const tool = findTool('dead-pixel-test')!;

/*
 * 那几片纯色。
 *
 * **它们是硬写的十六进制,刻意不走任何设计令牌。**理由不是"懒得接主题",
 * 而是这一页的整个前提:**"黑"必须是 #000000,不是主题里的近黑**;白屏要能
 * 照出亮点,拿主题的 `--bg` 去铺等于什么都没测。这是全站唯一一处允许出现
 * 任意颜色的地方,理由和仪器窗同源 —— 它是**内容**,不是纸面寄存器。
 * 换色值之前先读下面那段 `global.css` 的注释。
 *
 * 顺序也有讲究:先黑白(最容易看出亮点和暗斑),再 RGB(看单个子像素)。
 */
const PATCHES = [
  { id: 'black', label: '黑', hex: '#000000' },
  { id: 'white', label: '白', hex: '#ffffff' },
  { id: 'red', label: '红', hex: '#ff0000' },
  { id: 'green', label: '绿', hex: '#00ff00' },
  { id: 'blue', label: '蓝', hex: '#0000ff' },
];

const FAQ = [
  {
    q: '这一页会告诉我哪里有坏点吗?',
    a:
      '不会。**它一个读数都不出,也不做任何判断。**页面能做的只有一件事:把屏幕铺成一片精确的纯色。' +
      '坏点是**你看着**屏幕找出来的——盯着一个区域,在几种颜色之间来回切,' +
      '那个一直不跟着变的点就是坏点。把这件事交给程序是做不到的:' +
      '网页读不到屏幕的像素,截图 API 拿到的也往往是另一份被处理过的画面。',
  },
  {
    q: '为什么要切好几种颜色?黑屏和白屏看不出区别吗?',
    a:
      '看不出。坏点分两种:**常亮点**在黑屏上最显眼(它亮着,周围是黑的),' +
      '**常暗点**在白屏上最显眼(它黑着,周围是白的)。而一个"子像素坏了"的点' +
      '(比如红绿都正常、只有蓝不亮)在黑白屏上都看不出来,只有铺纯红或纯蓝时才现形。' +
      '所以红绿蓝三色不是凑数,它们各管一个子像素。',
  },
  {
    q: '"暗斑""漏光"这类问题能测吗?',
    a:
      '能看,但和坏点不是一回事,而且**这一页同样不下结论**。把屏幕铺成纯黑,在**暗房**里看:' +
      '四角发灰是背光不均或漏光,一整片不均匀是亮度均匀性问题。这些都需要你把房间弄暗、' +
      '从正面而不是斜着看,否则看到的其实是环境光在屏幕上的反射。**看清了是什么,才知道该不该送修。**',
  },
  {
    q: '手机上没有全屏按钮?',
    a:
      'iOS 的 Safari 对非视频元素不支持全屏,这是浏览器的限制,页面绕不过去。' +
      '**没有全屏也照样能用**:直接点那几个颜色按钮,色块会铺满页面里那块区域,' +
      '把手机转过来、凑近看就行 —— 只是没法盖住浏览器的地址栏。' +
      '安卓上的 Chrome 一般可以全屏。',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: tool.name,
      description: tool.description,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQ.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: faqText(item.a) },
      })),
    },
  ],
};
---

<BaseLayout
  title={tool.title}
  description={tool.description}
  current={tool.slug}
  jsonLd={jsonLd}
>
  <h1>屏幕坏点检测</h1>

  <p class="prose">
    把屏幕依次铺成黑、白、红、绿、蓝五种<strong>纯色</strong>,你盯着看就行。
    <strong>这一页不判断任何东西</strong>——坏点是你看出来的,不是它算出来的。
    它在做的是给你一块干净、准确、没有环境光干扰的底板。
  </p>

  <div class="controls">
    {
      PATCHES.map((patch, index) => (
        <button
          type="button"
          class="patch"
          data-patch={patch.id}
          data-hex={patch.hex}
          data-label={patch.label}
          aria-pressed={index === 0 ? 'true' : 'false'}
        >
          {patch.label}
        </button>
      ))
    }
    <button type="button" id="full">全屏检测</button>
    <span class="test-hint" id="hint">点颜色切换;全屏之后单击或按空格换下一个</span>
  </div>

  <div class="pixel-frame">
    <div class="pixel-field" id="field" data-patch="black" role="img" aria-label="纯色检测板">
      <div class="pixel-field__hint" id="hint-full" hidden>
        单击或按空格换下一个颜色 · 按 Esc 退出全屏
      </div>
    </div>
  </div>

  <p class="prose" id="readout" data-readout="dead-pixel">
    当前:黑。把房间弄暗,盯着屏幕的每一个角落各看几秒,再换下一个颜色。
  </p>

  <section class="prose">
    <h2>怎么找</h2>
    <ol class="steps">
      <li>
        <strong>把屏幕擦干净。</strong>灰尘和指纹在黑屏上比坏点显眼得多,
        而它们一擦就掉——先擦一次能省掉大半的虚惊。
      </li>
      <li>
        <strong>把房间弄暗。</strong>反光会让你把环境光当成屏幕的问题。
        尤其是"暗斑"和"漏光",不在暗处根本分不出来。
      </li>
      <li>
        <strong>点「全屏检测」,然后固定盯一个区域。</strong>
        在几种颜色之间切换时<strong>不要移开视线</strong>——坏点的判据是
        "这个点在所有颜色下都不跟着变",换色的时候跟着眼睛跑就找不到了。
      </li>
      <li>
        <strong>黑屏找亮点,白屏找暗点,红绿蓝找单色子像素。</strong>
        一块屏幕通常有上百万个像素,逐个数不现实——地毯式扫几遍就够了,
        真有问题的地方会自己跳出来。
      </li>
    </ol>

    <h2>找到之后</h2>
    <p>
      先分清是哪一种,因为处理方式完全不同:<strong>亮点和暗点</strong>是像素自己坏了,
      保修期内一般可以按"坏点数超过标准"申请售后(各厂商的标准不一样,有的是 3 个,
      有的更多)。<strong>暗斑、漏光、亮度不均</strong>则是背光或整块面板的问题,
      按坏点数算往往不达标,但通常更容易被认定为质量问题。
      <strong>记住你看到的是哪一种、在什么颜色下看到</strong>,送修的时候说得清楚得多。
    </p>
    <p>
      需要说明的是:屏幕上偶尔会有<strong>卡住的像素</strong>——它不是坏,是被信号
      卡在了某个状态上,有时过一段时间自己会恢复,也可能靠专门的"像素修复"闪烁
      恢复。这一页不做这个:那类工具的效果本身争议很大,而它有癫痫风险,
      不该由我们随便替人决定要不要看。
    </p>

    <h2>常见问题</h2>
    <div class="faq">
      {
        FAQ.map((item) => (
          <div class="faq__item">
            <div class="faq__q">{item.q}</div>
            <p class="faq__a" set:html={faqHtml(item.a)} />
          </div>
        ))
      }
    </div>
  </section>

  <style>
    /*
     * 检测板。**这一块是全站唯一允许出现任意颜色的地方**,和仪器窗是同一种
     * 例外:它是**内容**,不是纸面寄存器。纸面的"无彩色"纪律说的是
     * "不要给界面元素加色相",而这里铺的是一片被测的色场 ——
     * 把它染成主题色就等于什么都没测。
     *
     * **别照着「纸面无色相」把那几个色值改掉**,也别把它们换成设计令牌:
     * "黑"必须是 #000000,主题里的近黑照不出亮点。
     *
     * 它**不套 `.test-area`**:那一层自带虚线框和刻度栅格背景,
     * 而这一页要的正是一块干净、无纹理、边界明确的底板。
     */
    .pixel-field {
      position: relative;
      height: 340px;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      background: #000000;
      cursor: pointer;
    }

    /*
     * 全屏时:去掉框和圆角,铺满整屏,并且**藏起光标** ——
     * 找坏点的时候鼠标箭头压在色场上正好像一个有问题的像素。
     */
    .pixel-field:fullscreen {
      height: 100%;
      border: 0;
      border-radius: 0;
      cursor: none;
    }

    /*
     * 全屏里那条提示。它盖在色场上,所以只在刚进全屏时露一下 ——
     * 找坏点需要一块没有遮挡的色场,长期挂一条说明是在帮倒忙。
     * 用 `opacity` 淡出而不是撤掉节点:撤掉会让屏幕在那一瞬间跳一下。
     */
    .pixel-field__hint {
      position: absolute;
      left: 50%;
      bottom: 24px;
      transform: translateX(-50%);
      padding: 6px 14px;
      border-radius: var(--radius-pill);
      background: rgba(0, 0, 0, 0.62);
      color: #ffffff;
      font-size: 0.85rem;
      white-space: nowrap;
      opacity: 1;
      transition: opacity 0.4s ease;
      pointer-events: none;
    }

    .pixel-field__hint[hidden] {
      display: none;
    }

    .pixel-field__hint[data-faded='true'] {
      opacity: 0;
    }

    @media (max-width: 760px) {
      .pixel-field {
        height: 240px;
      }
    }
  </style>

  <script>
    import { el, setText } from '../lib/ui';

    /*
     * 这一页**既不调 `suppressWorkbenchDefaults()` 也不做能力告警**,两条都有理由。
     *
     * 拦截的判据是"这一页的读数会不会被指针的默认行为污染"。这一页没有读数:
     * 找坏点是你看,不是它算。指针在这里只做一件事 —— 点一下换下一个颜色,
     * 而右键菜单并不会打断这件事。为它拦住整页的右键,代价是读者连"复制"
     * 都没了,换来的是一点用都没有的"干净"(`keyboard-test` 不调它同理)。
     *
     * 能力告警同理:全屏能不能用是这一页唯一的环境依赖,而它有**自己的出路**
     * —— 不支持就退回页面内的色块,照旧能看。所以这里用 `document.fullscreenEnabled`
     * 就地判断并说明,而不是印一串和这一页无关的精度警告。
     */
    const field = el('field');
    const hintFull = el('hint-full');

    if (!field) throw new Error('检测板未就绪');

    /** 色块表。**从 DOM 读回来**,不在脚本里抄第二份 —— frontmatter 变量在 `<script>` 里不存在 */
    const patches = Array.from(document.querySelectorAll<HTMLElement>('.patch')).map((button) => ({
      hex: button.dataset.hex ?? '#000000',
      label: button.dataset.label ?? '',
      id: button.dataset.patch ?? '',
      node: button,
    }));

    let current = 0;

    function render(): void {
      const patch = patches[current];
      if (!patch) return;

      // 只改 `background-color` 这一个 longhand,不写 `background` 简写
      field!.style.backgroundColor = patch.hex;
      field!.setAttribute('data-patch', patch.id);
      for (const item of patches) {
        item.node.setAttribute('aria-pressed', String(item.id === patch.id));
      }
      setText(
        el('readout'),
        `当前:${patch.label}。把房间弄暗,盯着屏幕的每一个角落各看几秒,再换下一个颜色。`,
      );
    }

    function go(step: number): void {
      current = (current + step + patches.length) % patches.length;
      render();
    }

    for (const item of patches) {
      item.node.addEventListener('click', () => {
        current = patches.findIndex((candidate) => candidate.id === item.id);
        render();
      });
    }

    // ---- 全屏 ----

    const fullButton = el('full') as HTMLButtonElement | null;

    /*
     * `document.fullscreenEnabled` 为 false 时(iOS Safari)、或者请求被拒时,
     * **如实说一句并让用户继续用页面内的色块**,不假装全屏成功了。
     */
    const canFullscreen = Boolean(document.fullscreenEnabled);
    if (!canFullscreen && fullButton) {
      fullButton.disabled = true;
      fullButton.textContent = '全屏(此浏览器不支持)';
    }

    /** 淡出计时器。每次重进全屏都要清掉上一次的,否则新提示会被旧的到点收走 */
    let fadeTimer = 0;

    function showFullscreenHint(): void {
      window.clearTimeout(fadeTimer);
      hintFull?.removeAttribute('data-faded');
      hintFull?.removeAttribute('hidden');
      fadeTimer = window.setTimeout(() => {
        hintFull?.setAttribute('data-faded', 'true');
      }, 3000);
    }

    function hideFullscreenHint(): void {
      window.clearTimeout(fadeTimer);
      hintFull?.setAttribute('hidden', '');
      hintFull?.removeAttribute('data-faded');
    }

    fullButton?.addEventListener('click', () => {
      field.requestFullscreen?.().catch(() => {
        setText(el('hint'), '浏览器拒绝了全屏请求。页面内的色块照样能用 —— 凑近看就行。');
      });
    });

    // 单击换下一个。**只在全屏里管用** —— 页面里的单击留给下面那排按钮,
    // 否则点一下色块就会跳色,和按钮的选中态对不上
    field.addEventListener('click', () => {
      if (document.fullscreenElement === field) go(1);
    });

    document.addEventListener('fullscreenchange', () => {
      const active = document.fullscreenElement === field;
      if (active) {
        showFullscreenHint();
        setText(el('hint'), '单击或按空格换下一个颜色,按 Esc 退出');
      } else {
        hideFullscreenHint();
        setText(el('hint'), '点颜色切换;全屏之后单击或按空格换下一个');
      }
    });

    /*
     * 键盘。只在全屏里接管:不在全屏时把空格和方向键还给浏览器
     * (空格是翻页,抢过来是纯粹的骚扰)。
     */
    document.addEventListener('keydown', (event) => {
      if (document.fullscreenElement !== field) return;
      if (event.key === ' ' || event.key === 'ArrowRight' || event.key === 'ArrowDown') {
        event.preventDefault();
        go(1);
      } else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') {
        event.preventDefault();
        go(-1);
      }
    });

    render();
  </script>
</BaseLayout>
