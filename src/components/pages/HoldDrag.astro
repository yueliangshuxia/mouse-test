---
/*
 * 长按拖拽测试页的**主体**。两个薄路由引它:中文的 `/hold-drag-test/`
 * 和英文的 `/en/hold-drag-test/`。
 *
 * ## 为什么页面要拆成"组件 + 两个薄路由"
 *
 * Astro 的页面文件不能被另一个页面 import,所以"同一页渲染两种语言"只有这一条路:
 * 主体搬进组件、收一个 `locale`,路由文件各三行。**别把它再抄回页面里** ——
 * 一份两处,迟早一处改了另一处没改。
 *
 * ## 三处这一页特有的
 *
 * - **五个按键名来自共用目录的 `buttons` 命名空间**(`buttonCopy(code, locale)`),
 *   不是 `mouse-buttons.ts` 那一份 —— 那张表按键页和拖拽页共用,名字的本地化是
 *   **中央的一件事**。`BUTTONS` 这里只贡献编号和顺序(见下面 `BUTTON_ROWS`)。
 *   全页有**七处**要它:表格里那一列、空态那个 `live-button` 占位,以及脚本里
 *   五条带 `{name}` 的句子(逐条见 `pages/holdDrag.ts` 的文件头)。
 * - **`logLede` 里那个 `{mark}` 是颜色,不是强调。** 它和下面日志里变红的那几条
 *   是同一个记号,而 `faqHtml()` 只认 `**`、给不出颜色,所以那个 span 在模板里
 *   填回去(形状同 `Polling.astro` 的 `chartLedeWarn`)。
 * - **正文里嵌着两个构建期常量**(`{window}` / `{radius}`),正文、FAQ 和
 *   结构化数据三处都要填,只算一遍(`placeholders`)。
 *
 * **这一页一条站内链接都没有** —— 所以没有 `pageHref()` 的调用点,
 * 脚本里也就没有那个 import(不留死引用)。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatPanel from '../../components/StatPanel.astro';
import { faqHtml, faqText } from '../../lib/faq';
import { REPRESS_RADIUS_PX, REPRESS_WINDOW_MS } from '../../lib/analysis';
import { BUTTONS } from '../../lib/mouse-buttons';
import { TOOL_MOTIF } from '../../lib/tool-motifs';
import { TOOL_HUE } from '../../lib/tool-hues';
import { DEFAULT_LOCALE, buttonCopy, fill, getCatalog } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getCatalog(locale).pages.holdDrag;

/*
 * 逐键明细表的五行。编号和顺序从 `BUTTONS` 来(那是结构),名字从目录的
 * `buttons` 命名空间来 —— 同一个编号在别的页面上也叫这个名字,抄一份进来
 * 只会多出一份要对齐的清单。
 */
const BUTTON_ROWS = BUTTONS.map((button) => ({
  code: button.code,
  ...buttonCopy(button.code, locale),
}));

/*
 * 空态那个 `live-button` 里写的字。它只是**首屏的占位**,第一次按下就被
 * `setText(el('live-button'), …)` 换成真正按着的那个键,所以这里填**键 0** 的名字。
 */
const LIVE_PLACEHOLDER = buttonCopy(0, locale).name;

/**
 * 两个构建期常量,在正文、FAQ 和结构化数据里各要填一遍。
 * 只算一遍:三处各写一次的话,加一条带占位符的句子时迟早漏掉一处,
 * 而漏掉的样子是屏幕上原样印着 `{window}`。
 */
const placeholders = { window: REPRESS_WINDOW_MS, radius: REPRESS_RADIUS_PX };

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: t.h1,
      description: t.metaDescription,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: faqText(fill(item.a, placeholders)) },
      })),
    },
  ],
};
---

<BaseLayout
  title={t.metaTitle}
  description={t.metaDescription}
  current="hold-drag-test"
  jsonLd={jsonLd}
  hue={TOOL_HUE['hold-drag-test']}
  locale={locale}
>
  <div class="tool-head">
    <span class="tool-head__icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={TOOL_MOTIF['hold-drag-test']}
      />
    </span>
    <h1>{t.h1}</h1>
  </div>

  <p class="prose" set:html={faqHtml(t.lede)} />

  <div id="cap-notice"></div>

  <div class="workbench">
    <div class="workbench__stage">
      <div class="test-area well drag-pad" id="area" data-holding="false">
        <div class="test-area__hint" id="hint">{t.hint}</div>
        <div class="drag-live" id="live" hidden>
          <div class="drag-live__value" id="live-hold">0</div>
          <div class="drag-live__label">
            <span id="live-button">{LIVE_PLACEHOLDER}</span> 按住中 · 已拖动 <span id="live-distance">0</span> px
          </div>
        </div>
        <div class="drag-dot" id="dot" hidden></div>
      </div>

      {/*
        **「重置」从工作台下面搬到了这里**(用户 2026-10-14:「重置按钮上面还有空间」)。
        它原来横在两列底下,于是左列(测试区)底边到它之间空出 135px —— 因为右列
        比左列高一截,那截空全落在左边。

        搬法照 `scroll-test` / `keyboard-test` 的先例:**重置换到装置正下方**,
        不用往下滚一屏才够得到,顺带把那段空占掉。
      */}
      <div class="controls">
        <button type="button" id="reset">{t.reset}</button>
        <span class="test-hint" id="hint2">
          {t.hintTracking}
        </span>
      </div>
    </div>

    <div class="workbench__readout">
      <div class="verdict">
        <div>
          <div class="verdict__label">{t.verdictLabel}</div>
          <div>
            <span class="verdict__value" id="drops-total">0</span><span class="verdict__unit">{t.verdictUnit}</span>
          </div>
          <div class="verdict__note" id="verdict-note">
            {t.verdictNoteIdle}
          </div>
        </div>
        <div class="verdict__aside">
          <span class="badge badge--idle" id="state-badge">{t.badges.idle}</span>
        </div>
      </div>

      <div class="stat-grid">
        <StatPanel id="sessions" label={t.stats.sessions.label} primary hint={t.stats.sessions.hint} />
        <StatPanel id="longest" label={t.stats.longest.label} unit={t.stats.longest.unit} hint={t.stats.longest.hint} />
        <StatPanel id="distance" label={t.stats.distance.label} unit={t.stats.distance.unit} hint={t.stats.distance.hint} />
        <StatPanel id="open" label={t.stats.open.label} hint={t.stats.open.hint} />
      </div>
    </div>
  </div>

  {/*
    **这张表从工作台的左列挪到了这里**(用户 2026-10-14 拿截图报的「上面也有点太空了」)。

    它原来住在 `.workbench__stage` 里面,于是工作台变成"左列 712px、右列 398px"
    —— **右列下面空出 314px**,而表格自己也只拿到左列那 646px。挪出来之后它
    通栏(1060),右列那 314px 的空带也没有了。

    **判据不是"表格要宽",是"它和工作台不是同一条基线上的东西"**:工作台那一行
    的左右两列是"装置 / 读数",而这是一整节的明细表,该和下面「每次拖拽的记录」
    并排站,而不是被塞进装置那一列。
  */}
  {/*
    **这两节并成一排**(用户 2026-10-14:「这两个可以改紧凑一点,弄成一排」)。

    它们原来各自通栏 1060,而内容都不满 —— 那张表只有四列,日志每行也只有
    「编号 / 时长 / 键 / 位移」四段,通栏之后右边空一大片。并排之后两边都收紧,
    整页也短了。

    `auto-fit` + `minmax(340px, 1fr)`:够宽两列、窄了自己堆成一列 ——
    **不新增断点**(全站只有 760px 那一个),和 `.mini-grid` 同一个算法。
  */}
  <div class="split">
    <div class="split__col">
      <h2 class="minor">{t.byButtonHeading}</h2>
  <p class="prose tight" set:html={faqHtml(t.byButtonLede)} />
  <table class="ref-table by-button">
    <thead>
      <tr>
        <th>{t.byButtonColumns.button}</th>
        <th>{t.byButtonColumns.sessions}</th>
        <th>{t.byButtonColumns.drops}</th>
        <th>{t.byButtonColumns.longest}</th>
      </tr>
    </thead>
    <tbody>
      {
        BUTTON_ROWS.map((button) => (
          <tr id={`btn-row-${button.code}`} data-current="false">
            <td>{button.name}</td>
            <td id={`btn-count-${button.code}`}>{t.runtime.dash}</td>
            <td id={`btn-drops-${button.code}`}>{t.runtime.dash}</td>
            <td id={`btn-longest-${button.code}`}>{t.runtime.dash}</td>
          </tr>
        ))
      }
    </tbody>
  </table>

    </div>

    <div class="split__col">
      <h2 class="minor">{t.logHeading}</h2>
  {/*
    `{mark}` 是那一处**红色**,不是强调 —— 它和下面日志里变红的那几条是同一个
    记号,而 `faqHtml()` 只认 `**`、给不出颜色。所以句子在 `{mark}` 处留一个洞,
    这里把节点嵌回去(形状同 `Polling.astro` 的 `chartLedeWarn`)。
  */}
  <p
    class="prose tight"
    set:html={fill(faqHtml(t.logLede), {
      mark: `<span class="mark-danger">${t.logLedeMark}</span>`,
    })}
  />
      <ul class="log-list" id="log"></ul>
    </div>
  </div>

  <section class="prose prose--cards">
    <h2>{t.limitsHeading}</h2>

    {/*
      这一段原来**是四个 `<p>`**,每段里都已经有一个加粗的"点",只是那个点埋在
      句子中间(「要诚实说明的是:**…**」)。也就是说它不是散文,是**写成散文的
      四条限制** —— 所以改成清单,让那四点变成卡片。
      **句子原文一个字没改**,只把每段那个加粗的点提到开头,并把段与段之间的
      连接词(「所以」「还有一类是」「第三种是」)收进句子里 —— 它们本来就是在
      承接上一段,排成并列的四条之后那个承接就不成立了。
    */}
    <ul>
      {t.limitsPoints.map((point) => <li set:html={faqHtml(fill(point, placeholders))} />)}
    </ul>

    <h2>{t.relationHeading}</h2>
    <p set:html={faqHtml(t.relationBody)} />

    <h2>{t.faqHeading}</h2>
    <div class="faq">
      {
        t.faq.map((item) => (
          <div class="faq__item">
            <div class="faq__q">{item.q}</div>
            <p class="faq__a" set:html={faqHtml(fill(item.a, placeholders))} />
          </div>
        ))
      }
    </div>
  </section>

  <style>
    .drag-pad {
      cursor: grab;
      height: 300px;
    }

    .drag-pad[data-holding='true'] {
      cursor: grabbing;
      border-color: var(--accent);
    }

    /*
     * 跟着指针走的那颗圆点 —— 按住期间才有,用来把"正在跟踪"这件事画出来。
     *
     * 三条都不是随手写的:
     *
     * 1. **`position: fixed`**,不是 absolute。`.test-area` 是 `overflow: hidden`,
     *    而这一页明说了"指针拖出区域外也会继续跟踪" —— 圆点要是在区域里绝对定位,
     *    指针一离开就被裁掉,恰好在你最需要它证明"还在跟"的时候消失。
     *    (定宽定位让这里不需要任何 getBoundingClientRect,也就没有缓存失效那类 bug。)
     * 2. **负外边距居中**,不是 `translate(-50%, -50%)` —— 偏移量要留给下面那句
     *    由脚本写的 `translate3d(x, y, 0)`,一条 transform 里混两种语义读起来会打架。
     *    代价是"尺寸的一半"和"偏移"必须一起改,所以尺寸抽成了 `--drag-dot-size`,
     *    由 `calc()` 除法推出来 —— 只改尺寸忘了改偏移的话,圆点会**偏出指针半颗**,
     *    看着"差不多在附近",但那是错的,而且并不报错。
     * 3. **颜色走 `--accent`**:它长在 `.well` 里面,拿到的就是井里的磷光绿。
     *    自定义属性按 DOM 树继承,和 containing block 无关,fixed 不会让它掉出井外。
     * 4. **那圈 `var(--bg)` 的 box-shadow 不是装饰。** 井里居中的实时读数是同一种绿,
     *    圆点飘到它上面时(实测就撞上了"已拖动 N px"那一行)会和它糊成一片、
     *    读成那行字的项目符号。垫一圈井底色等于把圆点从背景里切出来 ——
     *    压在字上时它"挖掉"字,这正是覆盖物该有的样子。
     */
    .drag-dot {
      /* 一处的尺寸:宽高和居中偏移都从它推,两者不会再各走各的 */
      --drag-dot-size: 22px;

      position: fixed;
      top: 0;
      left: 0;
      z-index: 5;
      width: var(--drag-dot-size);
      height: var(--drag-dot-size);
      margin: calc(var(--drag-dot-size) / -2) 0 0 calc(var(--drag-dot-size) / -2);
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 0 2px var(--bg);
      pointer-events: none;
    }

    /*
     * 《按按键分开看》和《每次拖拽的记录》是**测试的附表**,不是文档章节 ——
     * 它们跟的是上面那个装置,而「这项测试测不到什么」那几个 h2 跟的是这篇文章。
     * 所以就地降一档:字号落到阶梯的 19px 那一级,上下留白一起收。
     *
     * **仍然写 `h2`,不换成 `h3`**:那条 1px 分节线是 h2 在承担的(见 global.css
     * 里"写在 h2 上而不是 .prose h2 上"那一段),换标签会把"从这里开始是一块"
     * 连同那条线一起弄丢。降的是字号,不是层级。
     *
     * 实测(改前):28px / 高 60px。这两节加起来原本占 120px 的版面。
     */
    .minor {
      font-size: 1.1875rem;
      margin: 2rem 0 0.4rem;
      padding-top: 1rem;
    }

    /*
     * 说明段跟着收一档。不收的话,表已经是 13.4px、日志是 13.1px,而这句说明
     * 还是 16px —— 整块里最大的一行字会落在"注解"上,读起来像正文被挤到了脚注里。
     *
     * 用相邻兄弟而不是再挂一个类:这两段的**结构位置**就是"紧跟在自己的小标题后面",
     * 那正是这条规则要表达的意思。
     */
    .minor + .prose {
      font-size: 0.9rem;
    }

    /*
     * 「重置」搬进装置列之后,**顶掉它的上外边距** —— flex 列里 margin 和 gap
     * **不会合并**,`.controls` 自带 20px、外面还有 20px 的 gap,两条叠起来
     * 就是 40px 的空档。(和 `.workbench__stage > .minor` 当年那条同一个道理。)
     */
    .workbench__stage > .controls {
      margin-top: 0;
    }

    /*
     * 明细表与拖拽日志并排。
     *
     * `auto-fit` + `minmax(340px, 1fr)`:够宽排两列、窄了自己堆成一列 ——
     * **不新增断点**(全站只有 760px 那一个),算法和 `.mini-grid` 一样。
     * 340 是按日志那一列反算的:`#10  2351 ms  侧键 5 拖动 2582 px` 一行约 300px,
     * 再加内边距。
     */
    .split {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(340px, 1fr));
      gap: 28px;
      align-items: start;
    }

    /* 两列各自那一节:标题的下边距收一点,不然两张表顶边对不齐 */
    .split__col > .minor {
      margin-bottom: 0.4rem;
    }

    /* .drag-live 的定位、[hidden]、大字和标签都在 global.css 里
       (和 CPS / DPI / 滚轮三页共用) */

    /*
     * 这张表后三列全是数字,都要等宽 + tabular —— 值每隔 100ms 变一次,
     * 比例数字会让整列左右跳。global.css 里只有 `.ref-table--kv` 那一档
     * 管第二列,而这里第二到第四列都是数值,所以在页面里补一条
     * (这是那份全局规则本来就允许的方向:数值列由各自页面决定)。
     */
    .by-button td:nth-child(n + 2) {
      font-family: var(--font-mono);
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    /*
     * 表只剩四列、每行一个键,没必要占正文表那一档的行高。
     * 字号取 0.84rem —— 就是 global.css 在 760px 那一档给 `.ref-table` 的值,
     * 不是新造的数:宽屏上这两处因此长得一样。
     *
     * **只写上下内边距,不写 `padding` 简写**:左右那两格由 global.css 的
     * `.ref-table td:last-child { padding-right: 0 }` 决定,简写会连同它一起
     * 覆盖掉 —— 而那条规则和这条特异度相同,谁赢只看源码顺序,不该赌。
     */
    .by-button {
      font-size: 0.84rem;
    }

    .by-button th,
    .by-button td {
      padding-top: 7px;
      padding-bottom: 7px;
    }

    /*
     * 日志条目是 `renderLog()` 里 `createElement` 出来的,**页面 `<style>` 够不着**
     * —— Astro 的 cid 长在模板元素上,运行期造的节点身上没有(见 CLAUDE.md
     * 「运行期用 createElement 造出来的节点」那一段,瞄准页的靶子踩过)。
     * 而 `.log-item` 另外三页(反应 / 键盘 / 双击)也在用,不能改写 global.css,
     * 所以走 `:global()` —— 这份 CSS 只在本页加载,作用域天然就限制住了。
     */
    .log-list :global(.log-item) {
      padding: 5px 12px;
      font-size: 0.82rem;
    }

    .log-list :global(.log-item__index) {
      font-size: 0.72rem;
    }

    .log-list :global(.log-item__note) {
      font-size: 0.78rem;
    }

    .log-list :global(.log-empty) {
      font-size: 0.82rem;
      padding: 10px;
    }

    /* 拖拽必然带文字选中,测试期间抑制掉 */
    :global(html.is-testing) {
      user-select: none;
      -webkit-user-select: none;
    }
  </style>

  <script>
    import {
      analyzeDragEpisodesByButton,
      flattenDragEpisodes,
      type DragEvent,
      type KeyedDragEpisode,
    } from '../../lib/analysis';
    import { BUTTON_CODES, maskFromButtons } from '../../lib/mouse-buttons';
    import { suppressSideButtonNavigation } from '../../lib/side-buttons';
    import {
      createTicker,
      el,
      format,
      mountCapabilityNotices,
      setBadge,
      setStat,
      setText,
      suppressWorkbenchDefaults,
    } from '../../lib/ui';
    import { buttonCopy, currentLocale, fill, getCatalog } from '../../lib/i18n';

    /*
     * 文案**在脚本里重新取一遍**,不是从 frontmatter 传进来的 ——
     * frontmatter 变量在 `<script>` 里不存在(脚本被单独打包成外链模块,
     * 见 CLAUDE.md「页面约定」)。语言从 `<html lang>` 读回来,那是构建期写死、
     * 运行期又是 DOM 上的事实,是两个世界唯一都看得见的东西。
     *
     * `locale` 除了取文案,还要交给 `buttonCopy()` —— 键名和格数一样是
     * **要翻译的字**,不是结构。
     */
    const locale = currentLocale();
    const t = getCatalog(locale).pages.holdDrag;

    mountCapabilityNotices(el('cap-notice'));

    // 右键菜单 / 中键自动滚动会打断拖拽。判据和实现见 ui.ts
    suppressWorkbenchDefaults();

    /*
     * 侧键在浏览器里被硬绑成「后退 / 前进」,一按整页就跳走——而侧键正是这一页
     * 要测的东西之一。拦截的机制见 side-buttons.ts。
     *
     * **刻意不接它返回的还原函数**,理由和 `suppressWorkbenchDefaults()` 完全相同
     * (见 ui.ts 的文件头):页面进 bfcache 时 `pagehide` 照样触发,在那里把它摘掉,
     * 用户按返回键把页面恢复回来之后侧键就再没人拦了——一按侧键整页跳走、成绩全丢。
     */
    suppressSideButtonNavigation();

    /**
     * 移动事件的记录间隔(毫秒)。采样层在 1000Hz 下每秒会产生 1000 个事件,
     * 一次十几秒的拖拽就是上万个点——而对"算个路程"来说,每 8ms 采一个
     * (最多 2 像素的误差)完全够用,所以抽稀掉。
     *
     * **按下和松开不抽稀**:瞬断判据靠的就是这两个事件的精确时刻,
     * 抽掉一个就等于把故障本身删了。多按键之后这条扩展成"**掩码一变就不抽稀**"
     * ——见下面 pointermove 里的说明。
     */
    const MOVE_SAMPLE_MS = 8;

    /**
     * 松开后还保持"在跟踪"的时长,用来捕获瞬断之后的重新按下。
     *
     * 这是**指针级**的宽限,不按每个键各算一份:它接住的是"松手后又落回区域外"
     * 这件事,而那是整个指针的状态,不是某一个键的。
     */
    const REPRESS_GRACE_MS = 80;

    const LOG_LIMIT = 10;

    /**
     * 判定横幅下面那句说明的**空态**。
     *
     * **一处键,两处出口**:首屏那次由模板渲染(`verdictNoteIdle`),脚本复位时
     * 写回来的是这一份 —— 所以它取自目录,不再手抄一句。
     */
    const DEFAULT_NOTE = t.verdictNoteIdle;

    const area = el('area');
    const hint = el('hint');
    const live = el('live');
    const dot = el('dot');
    const logHost = el('log');

    /** 完整的按下/松开/移动序列,所有统计都从它派生 */
    const events: DragEvent[] = [];

    /** 还在一次拖拽会话里(含松开后的宽限期,好接住瞬断后的重按) */
    let armed = false;
    let armTimer = 0;
    let lastMoveAt = 0;

    /**
     * 上一次事件时按着哪些键(本站编号的位掩码)。
     *
     * 两个用处:决定"这次移动要不要抽稀掉",以及高亮表格里正被按着的那些行。
     * 各键自己的按下/松开**不在这里判断**——那是 `analyzeDragEpisodesByButton`
     * 的活,页面只负责如实记录每一次事件的掩码。
     */
    let downMask = 0;

    /**
     * 跟着指针走的那颗圆点。
     *
     * **坐标在这里只记两个变量,`transform` 交给 rAF 去写。** 上面那条
     * `pointermove` 每秒最多跑 1000 次,在里面碰 DOM 就是让绘制去挤采样 ——
     * 和采样层必须薄是同一条纪律(见 CLAUDE.md)。而它也不能像别的读数那样
     * 挂在 100ms 的 ticker 上:10fps 的圆点看起来是"卡住了",不是"跟着走"。
     *
     * 循环是**自终止**的:`armed` 一落,下一帧它自己就停了 —— 所以不需要
     * 谁记得去 stop 它,`arm()` 只负责"确保它在跑"。
     */
    let dotX = 0;
    let dotY = 0;
    let dotRaf = 0;
    let dotRunning = false;
    let dotWrittenX = Number.NaN;
    let dotWrittenY = Number.NaN;

    function pumpDot(): void {
      if (!armed || !dot) {
        dotRunning = false;
        dotRaf = 0;
        return;
      }
      // 没动就不写:每帧无条件写 transform 等于让合成器一直有事做
      if (dotX !== dotWrittenX || dotY !== dotWrittenY) {
        dotWrittenX = dotX;
        dotWrittenY = dotY;
        dot.style.transform = `translate3d(${dotX}px, ${dotY}px, 0)`;
      }
      dotRaf = requestAnimationFrame(pumpDot);
    }

    function ensureDotLoop(): void {
      if (dotRunning) return;
      dotRunning = true;
      dotRaf = requestAnimationFrame(pumpDot);
    }

    /**
     * 记一条事件。
     *
     * `t` 由调用方给,而不是在这里统一取 `performance.now()`:瞬断的判据是
     * **`pointerup` 与 `pointerdown` 之间的间隔**,而这两个事件很可能被浏览器
     * 攒进同一个任务里派发——那一刻两个处理函数几乎是同时跑的,`performance.now()`
     * 的差会塌到 0,于是一次正常的"松手再按"也会落进 30ms 的窗口里,报成瞬断。
     *
     * 所以真实事件一律传 `event.timeStamp`(事件自己带的时刻,不吃派发延迟),
     * 只有 `blur` 里补发的那条合成事件用 `performance.now()`——那条本来就没有
     * 对应的真实事件。两者同源,可以直接相减。
     *
     * 这条约定对**从掩码里比对出来的**那些按下/松开同样成立:它们的时刻就是
     * 暴露了这次变化的那条真实事件的时刻,所以下面传的一律是 `event.timeStamp`。
     */
    function record(t: number, x: number, y: number, kind: DragEvent['kind'], buttonMask: number): void {
      events.push({ t, x, y, kind, buttonMask });
    }

    function arm(): void {
      armed = true;
      window.clearTimeout(armTimer);
      area?.setAttribute('data-holding', 'true');
      document.documentElement.classList.add('is-testing');
      hint?.setAttribute('hidden', '');
      live?.removeAttribute('hidden');
      dot?.removeAttribute('hidden');
      ensureDotLoop();
    }

    function scheduleDisarm(): void {
      window.clearTimeout(armTimer);
      armTimer = window.setTimeout(() => {
        armed = false;
        downMask = 0;
        area?.setAttribute('data-holding', 'false');
        document.documentElement.classList.remove('is-testing');
        render();
      }, REPRESS_GRACE_MS);
    }

    // ---- 渲染 ----

    /*
     * 一个按键的一次按住,带上它是哪个键。**类型住在 `analysis.ts` 里** ——
     * 因为"按时间摊平"那个函数也在那儿(`flattenDragEpisodes`),两边共用一个定义。
     */
    type KeyedEpisode = KeyedDragEpisode;

    function setRowCurrent(code: number, on: boolean): void {
      const row = el(`btn-row-${code}`);
      if (!row) return;
      const value = on ? 'true' : 'false';
      if (row.getAttribute('data-current') !== value) row.setAttribute('data-current', value);
    }

    function render(): void {
      const byButton = analyzeDragEpisodesByButton(events);

      /*
       * **`all` 必须是按时间排的那一份,不能就地按按键分组往外冒。**
       *
       * 原来就是就地 push 的,而 `renderLog` 取的是它的末尾 10 条 —— 于是日志
       * 永远只显示**编号最大那个键**的最后 10 次:左键点了 63 次,记录里一条
       * 都不出现,而计数是对的,所以从数字上完全看不出毛病。用
       * `flattenDragEpisodes` 摊平并按 `startMs` 排序之后,`#N` 才真的是
       * "第 N 次按住",而不是"某个键的第 N 次"。
       */
      const all: KeyedEpisode[] = flattenDragEpisodes(byButton);

      let totalDrops = 0;
      let longest = 0;
      let distance = 0;
      let open = 0;
      let holding: KeyedEpisode | null = null;
      const dropKeys: number[] = [];

      for (const [code, episodes] of byButton) {
        let count = 0;
        let drops = 0;
        let longestHere = 0;

        for (const episode of episodes) {
          /*
           * 未结束的那一段**也计入**次数与最长一次——它是一次真实的按住,
           * 只是页面没收到松开事件。原先只数已结束的,结果是:如果你唯一那次
           * 拖拽没收到松开,统计面板会说"0 次拖拽",而下面的日志里明明躺着一行,
           * 自己跟自己打架。分开计数由"没收到松开"那一格负责。
           */
          count++;
          drops += episode.drops;
          distance += episode.distancePx;
          if (episode.durationMs > longestHere) longestHere = episode.durationMs;
          if (episode.durationMs > longest) longest = episode.durationMs;

          if (episode.open) {
            open++;
            // 实时读数取**最近开始**的那一段:同时按住两个键时,看的是刚按下的那个
            if (holding === null || episode.startMs > holding.episode.startMs) {
              holding = { code, episode };
            }
          }
        }

        if (drops > 0) dropKeys.push(code);
        totalDrops += drops;

        setText(el(`btn-count-${code}`), format(count));
        setText(el(`btn-drops-${code}`), format(drops));
        setText(el(`btn-longest-${code}`), format(longestHere));
        setRowCurrent(code, armed && (downMask & (1 << code)) !== 0);
      }

      // 一个事件都没收到过的键:整行破折号。"没测到"不是"0 次"
      for (const code of BUTTON_CODES) {
        if (byButton.has(code)) continue;
        setText(el(`btn-count-${code}`), t.runtime.dash);
        setText(el(`btn-drops-${code}`), t.runtime.dash);
        setText(el(`btn-longest-${code}`), t.runtime.dash);
        setRowCurrent(code, false);
      }

      setText(el('drops-total'), String(totalDrops));
      setStat('sessions', format(all.length));
      setStat('longest', format(longest));
      setStat('distance', format(distance));
      setStat('open', format(open));

      /*
       * 键名走目录的 `buttons` 命名空间(`buttonCopy`),**不是 `mouse-buttons.ts`
       * 那一份** —— 那张表按键页和拖拽页共用,名字的本地化是中央的一件事。
       */
      const names = dropKeys.map((code) => buttonCopy(code, locale).name).join(t.runtime.nameJoiner);
      if (totalDrops > 0) {
        setBadge(el('state-badge'), fill(t.badges.drops, { name: names }), 'poor');
        setText(
          el('verdict-note'),
          fill(t.runtime.noteDrop, { name: names, count: totalDrops }),
        );
      } else if (all.length > 0) {
        setBadge(el('state-badge'), t.badges.none, 'good');
        setText(el('verdict-note'), fill(t.runtime.noteNone, { count: all.length }));
      }

      // ---- 实时数字 ----
      if (armed && holding !== null) {
        // 按住不动时不会产生任何事件,`durationMs` 会停在最后一个事件上,
        // 所以实时这个数必须走墙上时钟,否则松手前它永远是 0。
        setText(el('live-hold'), (performance.now() - holding.episode.startMs).toFixed(0));
        setText(el('live-distance'), holding.episode.distancePx.toFixed(0));
        setText(el('live-button'), buttonCopy(holding.code, locale).name);
      }

      renderLog(all);
    }

    function renderLog(all: readonly KeyedEpisode[]): void {
      if (!logHost) return;
      if (all.length === 0) {
        const empty = document.createElement('li');
        empty.className = 'log-empty';
        empty.textContent = t.runtime.logEmpty;
        logHost.replaceChildren(empty);
        return;
      }

      const shown = all.slice(Math.max(0, all.length - LOG_LIMIT)).reverse();
      const fragment = document.createDocumentFragment();

      for (let i = 0; i < shown.length; i++) {
        const { code, episode } = shown[i];
        const item = document.createElement('li');
        item.className = episode.drops > 0 ? 'log-item log-item--alert' : 'log-item';

        const index = document.createElement('span');
        index.className = 'log-item__index';
        index.textContent = `#${all.length - i}`;

        const value = document.createElement('span');
        value.className = 'log-item__value';
        value.textContent = episode.open ? t.runtime.logOpen : `${episode.durationMs.toFixed(0)} ms`;

        /*
         * 按键名并进**文字**里,不另起一个元素。日志条目是运行期由 JS 拼出来的,
         * 页面 `<style>` 的规则带着 data-astro-cid 够不着它们(ui.ts 拼出来的
         * `.notice` 就是这个下场),新元素要配样式就得动 global.css。
         */
        const note = document.createElement('span');
        note.className = 'log-item__note';
        note.textContent =
          episode.drops > 0
            ? fill(t.runtime.logChatter, {
                name: buttonCopy(code, locale).name,
                count: episode.drops,
              })
            : fill(t.runtime.logDrag, {
                name: buttonCopy(code, locale).name,
                distance: episode.distancePx.toFixed(0),
              });

        item.append(index, value, note);
        fragment.appendChild(item);
      }

      logHost.replaceChildren(fragment);
    }

    // 按住不动时不会有事件,靠刷新循环把实时秒数推上去
    const stopTicker = createTicker(100, () => {
      if (armed) render();
    });

    // ---- 交互 ----

    /**
     * 按下监听见挂在 window 上,而不是只挂在测试区上。
     *
     * 两个理由:瞬断之后的重新按下可能落在区域外;以及第一次按下如果落在
     * 区域内的文字上,事件照样要算数。`armed` 那个宽限期之外的、落在区域外的
     * 按下则会被忽略——否则页面上随便点一下也会开始记一笔。
     *
     * 取键一律走 `event.buttons` 的掩码,**不用 `event.button`**:第二个键的按下
     * 和第一个键的松开都不会有 `pointerdown` / `pointerup`,只有掩码会变
     * (见 CLAUDE.md「组合按键」)。
     */
    window.addEventListener('pointerdown', (event) => {
      const mask = maskFromButtons(event.buttons);
      if (mask === 0) return;

      const inside = area?.contains(event.target as Node) ?? false;
      if (!inside && !armed) return;

      /*
       * 只在主键上 preventDefault:它挡的是拖拽必然带起的原生拖放(拖图片、拖链接),
       * 那是左键的事。右键菜单和中键自动滚动已经由 suppressWorkbenchDefaults 处理,
       * 在这里再取消一次会把兼容鼠标事件一并吞掉——比如右键点在链接上的
       * 「在新标签页中打开」。
       */
      if ((mask & 0b1) !== 0) event.preventDefault();

      // 圆点从按下的那一点起步 —— 不然它要等第一条 pointermove 才现身
      dotX = event.clientX;
      dotY = event.clientY;

      arm();
      downMask = mask;
      record(event.timeStamp, event.clientX, event.clientY, 'down', mask);
      render();
    });

    window.addEventListener(
      'pointermove',
      (event) => {
        if (!armed) return;

        /*
         * 圆点的坐标在抽稀**之前**记 —— 它是给眼睛看的,不是给统计看的。
         * 放在下面那道 8ms 门槛之后的话,慢速拖动时圆点会一跳一跳。
         */
        dotX = event.clientX;
        dotY = event.clientY;

        const mask = maskFromButtons(event.buttons);
        const changed = mask !== downMask;

        /*
         * 抽稀只抽"什么都没变"的那种移动。**掩码一变就必须记**,哪怕它落在上一个
         * 采样点的 2ms 之内——一个键的按下或松开改变了后面全部的结论,抽掉它等于
         * 把那次按键删了。这和"按下和松开不抽稀"是同一条道理,多按键之后
         * 那些边沿正是藏在移动事件里的。
         *
         * (不这么写的话会很难查:按住左键再松开左键,浏览器一次 `pointerup`
         * 都不派发,左键那一段就会永远挂着不结束。)
         */
        const now = performance.now();
        if (!changed && now - lastMoveAt < MOVE_SAMPLE_MS) return;
        lastMoveAt = now;

        downMask = mask;
        record(event.timeStamp, event.clientX, event.clientY, 'move', mask);
      },
      { passive: true },
    );

    function release(event: PointerEvent): void {
      if (!armed) return;

      /*
       * 掩码一律记 0:`pointerup` 只在**最后一个键**松开时派发,所以此刻手上确实
       * 一个键都不剩;`pointercancel` 更彻底——指针被系统收走了,键也不再算按着。
       * 至于松开的**是哪个**键,这个事件本身并不携带(它的 `buttons` 就是 0),
       * 由 analyzeDragEpisodesByButton 跟上一份掩码比对推出来。
       */
      record(event.timeStamp, event.clientX, event.clientY, 'up', 0);
      downMask = 0;
      dot?.setAttribute('hidden', '');
      scheduleDisarm();
      render();
    }

    window.addEventListener('pointerup', release);
    // 系统把指针收走了(触控笔、驱动问题),当作松开收尾,免得一次拖拽永远挂着
    window.addEventListener('pointercancel', release);

    // 窗口失焦时收不到松开事件。补一条合成事件把这一段收尾,
    // 否则它会一直显示成"按着没松"。
    window.addEventListener('blur', () => {
      if (!armed) return;
      const last = events[events.length - 1];
      // 合成事件:没有真实事件可依,取当下的墙钟时间
      if (last && last.buttonMask !== 0) {
        record(performance.now(), last.x, last.y, 'up', 0);
      }
      armed = false;
      downMask = 0;
      dot?.setAttribute('hidden', '');
      area?.setAttribute('data-holding', 'false');
      document.documentElement.classList.remove('is-testing');
      render();
    });

    // 拖拽必然带起原生拖放(拖图片、拖链接),那会打断跟踪
    window.addEventListener('dragstart', (event) => {
      if (armed) event.preventDefault();
    });

    el('reset')?.addEventListener('click', () => {
      events.length = 0;
      armed = false;
      downMask = 0;
      window.clearTimeout(armTimer);
      area?.setAttribute('data-holding', 'false');
      document.documentElement.classList.remove('is-testing');
      hint?.removeAttribute('hidden');
      live?.setAttribute('hidden', '');
      dot?.setAttribute('hidden', '');
      setBadge(el('state-badge'), t.badges.idle, 'idle');
      setText(el('verdict-note'), DEFAULT_NOTE);
      render();
    });

    window.addEventListener('pagehide', () => {
      stopTicker();
      window.clearTimeout(armTimer);
      cancelAnimationFrame(dotRaf);
      dotRunning = false;
      document.documentElement.classList.remove('is-testing');
    });

    render();
  </script>
</BaseLayout>
