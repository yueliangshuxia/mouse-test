---
/*
 * 刷新率目视测试页的**主体**。两个薄路由引它:中文的 `/refresh-visual-test/`
 * 和英文的 `/en/refresh-visual-test/`。
 *
 * ## 为什么页面要拆成"组件 + 两个薄路由"
 *
 * Astro 的页面文件不能被另一个页面 import,所以"同一页渲染两种语言"只有这一条路:
 * 主体搬进组件、收一个 `locale`,路由文件各写三行。**别把它再抄回页面里** ——
 * 一份两处,迟早一处改了另一处没改。
 *
 * ## 两处这一页特有的
 *
 * - **对照表的三列按 `hz` 查目录,不按下标对齐。** 页面的 `RATES` 和目录的
 *   `rateRows` 是**两份**,顺序哪天一动就会静默错位(见 `pages/refresh.ts` 的文件头)。
 *   表里**一整帧那一列(`1000 ÷ hz`)留在页面里** —— 它是算出来的,不是抄的
 *   (同 `Scroll.astro` 那列换算除数)。
 * - **`tail` 里那个 `{pointerTestLink}` 是一枚链接**,所以整句是
 *   `fill(faqHtml(t.tail), …)` —— **`fill()` 必须在 `faqHtml()` 之后**:反过来的话
 *   刚插进去的 `<a>` 会被当成句子的一部分转义掉(形状同 `Doodle.astro` 的 `{link}`)。
 *
 * ## 那处 literal backtick 现在会变成 `<code>`
 *
 * FAQ 第 1 条里那次 `(requestAnimationFrame)` 是源文件里的两个字面反引号。
 * 转换前 `faqHtml()` 不认它,于是屏幕上一直印着两个裸露的反引号 —— 那是**已知的
 * bug**,不是有意为之。`faq.ts` 现在把反引号转成 `<code>`,所以这一页渲染出来
 * 会少掉那两个字符、多一个等宽代码片。**这是这一页唯一一处有意的文字改动**,
 * 记在这里免得被当成"搬运出错"。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatPanel from '../../components/StatPanel.astro';
import { faqHtml, faqText } from '../../lib/faq';
import { TOOL_MOTIF } from '../../lib/tool-motifs';
import { TOOL_HUE } from '../../lib/tool-hues';
import { DEFAULT_LOCALE, fill, getCatalog, pageHref } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getCatalog(locale).pages.refresh;

/*
 * 方块的三档速度(像素 / 秒)。
 *
 * **为什么要有速度这一档,而不是"一个速度看看就行"。**因为目视判断流畅度时,
 * 速度是那个真正决定"看不看得出来"的变量:方块慢到一定程度,**60Hz 和 240Hz
 * 在眼睛里是一模一样的**,再怎么看也分不出来;而快到一定程度它又会糊成一条,
 * 边缘失去参照。所以给三档不是"换个数字看看" —— 是让用户能自己找到一个
 * "看得出差别"的速度,那正是这个测试唯一能出结论的区间。
 *
 * **像素值住在页面里**(两种语言逐字相同),标签才住目录 —— 同 `Dpi.astro` 的档位值。
 */
const SPEEDS = [
  { px: 220, label: t.speeds.slow },
  { px: 520, label: t.speeds.medium },
  { px: 1000, label: t.speeds.fast },
];

/*
 * 常见刷新率对照表。第二列拿 `hz` 现算,不手抄 —— 手抄的 16.7 / 8.3 迟早
 * 和 1000/144 差出最后一位,而这张表的全部意义就是"这个数到底是多少"。
 *
 * 「常见于」那一列**按 `hz` 查目录,不按下标**(见文件头)。
 */
const RATES = [60, 75, 90, 120, 144, 165, 240, 360];

const RATE_TABLE = RATES.map((hz) => {
  const copy = t.rateRows.find((row) => row.hz === hz);
  return {
    hz,
    frame: (1000 / hz).toFixed(1),
    where: copy ? copy.where : '',
  };
});

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: t.h1,
      description: t.metaDescription,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: faqText(item.a) },
      })),
    },
  ],
};
---

<BaseLayout
  title={t.metaTitle}
  description={t.metaDescription}
  current="refresh-visual-test"
  jsonLd={jsonLd}
  hue={TOOL_HUE['refresh-visual-test']}
  locale={locale}
>
  <div class="tool-head">
    <span class="tool-head__icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={TOOL_MOTIF['refresh-visual-test']}
      />
    </span>
    <h1>{t.h1}</h1>
  </div>

  <p class="prose" set:html={faqHtml(t.lede)} />

  <p class="prose" set:html={faqHtml(t.honesty)} />

  <div id="cap-notice"></div>

  <div class="controls">
    <span class="test-hint">{t.speedLabel}</span>
    {
      SPEEDS.map((option, index) => (
        <button
          type="button"
          class="speed"
          data-speed={option.px}
          aria-pressed={index === 1 ? 'true' : 'false'}
        >
          {option.label}
        </button>
      ))
    }
    <button type="button" id="toggle">{t.runtime.start}</button>
    <span class="test-hint" id="hint">{t.hint}</span>
  </div>

  <div class="test-area well refresh-area" id="area">
    <div class="refresh-block" id="block"></div>
  </div>

  <div class="stat-grid">
    <StatPanel
      id="hz"
      label={t.stats.hz.label}
      unit={t.stats.hz.unit}
      primary
      hint={t.stats.hz.hint}
    />
    <StatPanel
      id="frameMs"
      label={t.stats.frameMs.label}
      unit={t.stats.frameMs.unit}
      hint={t.stats.frameMs.hint}
    />
  </div>

  <p class="prose" id="readout">{t.runtime.dash}</p>

  <section class="prose prose--cards">
    <h2>{t.rateHeading}</h2>
    <p set:html={faqHtml(t.rateLede)} />
    <table class="ref-table ref-table--kv">
      <thead>
        <tr>
          <th>{t.rateColumns.rate}</th>
          <th>{t.rateColumns.frame}</th>
          <th>{t.rateColumns.where}</th>
        </tr>
      </thead>
      <tbody>
        {
          RATE_TABLE.map((row) => (
            <tr data-rate={row.hz}>
              <td>{fill(t.rateCells.hz, { hz: row.hz })}</td>
              <td>{fill(t.rateCells.frame, { frame: row.frame })}</td>
              <td>{row.where}</td>
            </tr>
          ))
        }
      </tbody>
    </table>

    <h2>{t.readHeading}</h2>
    <ol class="steps">
      {t.readPoints.map((point) => <li set:html={faqHtml(point)} />)}
    </ol>

    <h2>{t.blameHeading}</h2>
    <p set:html={faqHtml(t.blameLede)} />
    <ul>
      {t.blamePoints.map((point) => <li set:html={faqHtml(point)} />)}
    </ul>

    {/*
      那枚指向回报率测试页的链接:先 `faqHtml()`(它会把 HTML 转义掉),再用
      `fill()` 把 `{pointerTestLink}` 换成真正的 `<a>` —— 顺序反过来的话标签会被
      转义成可见文本。
    */}
    <p
      set:html={fill(faqHtml(t.tail), {
        pointerTestLink: `<a href="${pageHref(locale, 'polling-rate-test')}">${t.pointerTestLink}</a>`,
      })}
    />

    <h2>{t.faqHeading}</h2>
    <div class="faq">
      {
        t.faq.map((item) => (
          <div class="faq__item">
            <div class="faq__q">{item.q}</div>
            <p class="faq__a" set:html={faqHtml(item.a)} />
          </div>
        ))
      }
    </div>
  </section>

  <style>
    /*
     * 那条带子。**不写高度** —— `.test-area` 自带 380px,和别页一致。
     * 它继承 `.test-area` 的刻度栅格,而那些格子在这里正是**静止的参照物**,
     * 是这一页需要的,不是装饰(见 FAQ 最后一条)。
     */
    .refresh-area {
      cursor: default;
    }

    /*
     * 方块。**用 `transform` 移动,不用 `left`** —— `left` 每帧都会触发一次
     * 布局,而这一页量的正是帧节奏:让被测的页面自己去抢每一帧的时间,
     * 量出来的数就变成"页面有多慢"而不是"这台机器有多顺"。
     * `translate3d` 还会把它提到自己的合成层上,改它不引起重绘。
     *
     * 边长写在**这里**(56px),脚本里不抄第二份:它算位移时读的是
     * `block.offsetWidth`,那才是权威值。够大才有清晰的边缘,而边缘正是
     * 判断顿挫的参照 —— 所以别为了"秀气"把它改小。
     */
    .refresh-block {
      position: absolute;
      top: 50%;
      left: 0;
      width: 56px;
      height: 56px;
      margin-top: -28px;
      border-radius: var(--radius);
      /* 在 `.well` 里,`--accent` 就是磷光绿 —— 和键帽、靶心同一支笔,一个令牌都没新增 */
      background: var(--accent);
      transform: translate3d(0, 0, 0);
      will-change: transform;
    }
  </style>

  <script>
    import { summarizeFrameCadence } from '../../lib/analysis';
    import {
      createTicker,
      el,
      format,
      mountCapabilityNotices,
      setStat,
      setText,
      suppressWorkbenchDefaults,
    } from '../../lib/ui';
    import { currentLocale, fill, getCatalog } from '../../lib/i18n';

    /*
     * 文案**在脚本里重新取一遍**,不是从 frontmatter 传进来的 ——
     * frontmatter 变量在 `<script>` 里不存在(脚本被单独打包成外链模块,
     * 见 CLAUDE.md「页面约定」)。语言从 `<html lang>` 读回来,那是构建期写死、
     * 运行期又是 DOM 上的事实,是两个世界唯一都看得见的东西。
     */
    const t = getCatalog(currentLocale()).pages.refresh;

    const area = el('area');
    const block = el('block');
    const toggle = el('toggle') as HTMLButtonElement | null;

    if (!area || !block) throw new Error('测试面未就绪');

    /*
     * 这一页**要拦默认行为**:用户正盯着一条匀速横移的方块判断流畅度,
     * 这时候中键自动滚动会让整块测试面从指针底下滑走,右键菜单会盖住画面 ——
     * 两样都直接打断这一页唯一的动作。判据(「这一页的读数会不会被指针的
     * 默认行为污染」)在这里成立,所以调整页那一版。
     */
    suppressWorkbenchDefaults();

    /*
     * 帧节奏那几条告警在这一页是有意义的:跨域隔离影响时间戳精度、
     * `pointerrawupdate` 影响回报率 —— 这一页都不吃,但它**确实在报一个
     * 和刷新有关的数**,而"浏览器把 rAF 掐到什么节奏"正属于那组告警在说的
     * 环境问题。所以照常渲染,不特殊处理。
     */
    // 这一页读的是 **rAF 的节奏**(约 16ms 一格),不是事件时间戳 —— 100µs 的量化
    // 对它等于没有。**文档里那句「刷新率目视不该收这四条」原本就没兑现**,这里补上。
    mountCapabilityNotices(el('cap-notice'), { timing: false });

    // ---------- 方块 ----------

    /**
     * 方块能走的范围(测试面的内容宽)。
     *
     * **缓存起来,不每帧读。**读 `clientWidth` 会强制一次布局,而这一页量的
     * 正是每一帧剩多少时间 —— 每帧插一次强制布局,等于让被测对象自己去
     * 污染测量。尺寸变了由下面那个 `ResizeObserver` 刷新这个缓存。
     */
    let track = 0;

    /** 方块自己的宽度,同样只在尺寸变化时读一次 */
    let blockWidth = 0;

    /** 当前速度(像素 / 秒) */
    let speed = 520;

    let running = false;
    let stopTicker: (() => void) | null = null;

    /** 方块左边缘相对测试面的位移 */
    let position = 0;

    /** 上一帧的时间戳。0 表示"这一轮还没有上一帧" */
    let lastFrameAt = 0;

    /** 这一轮的帧间隔。**原样存,不在这里筛** —— 判据在 `summarizeFrameCadence` 里 */
    const gaps: number[] = [];

    /** 读数上一次刷新的时刻,用来把 DOM 写入压到 4 次 / 秒 */
    let lastRenderAt = 0;

    function measure(): void {
      if (!area || !block) return;
      track = area.clientWidth;
      blockWidth = block.offsetWidth;
    }

    /*
     * 一帧最多按多少毫秒算。
     *
     * 页面被切到后台时 rAF 会停,**回到前台的第一帧时间差是整段后台时长** ——
     * 不夹住的话方块会凭空瞬移一大段(而那不是"卡",是"刚才根本没画")。
     * 夹到 50ms 相当于"最坏也就是掉几帧",看起来仍是连续的。
     */
    const MAX_STEP_MS = 50;

    function step(now: number): void {
      const raw = lastFrameAt === 0 ? 0 : now - lastFrameAt;

      /*
       * 帧间隔**先记原样的数**:夹住只是给方块算位移用的,`raw` 那个数才是
       * 这一帧真实的时间差。把夹过的值记进缓冲区,一次 300ms 的后台间隔
       * 就会变成一个漂亮的 50ms,而 `summarizeFrameCadence` 正是靠
       * "超过 100ms 的不算一帧"把这类样本剔掉的 —— 提前夹住等于把它的判据
       * 悄悄改掉了。
       */
      if (lastFrameAt > 0) {
        gaps.push(raw);
        if (gaps.length > 240) gaps.shift();
      }
      lastFrameAt = now;

      const dt = Math.min(raw, MAX_STEP_MS);

      position += (speed * dt) / 1000;
      // 走到头就整个移出右边、从左边重新进来:一段连续的、方向不变的运动,
      // 比来回弹跳更容易看出顿挫 —— 掉头那一下本身就是一次显眼的变化
      if (track > 0 && position > track) position = -blockWidth;

      if (block) block.style.transform = `translate3d(${position}px, 0, 0)`;

      /*
       * 读数**最多每 250ms 写一次**。每帧写一次 `textContent` 会触发样式重算,
       * 而这份开销会被如实记进帧间隔里 —— 又是"测量被自己污染"那条。
       * 4 次 / 秒对读数完全够用,这里要看的也从来不是"数字跳得多快"。
       */
      if (now - lastRenderAt >= 250) {
        lastRenderAt = now;
        renderStats();
      }
    }

    // ---------- 读数 ----------

    function renderStats(): void {
      const cadence = summarizeFrameCadence(gaps);
      setStat('hz', format(cadence.hz));
      setStat('frameMs', format(cadence.medianMs, 1));

      highlightRate(cadence.hz);

      if (cadence.hz === null) {
        setText(el('readout'), t.runtime.tooFew);
        return;
      }

      setText(
        el('readout'),
        fill(t.runtime.measured, {
          hz: cadence.hz,
          ms: cadence.medianMs!.toFixed(1),
          samples: cadence.samples,
        }),
      );
    }

    /**
     * 把对照表里对应的那一行点亮。
     *
     * **只有落在一档附近(±10%)才点亮**,落在两档中间就一行都不亮。
     * 144Hz 面板上掉帧量到 72 是常事,而 72 离 75 只差 4% —— 按"取最近的一档"
     * 写,它会被点亮成「75 Hz 早期笔记本面板」,把"合成器掉了一半帧"说成
     * "你的面板是 75Hz"。宁可不亮。
     */
    function highlightRate(hz: number | null): void {
      for (const row of document.querySelectorAll<HTMLElement>('tr[data-rate]')) {
        const value = Number(row.dataset.rate);
        const hit = hz !== null && Math.abs(value - hz) <= value * 0.1;
        if (hit) row.setAttribute('data-current', 'true');
        else row.removeAttribute('data-current');
      }
    }

    // ---------- 开 / 停 ----------

    function start(): void {
      if (running) return;
      running = true;

      // 新一轮从干净的状态起:上一轮的间隔和位置都不该混进来
      gaps.length = 0;
      lastFrameAt = 0;
      lastRenderAt = 0;
      position = 0;
      measure();

      setStat('hz', t.runtime.dash);
      setStat('frameMs', t.runtime.dash);
      highlightRate(null);
      setText(el('readout'), t.runtime.running);

      if (toggle) toggle.textContent = t.runtime.stop;
      stopTicker = createTicker(0, step);
    }

    function stop(): void {
      if (!running) return;
      running = false;
      stopTicker?.();
      stopTicker = null;

      if (toggle) toggle.textContent = t.runtime.start;
      // 停在这一帧上再看一眼最终的数。方块留在原地不动 —— 把它弹回起点
      // 等于在用户刚看完的那一瞬又动一下
      renderStats();
    }

    toggle?.addEventListener('click', () => {
      if (running) stop();
      else start();
    });

    // 切走标签页就停下。rAF 本来就会停,但**回到前台时用户看到的还是
    // "正在跑"的样子**,而那个数里混着一段后台时间 —— 不如如实停掉,
    // 让用户自己决定要不要再跑一轮
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stop();
    });

    // ---------- 速度 ----------

    function renderSpeeds(): void {
      for (const button of document.querySelectorAll<HTMLElement>('.speed')) {
        button.setAttribute(
          'aria-pressed',
          Number(button.dataset.speed) === speed ? 'true' : 'false',
        );
      }
    }

    for (const button of document.querySelectorAll<HTMLElement>('.speed')) {
      button.addEventListener('click', () => {
        // 速度**从 DOM 读回来**,不在脚本里抄第二份表(frontmatter 变量在
        // `<script>` 里不存在)。同 cps-test 的 renderDurations()
        speed = Number(button.dataset.speed) || 520;
        renderSpeeds();
      });
    }

    // 换速度**不重开一轮**:用户正是在两个速度之间比较"哪一个看得出差别",
    // 中途清掉读数会把刚建立起来的对照抹掉
    renderSpeeds();

    // ---------- 尺寸 ----------

    measure();
    if (typeof ResizeObserver !== 'undefined') {
      new ResizeObserver(() => {
        measure();
      }).observe(area);
    } else {
      window.addEventListener('resize', measure);
    }

    /*
     * 空态:读数就是两条破折号,不调 `renderStats()`。
     * 那会印出"帧数还不够,再让它跑一会儿",而用户此刻**一次都还没跑过** ——
     * 把"没开始"说成"跑了但样本不够",是两个不同的状态被写成同一句话。
     */
    setStat('hz', t.runtime.dash);
    setStat('frameMs', t.runtime.dash);
  </script>
</BaseLayout>
