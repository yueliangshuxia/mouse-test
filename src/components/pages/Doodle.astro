---
/*
 * 涂鸦板页的**主体**。两个薄路由引它:中文的 `/doodle-test/` 和英文的 `/en/doodle-test/`。
 *
 * ## 为什么页面要拆成"组件 + 两个薄路由"
 *
 * Astro 的页面文件不能被另一个页面 import,所以"同一页渲染两种语言"只有这一条路:
 * 主体搬进组件、收一个 `locale`,路由文件各三行。**别把它再抄回页面里** ——
 * 一份两处,迟早一处改了另一处没改。
 *
 * ## 这一页照 `Cps.astro` 那套做
 *
 * 文案住在 `src/lib/i18n/pages/doodle.ts`;模板里的静态文字换成 `t.…`;带
 * `**强调**` 的整段走 `faqHtml()`;`<script>` 里的句子语言从 `currentLocale()`
 * 读回来、句子本身整句住在目录里。
 *
 * 一处**这一页特有的**:第三步里那枚指向按键测试页的链接,原先是写死在标记里的
 * `<a>`。搬进目录之后它是 `{link}` 占位符 —— 因为 `faqHtml()` 会转义 HTML,
 * 链接必须在它**之后**用 `fill()` 填进去。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { faqHtml, faqText } from '../../lib/faq';
import { href } from '../../lib/url';
import { TOOL_MOTIF } from '../../lib/tool-motifs';
import { TOOL_HUE } from '../../lib/tool-hues';
import { DEFAULT_LOCALE, fill, getCatalog } from '../../lib/i18n';
import type { Locale } from '../../lib/i18n';

interface Props {
  locale?: Locale;
}

const { locale = DEFAULT_LOCALE } = Astro.props;
const catalog = getCatalog(locale);
const t = catalog.pages.doodle;

/** 笔迹粗细。**key 是像素宽**,和按钮上的 `data-width` 对得上 */
const WIDTHS = Object.entries(t.widths).map(([px, label]) => ({
  px: Number(px),
  label,
}));

/*
 * 第三步里那枚链接的文字取目录里按键测试页的短名(`navLabel`) —— 两处要的是
 * 同一件事("那一页叫什么"),各写一份的话哪天改了名,这里会静默指向一个旧名字。
 */
const buttonTestLabel = catalog.tools['button-test'].navLabel;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      name: t.h1,
      description: t.metaDescription,
      applicationCategory: 'EntertainmentApplication',
      operatingSystem: 'Web',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'CNY' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: t.faq.map((item) => ({
        '@type': 'Question',
        name: item.q,
        acceptedAnswer: { '@type': 'Answer', text: faqText(item.a) },
      })),
    },
  ],
};
---

<BaseLayout
  title={t.metaTitle}
  description={t.metaDescription}
  current="doodle-test"
  jsonLd={jsonLd}
  hue={TOOL_HUE['doodle-test']}
  locale={locale}
>
  <div class="tool-head">
    <span class="tool-head__icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={TOOL_MOTIF['doodle-test']}
      />
    </span>
    <h1>{t.h1}</h1>
  </div>

  <p class="prose" set:html={faqHtml(t.lede)} />

  <div id="cap-notice"></div>

  <div class="controls">
    <span class="test-hint">{t.penLabel}</span>
    {
      WIDTHS.map((option, index) => (
        <button
          type="button"
          class="pen"
          data-width={option.px}
          aria-pressed={index === 1 ? 'true' : 'false'}
        >
          {option.label}
        </button>
      ))
    }
    <button type="button" id="clear" disabled>{t.clear}</button>
    <button type="button" id="save" disabled>{t.save}</button>
    <span class="test-hint" id="hint">{t.hint}</span>
  </div>

  <div class="doodle-frame">
    <div class="test-area well doodle-area" id="area">
      <canvas id="canvas" class="doodle-canvas"></canvas>
      <div class="test-area__hint" id="overlay">{t.overlay}</div>
    </div>
  </div>

  <section class="prose prose--cards">
    <h2>{t.limitsHeading}</h2>
    <ul>
      {
        t.limits.map((limit) => (
          <li set:html={faqHtml(limit)} />
        ))
      }
    </ul>

    <h2>{t.stepsHeading}</h2>
    <ol class="steps">
      <li set:html={faqHtml(t.steps[0])} />
      <li set:html={faqHtml(t.steps[1])} />
      {/*
        第三步里那枚链接:先 `faqHtml()`(它会把 HTML 转义掉),再用 `fill()`
        把 `{link}` 换成真正的 `<a>` —— 顺序反过来的话标签会被转义成可见文本。
      */}
      <li
        set:html={fill(faqHtml(t.steps[2]), {
          link: `<a href="${href('button-test/')}">${buttonTestLabel}</a>`,
        })}
      />
    </ol>

    <h2>{t.faqHeading}</h2>
    <div class="faq">
      {
        t.faq.map((item) => (
          <div class="faq__item">
            <div class="faq__q">{item.q}</div>
            <p class="faq__a" set:html={faqHtml(item.a)} />
          </div>
        ))
      }
    </div>
  </section>

  <style>
    /*
     * 画布铺满测试面。**用 `position: absolute; inset: 0`**,和轨迹页同一套 ——
     * `.test-area` 是定位祖先,画布是它的内边距盒。
     *
     * `touch-action: none` 是触屏能画的前提:不关掉的话,手指划过去会被浏览器
     * 当成滚动,画出来的是空白。代价是画布上不能靠手指翻页,这是画板该有的取舍。
     */
    .doodle-area {
      height: 420px;
      cursor: crosshair;

      /*
       * **抬到流星拖尾上面。**
       *
       * 拖尾是壳里那层 `z-index: 3` 的固定画布,压在正文之上;而画板这一页的
       * 指针一直在动,于是那条绿尾巴会**一直跟在你笔下**,画面上多出一条不属于
       * 你的笔画。`.test-area` 自己就是 `position: relative`,所以 `z-index`
       * 直接生效;星空是 `-1`,照样在后面,抬这一层不影响它。
       */
      z-index: 4;
    }

    .doodle-canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      touch-action: none;
      cursor: crosshair;
    }

    /*
     * 画过一笔之后就把空态提示收掉。**按"有没有墨"而不是"正在不在画"** ——
     * 后者会让提示在每次松手之后又冒出来,压在刚画好的线上。
     */
    .doodle-area[data-ink='true'] .test-area__hint {
      display: none;
    }

    /*
     * 窄屏。420 下把 420px 高的画布原样留着,一屏就只剩画布了,而上面那排
     * 控件会被推到屏幕外。这个断点就是全站那**一个**(760px),不新增。
     */
    @media (max-width: 760px) {
      .doodle-area {
        height: 300px;
      }
    }
  </style>

  <script>
    import { el, setText, suppressDefaultsWithin } from '../../lib/ui';
    import { currentLocale, getCatalog } from '../../lib/i18n';

    /*
     * 文案**在脚本里重新取一遍**,不是从 frontmatter 传进来的 ——
     * frontmatter 变量在 `<script>` 里不存在(脚本被单独打包成外链模块,
     * 见 CLAUDE.md「页面约定」)。语言从 `<html lang>` 读回来,那是构建期写死、
     * 运行期又是 DOM 上的事实,是两个世界唯一都看得见的东西。
     */
    const t = getCatalog(currentLocale()).pages.doodle;

    const area = el('area');
    const canvas = el('canvas') as HTMLCanvasElement | null;

    if (!area || !canvas) throw new Error('画布未就绪');

    const ctx = canvas.getContext('2d');
    if (!ctx) throw new Error('浏览器不支持 Canvas 2D');

    /*
     * **刻意不调 `suppressWorkbenchDefaults()`,这一点要说清楚。**
     *
     * 全站的判据是"这一页的读数会不会被指针的默认行为污染"。画板确实会被污染:
     * 右键菜单会在笔画中途弹出来盖住画面,中键自动滚动会把画布从指针底下滚走。
     * 所以它**是**要拦的 —— 只不过该拦的是**画布这一块**,不是整页。
     *
     * 差别来自这一页的性质:它没有读数,整页是一篇正文加一块板。在正文上调
     * 那个函数,等于夺走读者的"复制"和"在新标签页中打开",而对画板毫无帮助 ——
     * 正是 ui.ts 里说的"对读者耍横"。而两个函数共用同一份判据实现,所以这里
     * 换成 `suppressDefaultsWithin(area)`,只是把范围收到画布上。
     * (首页对那几片网格用的也是它,同一条理由。)
     */
    suppressDefaultsWithin(area);

    /** 笔迹粗细(CSS 像素)。默认和中键那一档一致 */
    let penWidth = 8;

    /** 这一页只用左键。`MouseEvent.button === 0` 是左键 —— 位掩码那一套这里用不上 */
    const LEFT = 0;

    let drawing = false;
    let lastX = 0;
    let lastY = 0;

    /**
     * 画布上有没有墨。
     *
     * 它同时管三件事:空态提示收不收、`清空` / `保存图片` 能不能按。
     * **空板上那两个按钮不该是可点的** —— 点"保存图片"下载到一张空白 PNG,
     * 是那种"功能正常但结果没意义"的假绿灯。
     */
    function setInk(hasInk: boolean): void {
      area!.setAttribute('data-ink', hasInk ? 'true' : 'false');
      for (const id of ['clear', 'save']) {
        const button = el(id) as HTMLButtonElement | null;
        if (button) button.disabled = !hasInk;
      }
    }

    /**
     * 笔的颜色。
     *
     * 从 `--trail-color` 读,和轨迹页共用同一个令牌 —— 它就长在 `.well` 里,
     * 所以取到的是仪器窗的磷光绿,**一个令牌都不用新增**。
     *
     * 兜底值必须和 `renderer.ts` 里那一个同值:两个都是"变量解析为空时"的
     * 最后一道,而这个状态正是令牌改到一半。两处不一致的话,画布会在主题切换的
     * 一瞬变成另一种颜色,看起来像渲染层坏了。
     */
    function ink(): string {
      return getComputedStyle(canvas!).getPropertyValue('--trail-color').trim() || '#5ed69b';
    }

    function setPen(): void {
      ctx!.lineWidth = penWidth;
      ctx!.lineCap = 'round';
      ctx!.lineJoin = 'round';
      ctx!.strokeStyle = ink();
    }

    /**
     * 让画布的像素尺寸跟上它现在的显示尺寸,并保住已经画出来的东西。
     *
     * **改 `canvas.width` 会清空画布**,所以缩放窗口一定会擦掉作品。这里先把
     * 现有的图挪到一块临时画布上,改完尺寸再按**设备像素 1:1** 贴回左上角 ——
     * 不缩放,所以画出来的东西位置不变,只是视口变小时可能被裁掉右边和下边。
     * 缩放重采样会让线条糊掉,而挪位比糊掉好接受。
     */
    function fit(): void {
      const rect = canvas!.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) return;

      const dpr = window.devicePixelRatio || 1;
      const width = Math.round(rect.width * dpr);
      const height = Math.round(rect.height * dpr);
      if (canvas!.width === width && canvas!.height === height) return;

      const kept = document.createElement('canvas');
      kept.width = canvas!.width;
      kept.height = canvas!.height;
      if (canvas!.width && canvas!.height) kept.getContext('2d')?.drawImage(canvas!, 0, 0);

      canvas!.width = width;
      canvas!.height = height;
      // 之后的绘制都按 CSS 像素给坐标,由这一层变换换算到设备像素
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      setPen();

      if (kept.width && kept.height) {
        ctx!.save();
        ctx!.setTransform(1, 0, 0, 1, 0, 0);
        ctx!.drawImage(kept, 0, 0);
        ctx!.restore();
      }
    }

    /** 画布上的 CSS 像素坐标。用 `offsetX/Y` 而不是 `clientX` 减 rect:少一次布局读取 */
    function point(event: PointerEvent): { x: number; y: number } {
      return { x: event.offsetX, y: event.offsetY };
    }

    canvas.addEventListener('pointerdown', (event) => {
      if (event.button !== LEFT) return;
      // 捕获之后指针移出画布也不会断线,画到边框外面再绕回来是连贯的
      canvas.setPointerCapture(event.pointerId);
      drawing = true;
      // 空态提示和那两个按钮都由这一条属性收放(见 setInk),不用 `hidden` ——
      // `.test-area__hint` 自己有 display,UA 的 `[hidden]` 不一定压得住它
      setInk(true);

      const { x, y } = point(event);
      lastX = x;
      lastY = y;

      // 点一下不出笔画会显得"点坏了",所以按下就先落一个点。
      // 用一段极短的线段而不是 arc:这样它的粗细和圆头跟后面的笔画完全一致。
      ctx!.beginPath();
      ctx!.moveTo(x, y);
      ctx!.lineTo(x + 0.01, y);
      ctx!.stroke();
    });

    canvas.addEventListener('pointermove', (event) => {
      if (!drawing) return;
      const { x, y } = point(event);
      ctx!.beginPath();
      ctx!.moveTo(lastX, lastY);
      ctx!.lineTo(x, y);
      ctx!.stroke();
      lastX = x;
      lastY = y;
    });

    /** 松手 / 取消都收笔。cancel 也要收,否则指针被系统抢走之后会一直"按着" */
    function endStroke(): void {
      drawing = false;
    }

    canvas.addEventListener('pointerup', endStroke);
    canvas.addEventListener('pointercancel', endStroke);

    // ---- 控件 ----

    function renderWidths(): void {
      for (const button of document.querySelectorAll<HTMLElement>('.pen')) {
        button.setAttribute(
          'aria-pressed',
          Number(button.dataset.width) === penWidth ? 'true' : 'false',
        );
      }
    }

    for (const button of document.querySelectorAll<HTMLElement>('.pen')) {
      button.addEventListener('click', () => {
        penWidth = Number(button.dataset.width) || 8;
        renderWidths();
        // 只改这一个 longhand。写 `strokeStyle` / 别的一起重设没有害处,
        // 但**不要**在这里调 fit() —— 那会重建画布,等于顺手把画擦掉
        ctx!.lineWidth = penWidth;
      });
    }

    renderWidths();

    el('clear')?.addEventListener('click', () => {
      ctx!.clearRect(0, 0, canvas.width, canvas.height);
      // 清空之后又回到空态:提示放回来,两个按钮重新变灰
      setInk(false);
      setText(el('hint'), t.hint);
    });

    el('save')?.addEventListener('click', () => {
      /*
       * 导出时**先把井的底色铺上**。画布本身是透明的,直接导出会得到一张
       * 绿线浮在透明背景上的 PNG —— 在深色图片查看器里还看得见,贴到白底
       * 文档里就几乎看不见了。铺上你现在看到的那个底色,导出的图才是
       * "你看到的这张"。
       */
      const out = document.createElement('canvas');
      out.width = canvas.width;
      out.height = canvas.height;
      const outCtx = out.getContext('2d');
      if (!outCtx) return;

      outCtx.fillStyle = getComputedStyle(area).backgroundColor;
      outCtx.fillRect(0, 0, out.width, out.height);
      outCtx.drawImage(canvas, 0, 0);

      const link = document.createElement('a');
      link.href = out.toDataURL('image/png');
      link.download = 'mouse-doodle.png';
      // 挂进文档再点:部分浏览器对游离节点的下载不认
      document.body.appendChild(link);
      link.click();
      link.remove();
    });

    // 尺寸变了要重算像素尺寸,否则画布会被拉伸(表现为线变粗、坐标偏移)
    const observer =
      typeof ResizeObserver === 'undefined'
        ? null
        : new ResizeObserver(() => {
            fit();
          });
    observer?.observe(area);

    // 空板起步。标记里那两个按钮已经写了 `disabled`,这里再走一遍是为了
    // **只有一个地方**决定"空板长什么样" —— 免得以后改了标记忘了改脚本
    setInk(false);
    fit();
  </script>
</BaseLayout>
